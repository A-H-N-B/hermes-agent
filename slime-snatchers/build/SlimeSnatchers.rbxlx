        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Slime Snatchers — CONFIG (file yang perlu kamu edit)

	1. Buat Game Pass & Developer Product di Creator Hub
	   (create.roblox.com > Creations > [game kamu] > Monetization).
	2. Tempel ID-nya di bawah (ganti angka 0). Item dengan id = 0 otomatis
	   disembunyikan dari toko, jadi game tetap jalan walau belum semua dibuat.
	3. `price` di sini hanya cadangan tampilan; harga asli diambil otomatis
	   dari Roblox (GetProductInfoAsync), jadi samakan saja dengan harga di Creator Hub.
]]

local Config = {}

Config.GameName = "Slime Snatchers"
Config.Version = "1.0.0"

-- Ganti nama ini hanya jika ingin "reset" semua data pemain.
Config.DataStoreName = "SlimeSnatchers_Data_v1"
Config.GiftStoreName = "SlimeSnatchers_Gifts_v1"
Config.LeaderboardEarnedStore = "SlimeSnatchers_LB_Earned_v1"
Config.LeaderboardRebirthStore = "SlimeSnatchers_LB_Rebirths_v1"

-- Admin: UserId kamu otomatis admin jika game dimiliki akunmu. Tambah teman di sini.
Config.AdminUserIds = {}
-- Grup Roblox (0 = mati). Anggota grup dapat +10% cash dan admin = rank >= AdminMinRank.
Config.GroupId = 0
Config.GroupBonus = 0.10
Config.AdminMinRank = 254

-- Link sosial yang tampil di layar Codes (teks saja, Roblox melarang link klik).
Config.SocialText = "Join our group for +10% cash & codes!"

---------------------------------------------------------------------------
-- GAME PASSES (sekali beli, permanen)
---------------------------------------------------------------------------
Config.Passes = {
	DoubleCash = {
		id = 0,
		price = 399,
		name = "2x Cash",
		icon = "💰",
		desc = "Earn 2x cash from every slime, forever.",
		order = 1,
	},
	VIP = {
		id = 0,
		price = 299,
		name = "VIP",
		icon = "👑",
		desc = "+50% cash, golden VIP tag, 6h offline earnings.",
		order = 2,
	},
	ExtraPads = {
		id = 0,
		price = 249,
		name = "+6 Slime Pads",
		icon = "🧱",
		desc = "6 extra pads in your base for more slimes.",
		order = 3,
	},
	FastSteal = {
		id = 0,
		price = 199,
		name = "Master Thief",
		icon = "🥷",
		desc = "Steal 2x faster and run at full speed while carrying.",
		order = 4,
	},
	AutoCollect = {
		id = 0,
		price = 149,
		name = "Auto Collect",
		icon = "🧲",
		desc = "Cash goes straight to your wallet. No walking!",
		order = 5,
	},
	LongLock = {
		id = 0,
		price = 149,
		name = "Mega Lock",
		icon = "🔒",
		desc = "Your base lock lasts 2x longer.",
		order = 6,
	},
	Speed = {
		id = 0,
		price = 99,
		name = "Turbo Shoes",
		icon = "👟",
		desc = "+25% walk speed.",
		order = 7,
	},
}

---------------------------------------------------------------------------
-- DEVELOPER PRODUCTS (bisa dibeli berulang)
---------------------------------------------------------------------------
Config.Products = {
	-- Paket cash: jumlahnya ikut naik sesuai income pemain (minutes x income/detik),
	-- jadi tetap berharga di akhir game. Jumlah pasti ditampilkan sebelum membeli.
	CashSmall = { id = 0, price = 25, name = "Cash Pouch", icon = "💵", minutes = 15, min = 1000, order = 1 },
	CashMedium = { id = 0, price = 99, name = "Cash Bag", icon = "💰", minutes = 75, min = 12000, order = 2 },
	CashLarge = { id = 0, price = 299, name = "Cash Vault", icon = "🏦", minutes = 300, min = 150000, order = 3 },
	CashMega = { id = 0, price = 799, name = "Cash Mountain", icon = "⛰️", minutes = 1000, min = 2000000, order = 4 },

	-- Boost untuk SELURUH server (pembeli diumumkan ke semua pemain).
	ServerLuck = { id = 0, price = 99, name = "2x Server Luck", icon = "🍀", minutes = 15, order = 5 },
	ServerRain = { id = 0, price = 79, name = "Slime Rain", icon = "🌧️", minutes = 10, order = 6 },

	-- Boost pribadi.
	CashBoost = { id = 0, price = 49, name = "2x Cash Potion", icon = "🧪", minutes = 30, order = 7 },
	Shield = { id = 0, price = 39, name = "Base Shield", icon = "🛡️", minutes = 10, order = 8 },

	-- Penawaran sekali per akun (jika terbeli lagi, diganti cash setara).
	StarterPack = { id = 0, price = 99, name = "Starter Pack", icon = "🎁", order = 9 },

	-- Gandakan offline earnings saat pemain kembali.
	OfflineDouble = { id = 0, price = 19, name = "2x Offline Cash", icon = "🌙", order = 10 },

	-- Beli langsung slime yang terlihat di conveyor (bukan acak: pemain melihat slime-nya).
	InstantEpic = { id = 0, price = 49, name = "Instant Buy (Epic)", rarity = "Epic", order = 20 },
	InstantLegendary = { id = 0, price = 99, name = "Instant Buy (Legendary)", rarity = "Legendary", order = 21 },
	InstantMythic = { id = 0, price = 199, name = "Instant Buy (Mythic)", rarity = "Mythic", order = 22 },
	InstantCelestial = { id = 0, price = 399, name = "Instant Buy (Celestial)", rarity = "Celestial", order = 23 },
	InstantSecret = { id = 0, price = 799, name = "Instant Buy (Secret)", rarity = "Secret", order = 24 },

	-- Hadiah untuk teman (penerima mendapat efek game pass yang sama, walau sedang offline).
	GiftDoubleCash = { id = 0, price = 399, name = "Gift: 2x Cash", icon = "🎁", gift = "DoubleCash", order = 30 },
	GiftVIP = { id = 0, price = 299, name = "Gift: VIP", icon = "🎁", gift = "VIP", order = 31 },
	GiftAutoCollect = { id = 0, price = 149, name = "Gift: Auto Collect", icon = "🎁", gift = "AutoCollect", order = 32 },

	-- Khusus hadiah Rewarded Video Ads (AdService). Harga bebas, misal 5.
	AdReward = { id = 0, price = 5, name = "Free Reward", icon = "📺", hidden = true, order = 99 },
}

-- Experience Subscription (opsional), contoh "EXP-1234567890". Kosong = mati.
Config.SubscriptionId = ""
Config.SubscriptionName = "Slime Club"
Config.SubscriptionBonus = 0.30

-- Bonus untuk member Roblox Premium / Plus.
Config.PremiumBonus = 0.10

Config.RewardedAds = {
	Enabled = true,
	BoostMinutes = 10, -- hadiah: 2x cash 10 menit
	CooldownSeconds = 240,
}

---------------------------------------------------------------------------
-- CODES (huruf besar/kecil tidak berpengaruh). expires = os.time() UTC, nil = selamanya
---------------------------------------------------------------------------
Config.Codes = {
	RELEASE = { cashMinutes = 10, minCash = 2500, boostMinutes = 10 },
	SLIMY = { cashMinutes = 5, minCash = 1000 },
	SNATCH = { boostMinutes = 15 },
	-- LIKES1K = { cashMinutes = 30, minCash = 10000, expires = 1798761600 },
}

---------------------------------------------------------------------------
-- TUNING (keseimbangan game)
---------------------------------------------------------------------------
Config.Tuning = {
	StartingCash = 100,
	WalkSpeed = 20,
	SpeedPassMult = 1.25,

	BasePads = 10,
	PadsPerRebirth = 2,
	MaxRebirthPads = 14,
	ExtraPadsPass = 6,

	SpawnInterval = 2.3, -- detik antar slime di conveyor
	GuaranteeEpicSeconds = 150, -- minimal 1 slime Epic+ muncul tiap X detik (ditampilkan di panel Odds)
	BeltTravelTime = 42, -- detik dari pipa ke ujung
	PurchaseWalkTime = 1.6,

	LockSeconds = 60,
	LockCooldown = 10,

	StealHoldSeconds = 1.4,
	CarrySpeedMult = 0.72,
	CarryMaxSeconds = 50,
	RobuxSlimeShieldMinutes = 10, -- slime yang dibeli pakai Robux tidak bisa dicuri selama ini

	BonkCooldown = 0.9,
	BonkRange = 9,
	BonkStunSeconds = 1.3,

	OfflineCapHours = 2,
	OfflineCapHoursVIP = 6,
	OfflineCapHoursClub = 8,
	OfflineEfficiency = 0.30,

	FriendBonusEach = 0.05,
	FriendBonusMax = 0.20,
	IndexBonusEach = 0.01, -- +1% cash per jenis slime yang ditemukan

	RebirthCashMultEach = 0.5,
	EventMinGap = 420,
	EventMaxGap = 720,
	EventDuration = 120,

	SellRatio = 0.5,
	AutosaveSeconds = 120,
}

---------------------------------------------------------------------------
-- SOUNDS (ganti dengan SoundId dari Creator Store jika mau)
---------------------------------------------------------------------------
Config.Sounds = {
	Click = "rbxasset://sounds/electronicpingshort.wav",
	Cash = "rbxasset://sounds/electronicpingshort.wav",
	Buy = "rbxasset://sounds/electronicpingshort.wav",
	Bonk = "rbxasset://sounds/swordslash.wav",
	Alert = "rbxasset://sounds/electronicpingshort.wav",
	LevelUp = "rbxasset://sounds/electronicpingshort.wav",
	Music = "", -- contoh "rbxassetid://1234567890" (pastikan audio boleh dipakai)
}

return Config
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX2E76635AE8C1474FBC3FF9E17420AC19">
        <Properties>
          <string name="Name">Economy</string>
          <ProtectedString name="Source"><![CDATA[-- Pure economy formulas (no Roblox services) so server and client agree and the
-- logic can be unit-tested outside Roblox.
local Shared = script.Parent
local Config = require(Shared:WaitForChild("Config"))
local Slimes = require(Shared:WaitForChild("Slimes"))
local Rarities = require(Shared:WaitForChild("Rarities"))
local Mutations = require(Shared:WaitForChild("Mutations"))

local Tuning = Config.Tuning
local Economy = {}

Economy.LEVEL_MAX = 10

function Economy.levelMult(level: number): number
	return 1 + 0.15 * (math.clamp(level, 1, Economy.LEVEL_MAX) - 1)
end

-- Seconds a slime must sit on a pad to go from `level` to `level + 1`.
function Economy.xpToNext(level: number): number
	return 45 * level
end

function Economy.levelScale(level: number): number
	return 1 + 0.05 * (math.clamp(level, 1, Economy.LEVEL_MAX) - 1)
end

local function mutMult(key: string?): number
	local def = Mutations.ByKey[key or "None"]
	return if def then def.mult else 1
end

-- Base income per second of one slime, before player multipliers.
function Economy.slimeIncome(slime): number
	local def = Slimes.ById[slime.id]
	if not def then
		return 0
	end
	return def.income * mutMult(slime.mut) * Economy.levelMult(slime.lvl or 1)
end

function Economy.slimePrice(id: string, mut: string?): number
	local def = Slimes.ById[id]
	if not def then
		return math.huge
	end
	return def.price * mutMult(mut)
end

function Economy.sellValue(slime): number
	local def = Slimes.ById[slime.id]
	if not def then
		return 0
	end
	return math.floor(def.price * mutMult(slime.mut) * Economy.levelMult(slime.lvl or 1) * Tuning.SellRatio)
end

function Economy.rebirthCost(rebirths: number): number
	return 250000 * 12 ^ rebirths
end

function Economy.rebirthMult(rebirths: number): number
	return 1 + Tuning.RebirthCashMultEach * rebirths
end

function Economy.maxPads(rebirths: number, hasExtraPads: boolean): number
	local fromRebirth = math.min(rebirths * Tuning.PadsPerRebirth, Tuning.MaxRebirthPads)
	return Tuning.BasePads + fromRebirth + (if hasExtraPads then Tuning.ExtraPadsPass else 0)
end

function Economy.maxPossiblePads(): number
	return Tuning.BasePads + Tuning.MaxRebirthPads + Tuning.ExtraPadsPass
end

-- Cash granted by scaled products/rewards: N minutes of current income, with a floor.
function Economy.scaledCash(incomePerSecond: number, minutes: number, minimum: number): number
	return math.floor(math.max(minimum or 0, (incomePerSecond or 0) * 60 * (minutes or 0)))
end

-- Probability of each rarity at a given luck (1 = base). Returns { [key] = p }.
function Economy.rarityOdds(luck: number): { [string]: number }
	local total = 0
	local weights = {}
	for _, def in Rarities.List do
		local w = def.weight * (math.max(luck, 1) ^ def.luckPower)
		weights[def.key] = w
		total += w
	end
	local odds = {}
	for key, w in weights do
		odds[key] = w / total
	end
	return odds
end

-- Probability of each mutation when mutation chances are multiplied by `mult`.
function Economy.mutationOdds(mult: number): { [string]: number }
	local odds = {}
	local used = 0
	for _, def in Mutations.List do
		if def.key ~= "None" then
			local p = def.chance * math.max(mult, 1)
			odds[def.key] = p
			used += p
		end
	end
	if used > 0.6 then
		-- keep "None" as the majority outcome even under stacked boosts
		for key, p in odds do
			odds[key] = p * 0.6 / used
		end
		used = 0.6
	end
	odds.None = 1 - used
	return odds
end

local function pick(rng: Random, entries: { any }, weightOf: (any) -> number)
	local total = 0
	for _, e in entries do
		total += weightOf(e)
	end
	local roll = rng:NextNumber() * total
	for _, e in entries do
		roll -= weightOf(e)
		if roll <= 0 then
			return e
		end
	end
	return entries[#entries]
end

-- Rolls a slime id + mutation for the conveyor.
function Economy.rollSpawn(rng: Random, luck: number, mutationMult: number, minRank: number?)
	local odds = Economy.rarityOdds(luck)
	local candidates = {}
	for _, def in Rarities.List do
		if def.rank >= (minRank or 1) then
			table.insert(candidates, def)
		end
	end
	local rarity = pick(rng, candidates, function(def)
		return odds[def.key]
	end)
	local slime = pick(rng, Slimes.ByRarity[rarity.key], function(def)
		return def.weight
	end)
	local mutOdds = Economy.mutationOdds(mutationMult)
	local mutation = pick(rng, Mutations.List, function(def)
		return mutOdds[def.key]
	end)
	return slime.id, mutation.key
end

-- Offline earnings for a list of slimes.
function Economy.offlineEarnings(slimes: { any }, multiplier: number, seconds: number): number
	local perSecond = 0
	for _, slime in slimes do
		perSecond += Economy.slimeIncome(slime)
	end
	return math.floor(perSecond * multiplier * seconds * Tuning.OfflineEfficiency)
end

return Economy
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXB589441E3A3940D4BF0C4D3BB919B3BB">
        <Properties>
          <string name="Name">Format</string>
          <ProtectedString name="Source"><![CDATA[-- Number / time formatting shared by server billboards and client UI.
local Format = {}

local SUFFIXES = {
	"", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc",
	"Ud", "Dd", "Td", "Qad", "Qid", "Sxd", "Spd", "Ocd", "Nod", "Vg",
}

local function trim(text: string): string
	if string.find(text, "%.") then
		text = string.gsub(text, "0+$", "")
		text = string.gsub(text, "%.$", "")
	end
	return text
end

-- 3 significant digits: 999, 1.23K, 12.3K, 123K, 1.23M ...
function Format.num(n: number): string
	if n ~= n then
		return "0"
	end
	local negative = n < 0
	n = math.abs(n)
	local text
	if n < 1000 then
		text = tostring(math.floor(n))
	else
		local tier = math.floor(math.log10(n) / 3)
		if tier >= #SUFFIXES then
			text = string.format("%.2e", n)
		else
			local value = n / 10 ^ (tier * 3)
			-- guard against 999.95K rounding up to "1000K"
			if value >= 999.5 and tier + 1 < #SUFFIXES then
				tier += 1
				value = n / 10 ^ (tier * 3)
			end
			local decimals = if value < 10 then 2 elseif value < 100 then 1 else 0
			text = trim(string.format("%." .. decimals .. "f", value)) .. SUFFIXES[tier + 1]
		end
	end
	return if negative then "-" .. text else text
end

function Format.cash(n: number): string
	return "$" .. Format.num(n)
end

function Format.rate(n: number): string
	return "$" .. Format.num(n) .. "/s"
end

-- 75 -> "1:15", 3725 -> "1:02:05"
function Format.time(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = seconds // 3600
	local m = (seconds % 3600) // 60
	local s = seconds % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

-- Odds as a readable percentage with enough precision for tiny values.
function Format.percent(p: number): string
	local pct = p * 100
	if pct >= 10 then
		return trim(string.format("%.1f", pct)) .. "%"
	elseif pct >= 1 then
		return trim(string.format("%.2f", pct)) .. "%"
	elseif pct >= 0.01 then
		return trim(string.format("%.3f", pct)) .. "%"
	end
	return trim(string.format("%.5f", pct)) .. "%"
end

function Format.mult(m: number): string
	return "x" .. trim(string.format("%.2f", m))
end

return Format
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX2969C31DCADA469EA30E80666D286E79">
        <Properties>
          <string name="Name">Mutations</string>
          <ProtectedString name="Source"><![CDATA[-- Mutations are rolled when a slime spawns. `chance` is the base probability;
-- "None" gets the remainder. Fusion upgrades a slime one step along `List`.
local Mutations = {}

Mutations.List = {
	{ key = "None", label = "", mult = 1, chance = 0, color = Color3.fromRGB(255, 255, 255) },
	{ key = "Golden", label = "Golden", mult = 2, chance = 0.06, color = Color3.fromRGB(255, 205, 60) },
	{ key = "Diamond", label = "Diamond", mult = 3, chance = 0.025, color = Color3.fromRGB(130, 235, 255) },
	{ key = "Rainbow", label = "Rainbow", mult = 5, chance = 0.01, color = Color3.fromRGB(255, 120, 220) },
	{ key = "Galaxy", label = "Galaxy", mult = 10, chance = 0.004, color = Color3.fromRGB(150, 90, 255) },
}

Mutations.ByKey = {}
for rank, def in Mutations.List do
	def.rank = rank
	Mutations.ByKey[def.key] = def
end

function Mutations.next(key: string): string
	local def = Mutations.ByKey[key] or Mutations.List[1]
	local nextDef = Mutations.List[math.min(def.rank + 1, #Mutations.List)]
	return nextDef.key
end

return Mutations
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXC9E0AEDD1053480080F3CA43CF088233">
        <Properties>
          <string name="Name">New</string>
          <ProtectedString name="Source"><![CDATA[-- Tiny declarative instance builder used by server and client:
--   New("Frame", { Size = UDim2.fromScale(1, 1), Parent = gui }, { New("UICorner") })
-- Functions given for event names are connected; Parent is applied last so the
-- instance is fully configured before it replicates / renders.
local function New(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			elseif type(value) == "function" then
				(inst :: any)[key]:Connect(value)
			else
				(inst :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

return New
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXE9A5269C3121424C8BE9F9A6BA4FEE07">
        <Properties>
          <string name="Name">Rarities</string>
          <ProtectedString name="Source"><![CDATA[-- Rarity tiers in ascending order. `weight` is the base spawn weight (sum = 10000,
-- so weight / 100 is the base percent). `luckPower` controls how strongly server
-- luck boosts the tier: effective weight = weight * luck ^ luckPower.
local Rarities = {}

Rarities.List = {
	{ key = "Common", color = Color3.fromRGB(196, 204, 214), weight = 5500, luckPower = 0, size = 2.3 },
	{ key = "Uncommon", color = Color3.fromRGB(100, 225, 120), weight = 2500, luckPower = 0.25, size = 2.6 },
	{ key = "Rare", color = Color3.fromRGB(70, 165, 255), weight = 1200, luckPower = 0.5, size = 2.9 },
	{ key = "Epic", color = Color3.fromRGB(180, 95, 255), weight = 500, luckPower = 1, size = 3.2 },
	{ key = "Legendary", color = Color3.fromRGB(255, 196, 45), weight = 200, luckPower = 1, size = 3.6 },
	{ key = "Mythic", color = Color3.fromRGB(255, 72, 112), weight = 70, luckPower = 1, size = 4.0 },
	{ key = "Celestial", color = Color3.fromRGB(110, 255, 235), weight = 24, luckPower = 1, size = 4.4 },
	{ key = "Secret", color = Color3.fromRGB(255, 255, 255), weight = 6, luckPower = 1, size = 5.0, rainbowText = true },
}

Rarities.ByKey = {}
for rank, def in Rarities.List do
	def.rank = rank
	Rarities.ByKey[def.key] = def
end

return Rarities
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX4F229EA77B4448018FC78B70AE74B686">
        <Properties>
          <string name="Name">Remotes</string>
          <ProtectedString name="Source"><![CDATA[-- Remote definitions. The server creates them on boot; clients wait for them.
--   Action (RemoteFunction, client -> server): every player request goes through
--          one validated, rate-limited entry point.
--   Sync   (RemoteEvent, server -> client): partial state updates for that player.
--   Notify (RemoteEvent, server -> client): toast messages.
--   FX     (RemoteEvent, server -> client): visual/sound effects.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = {}

local DEFINITIONS = {
	Action = "RemoteFunction",
	Sync = "RemoteEvent",
	Notify = "RemoteEvent",
	FX = "RemoteEvent",
}

local folder: Folder? = nil

local function getFolder(): Folder
	if folder then
		return folder
	end
	if RunService:IsServer() then
		local existing = ReplicatedStorage:FindFirstChild("Remotes")
		if not existing then
			existing = Instance.new("Folder")
			existing.Name = "Remotes"
			existing.Parent = ReplicatedStorage
		end
		folder = existing :: Folder
	else
		folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
	end
	return folder :: Folder
end

function Remotes.init()
	local root = getFolder()
	for name, className in DEFINITIONS do
		if not root:FindFirstChild(name) then
			local remote = Instance.new(className)
			remote.Name = name
			remote.Parent = root
		end
	end
end

function Remotes.get(name: string): any
	assert(DEFINITIONS[name], "unknown remote " .. name)
	local root = getFolder()
	if RunService:IsServer() then
		local remote = root:FindFirstChild(name)
		if not remote then
			Remotes.init()
			remote = root:FindFirstChild(name)
		end
		return remote
	end
	return root:WaitForChild(name)
end

return Remotes
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX7D70D97B97924B0D98FBABB42B85ED0A">
        <Properties>
          <string name="Name">RewardDefs</string>
          <ProtectedString name="Source"><![CDATA[-- Free reward tables shared by the server (grants) and client (UI previews).
-- reward: { cashMinutes?, minCash?, boostMinutes?, slimeMinRarity? }
local RewardDefs = {}

RewardDefs.Daily = {
	{ cashMinutes = 5, minCash = 500 },
	{ cashMinutes = 10, minCash = 1500 },
	{ boostMinutes = 15 },
	{ cashMinutes = 20, minCash = 5000 },
	{ slimeMinRarity = "Rare" },
	{ cashMinutes = 45, minCash = 20000 },
	{ slimeMinRarity = "Epic", boostMinutes = 30 },
}

-- Session playtime gifts; `at` is minutes played in the current session.
RewardDefs.Gifts = {
	{ at = 2, reward = { cashMinutes = 3, minCash = 300 } },
	{ at = 5, reward = { boostMinutes = 5 } },
	{ at = 10, reward = { cashMinutes = 8, minCash = 1500 } },
	{ at = 15, reward = { slimeMinRarity = "Uncommon" } },
	{ at = 25, reward = { cashMinutes = 15, minCash = 6000 } },
	{ at = 35, reward = { boostMinutes = 15 } },
	{ at = 50, reward = { slimeMinRarity = "Rare" } },
	{ at = 70, reward = { cashMinutes = 30, minCash = 25000 } },
}

-- Short human-readable description used by the UI.
function RewardDefs.describe(reward): string
	local parts = {}
	if reward.cashMinutes then
		table.insert(parts, "💰 " .. reward.cashMinutes .. " min of cash")
	elseif reward.minCash or reward.cash then
		table.insert(parts, "💰 Cash")
	end
	if reward.boostMinutes then
		table.insert(parts, "🧪 2x Cash " .. reward.boostMinutes .. "m")
	end
	if reward.slimeMinRarity then
		table.insert(parts, "🟢 " .. reward.slimeMinRarity .. "+ slime")
	end
	return table.concat(parts, " + ")
end

return RewardDefs
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXC6A1ED5B52AE45B0A1B6D431D57D9824">
        <Properties>
          <string name="Name">SlimeModel</string>
          <ProtectedString name="Source"><![CDATA[-- Procedural slime models (no uploaded assets needed). A slime is an anchored
-- ellipsoid "Body" with features welded to it, so moving/scaling the Body moves
-- the whole creature.
local Shared = script.Parent
local New = require(Shared:WaitForChild("New"))
local Slimes = require(Shared:WaitForChild("Slimes"))
local Rarities = require(Shared:WaitForChild("Rarities"))
local Mutations = require(Shared:WaitForChild("Mutations"))
local Economy = require(Shared:WaitForChild("Economy"))
local Format = require(Shared:WaitForChild("Format"))

local SlimeModel = {}

local FONT = Enum.Font.FredokaOne
local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.fromRGB(25, 20, 30)

local function part(props)
	props.Anchored = false
	props.CanCollide = false
	props.CanTouch = false
	props.CanQuery = false
	props.Massless = true
	props.CastShadow = false
	props.TopSurface = Enum.SurfaceType.Smooth
	props.BottomSurface = Enum.SurfaceType.Smooth
	return New("Part", props)
end

local function weldTo(body: BasePart, piece: BasePart, offset: CFrame)
	piece.CFrame = body.CFrame * offset
	New("WeldConstraint", { Part0 = body, Part1 = piece, Parent = piece })
	piece.Parent = body.Parent
end

local function ball(size: number, color: Color3, material: Enum.Material?)
	return part({
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(size, size, size),
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
	})
end

local function ellipsoid(size: Vector3, color: Color3, material: Enum.Material?)
	local p = part({ Size = size, Color = color, Material = material or Enum.Material.SmoothPlastic })
	New("SpecialMesh", { MeshType = Enum.MeshType.Sphere, Parent = p })
	return p
end

local ACCESSORIES = {}

function ACCESSORIES.leaf(body, s, def)
	local leaf = ellipsoid(Vector3.new(s * 0.12, s * 0.45, s * 0.3), def.accent)
	weldTo(body, leaf, CFrame.new(0, s * 0.5, 0) * CFrame.Angles(0, 0, math.rad(25)))
end

function ACCESSORIES.bow(body, s, def)
	for _, side in { -1, 1 } do
		local loop = ellipsoid(Vector3.new(s * 0.28, s * 0.2, s * 0.12), def.accent)
		weldTo(body, loop, CFrame.new(side * s * 0.16, s * 0.42, -s * 0.05) * CFrame.Angles(0, 0, math.rad(side * 20)))
	end
	weldTo(body, ball(s * 0.1, def.accent), CFrame.new(0, s * 0.42, -s * 0.05))
end

function ACCESSORIES.antenna(body, s, def)
	local stick = part({ Size = Vector3.new(s * 0.05, s * 0.4, s * 0.05), Color = def.accent })
	weldTo(body, stick, CFrame.new(0, s * 0.55, 0))
	weldTo(body, ball(s * 0.16, def.accent, Enum.Material.Neon), CFrame.new(0, s * 0.78, 0))
end

function ACCESSORIES.crown(body, s, _def)
	local gold = Color3.fromRGB(255, 210, 60)
	local band = part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(s * 0.18, s * 0.55, s * 0.55), Color = gold,
		Material = Enum.Material.Metal })
	weldTo(body, band, CFrame.new(0, s * 0.42, 0) * CFrame.Angles(0, 0, math.rad(90)))
	for i = 0, 4 do
		local angle = math.rad(i * 72)
		local spike = part({ Size = Vector3.new(s * 0.08, s * 0.2, s * 0.08), Color = gold, Material = Enum.Material.Metal })
		weldTo(body, spike, CFrame.new(math.cos(angle) * s * 0.22, s * 0.58, math.sin(angle) * s * 0.22))
	end
	weldTo(body, ball(s * 0.09, Color3.fromRGB(255, 60, 90), Enum.Material.Neon), CFrame.new(0, s * 0.45, -s * 0.28))
end

function ACCESSORIES.halo(body, s, _def)
	local halo = part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(s * 0.05, s * 0.7, s * 0.7),
		Color = Color3.fromRGB(255, 240, 150), Material = Enum.Material.Neon, Transparency = 0.15 })
	weldTo(body, halo, CFrame.new(0, s * 0.75, 0) * CFrame.Angles(0, 0, math.rad(90)))
end

function ACCESSORIES.horns(body, s, def)
	for _, side in { -1, 1 } do
		local horn = part({ Size = Vector3.new(s * 0.1, s * 0.32, s * 0.1), Color = def.accent })
		weldTo(body, horn, CFrame.new(side * s * 0.22, s * 0.48, 0) * CFrame.Angles(0, 0, math.rad(-side * 25)))
	end
end

function ACCESSORIES.spikes(body, s, def)
	for i = -1, 1 do
		local spike = part({ Size = Vector3.new(s * 0.1, s * 0.25, s * 0.1), Color = def.accent })
		weldTo(body, spike, CFrame.new(0, s * 0.44, i * s * 0.2) * CFrame.Angles(math.rad(i * 25), 0, 0))
	end
end

function ACCESSORIES.ears(body, s, def)
	for _, side in { -1, 1 } do
		weldTo(body, ball(s * 0.22, def.accent), CFrame.new(side * s * 0.3, s * 0.36, 0))
	end
end

function ACCESSORIES.hat(body, s, def)
	local brim = part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(s * 0.05, s * 0.6, s * 0.6), Color = BLACK })
	weldTo(body, brim, CFrame.new(0, s * 0.4, 0) * CFrame.Angles(0, 0, math.rad(90)))
	local top = part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(s * 0.35, s * 0.38, s * 0.38), Color = BLACK })
	weldTo(body, top, CFrame.new(0, s * 0.6, 0) * CFrame.Angles(0, 0, math.rad(90)))
	local band = part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(s * 0.08, s * 0.39, s * 0.39), Color = def.accent })
	weldTo(body, band, CFrame.new(0, s * 0.47, 0) * CFrame.Angles(0, 0, math.rad(90)))
end

function ACCESSORIES.flame(body, s, def)
	local holder = part({ Size = Vector3.new(0.2, 0.2, 0.2), Transparency = 1 })
	weldTo(body, holder, CFrame.new(0, s * 0.5, 0))
	New("Fire", { Size = s * 1.2, Heat = 4, Color = def.accent, SecondaryColor = def.body, Parent = holder })
end

local function applyMutation(model: Model, body: BasePart, mutKey: string, s: number)
	if mutKey == "Golden" then
		body.Color = Color3.fromRGB(255, 205, 60)
		body.Material = Enum.Material.SmoothPlastic
		body.Reflectance = 0.25
		New("Sparkles", { SparkleColor = Color3.fromRGB(255, 230, 120), Parent = body })
	elseif mutKey == "Diamond" then
		body.Color = Color3.fromRGB(170, 240, 255)
		body.Material = Enum.Material.Glass
		body.Reflectance = 0.35
		New("Sparkles", { SparkleColor = Color3.fromRGB(180, 250, 255), Parent = body })
	elseif mutKey == "Rainbow" then
		-- the client cycles the hue for every model with this attribute
		model:SetAttribute("Rainbow", true)
		body.Material = Enum.Material.Neon
	elseif mutKey == "Galaxy" then
		body.Color = Color3.fromRGB(60, 25, 120)
		body.Material = Enum.Material.Neon
		New("ParticleEmitter", {
			Rate = 12,
			Lifetime = NumberRange.new(1, 2),
			Speed = NumberRange.new(0.5, 1.5),
			Size = NumberSequence.new(s * 0.12),
			LightEmission = 1,
			Color = ColorSequence.new(Color3.fromRGB(200, 150, 255), Color3.fromRGB(80, 200, 255)),
			Parent = body,
		})
	end
end

local function label(text: string, color: Color3, order: number, height: number)
	return New("TextLabel", {
		Name = "L" .. order,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, height),
		Font = FONT,
		Text = text,
		TextColor3 = color,
		TextScaled = true,
		TextStrokeTransparency = 0.15,
		TextStrokeColor3 = BLACK,
		LayoutOrder = order,
	})
end

-- Billboard info: { price = number?, level = number?, owner = string? }
function SlimeModel.makeBillboard(model: Model, info)
	local body = model.PrimaryPart :: BasePart
	local id = model:GetAttribute("SlimeId")
	local mutKey = model:GetAttribute("Mutation") or "None"
	local def = Slimes.ById[id]
	local rarity = Rarities.ByKey[def.rarity]
	local mut = Mutations.ByKey[mutKey]
	local s = rarity.size

	local old = body:FindFirstChild("Nameplate")
	if old then
		old:Destroy()
	end
	local gui = New("BillboardGui", {
		Name = "Nameplate",
		Size = UDim2.fromScale(7, 3.2),
		StudsOffsetWorldSpace = Vector3.new(0, s * 0.55 + 2.2, 0),
		MaxDistance = 75,
		LightInfluence = 0,
		ResetOnSpawn = false,
		Adornee = body,
	})
	New("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = gui,
	})
	if mut and mut.key ~= "None" then
		label(mut.label, mut.color, 1, 0.2).Parent = gui
	end
	label(def.name, WHITE, 2, 0.24).Parent = gui
	local rarityLabel = label(def.rarity, rarity.color, 3, 0.18)
	rarityLabel.Parent = gui
	if rarity.rainbowText then
		New("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
				ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 240, 80)),
				ColorSequenceKeypoint.new(0.66, Color3.fromRGB(80, 255, 160)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(120, 120, 255)),
			}),
			Parent = rarityLabel,
		})
	end
	local slime = { id = id, mut = mutKey, lvl = info.level or 1 }
	label(Format.rate(Economy.slimeIncome(slime)), Color3.fromRGB(120, 255, 120), 4, 0.18).Parent = gui
	if info.price then
		label(Format.cash(info.price), Color3.fromRGB(255, 230, 90), 5, 0.2).Parent = gui
	elseif info.level then
		local text = "Lv " .. info.level .. (if info.level >= Economy.LEVEL_MAX then " MAX" else "")
		label(text, Color3.fromRGB(180, 220, 255), 5, 0.16).Parent = gui
	end
	gui.Parent = body
	return gui
end

-- mode: "belt" | "pad" | "carry"
function SlimeModel.build(id: string, mutKey: string, level: number?, mode: string?): Model
	local def = Slimes.ById[id]
	assert(def, "unknown slime " .. tostring(id))
	local rarity = Rarities.ByKey[def.rarity]
	local s = rarity.size

	local model = New("Model", { Name = def.name })
	model:SetAttribute("SlimeId", id)
	model:SetAttribute("Mutation", mutKey)
	model:SetAttribute("Rarity", def.rarity)

	local material = if def.material then (Enum.Material :: any)[def.material] else Enum.Material.SmoothPlastic
	local body = ellipsoid(Vector3.new(s * 1.15, s * 0.85, s * 1.15), def.body, material)
	body.Name = "Body"
	body.Anchored = true
	body.Massless = false
	body.CanQuery = true
	body.Transparency = if material == Enum.Material.Glass then 0.25 else 0.05
	body.Parent = model
	model.PrimaryPart = body

	-- glossy highlight + face
	weldTo(body, ball(s * 0.18, WHITE, Enum.Material.Neon), CFrame.new(-s * 0.25, s * 0.25, -s * 0.3))
	for _, side in { -1, 1 } do
		weldTo(body, ball(s * 0.3, WHITE), CFrame.new(side * s * 0.2, s * 0.08, -s * 0.47))
		weldTo(body, ball(s * 0.16, BLACK), CFrame.new(side * s * 0.2, s * 0.06, -s * 0.6))
		weldTo(body, ball(s * 0.05, WHITE, Enum.Material.Neon), CFrame.new(side * s * 0.17, s * 0.1, -s * 0.67))
		local cheek = ellipsoid(Vector3.new(s * 0.16, s * 0.08, s * 0.05), Color3.fromRGB(255, 140, 170))
		cheek.Transparency = 0.3
		weldTo(body, cheek, CFrame.new(side * s * 0.36, -s * 0.08, -s * 0.47))
	end
	local mouth = ellipsoid(Vector3.new(s * 0.14, s * 0.07, s * 0.05), BLACK)
	weldTo(body, mouth, CFrame.new(0, -s * 0.12, -s * 0.55))

	local accessory = ACCESSORIES[def.accessory]
	if accessory then
		accessory(body, s, def)
	end
	applyMutation(model, body, mutKey, s)

	if rarity.rank >= 5 then
		New("PointLight", { Color = rarity.color, Range = s * 3, Brightness = 1.2, Parent = body })
	end

	if level and level > 1 then
		model:ScaleTo(Economy.levelScale(level))
	end
	model:SetAttribute("Level", level or 1)
	if mode ~= "carry" then
		SlimeModel.makeBillboard(model, { level = if mode == "pad" then (level or 1) else nil })
	end
	return model
end

function SlimeModel.setLevel(model: Model, level: number)
	model:ScaleTo(Economy.levelScale(level))
	model:SetAttribute("Level", level)
	SlimeModel.makeBillboard(model, { level = level })
end

-- Height of the body's bottom above its pivot, used to rest slimes on surfaces.
function SlimeModel.restHeight(model: Model): number
	local body = model.PrimaryPart :: BasePart
	return body.Size.Y / 2
end

return SlimeModel
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX16E165E9CD4B46D2BA0F825269959367">
        <Properties>
          <string name="Name">Slimes</string>
          <ProtectedString name="Source"><![CDATA[-- Slime catalog (original characters). Within a rarity, `weight` picks which
-- slime spawns (cheaper ones are more common). Payback (price / income) grows
-- from ~25s for commons to ~140s for secrets so buying always pays off and
-- pad space becomes the real bottleneck.
--
-- accessory: none | leaf | bow | horns | crown | halo | antenna | spikes | ears | hat | flame
local Slimes = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

Slimes.List = {
	-- Common
	{ id = "blubby", name = "Blubby", rarity = "Common", price = 25, income = 1, weight = 50,
		body = rgb(120, 220, 110), accent = rgb(80, 170, 70), accessory = "none" },
	{ id = "gloopy", name = "Gloopy", rarity = "Common", price = 60, income = 2, weight = 33,
		body = rgb(110, 190, 255), accent = rgb(60, 130, 220), accessory = "antenna" },
	{ id = "sprout", name = "Sprout Slime", rarity = "Common", price = 120, income = 4, weight = 17,
		body = rgb(170, 230, 90), accent = rgb(60, 160, 50), accessory = "leaf" },
	-- Uncommon
	{ id = "bubblegum", name = "Bubblegum Bop", rarity = "Uncommon", price = 400, income = 10, weight = 50,
		body = rgb(255, 150, 210), accent = rgb(230, 90, 170), accessory = "bow" },
	{ id = "minty", name = "Minty Wobble", rarity = "Uncommon", price = 750, income = 17, weight = 33,
		body = rgb(150, 255, 215), accent = rgb(60, 200, 160), accessory = "ears" },
	{ id = "puddle", name = "Puddle Pup", rarity = "Uncommon", price = 1200, income = 25, weight = 17,
		body = rgb(120, 160, 255), accent = rgb(70, 90, 200), accessory = "ears" },
	-- Rare
	{ id = "lava", name = "Lava Lump", rarity = "Rare", price = 3500, income = 60, weight = 50,
		body = rgb(255, 110, 40), accent = rgb(200, 40, 20), accessory = "flame", material = "Neon" },
	{ id = "frosty", name = "Frosty Flop", rarity = "Rare", price = 6000, income = 95, weight = 33,
		body = rgb(190, 240, 255), accent = rgb(120, 200, 255), accessory = "spikes", material = "Ice" },
	{ id = "zappy", name = "Zappy Jelly", rarity = "Rare", price = 9000, income = 130, weight = 17,
		body = rgb(255, 240, 80), accent = rgb(255, 180, 0), accessory = "antenna", material = "Neon" },
	-- Epic
	{ id = "noodle", name = "Neon Noodle", rarity = "Epic", price = 35000, income = 450, weight = 50,
		body = rgb(80, 255, 200), accent = rgb(255, 60, 220), accessory = "antenna", material = "Neon" },
	{ id = "choco", name = "Choco Chomper", rarity = "Epic", price = 60000, income = 700, weight = 33,
		body = rgb(130, 80, 45), accent = rgb(255, 230, 200), accessory = "hat" },
	{ id = "ghostly", name = "Ghostly Goo", rarity = "Epic", price = 95000, income = 1000, weight = 17,
		body = rgb(235, 235, 255), accent = rgb(170, 160, 255), accessory = "none", material = "ForceField" },
	-- Legendary
	{ id = "squish", name = "Sir Squish", rarity = "Legendary", price = 450000, income = 5000, weight = 50,
		body = rgb(90, 120, 255), accent = rgb(255, 210, 60), accessory = "crown" },
	{ id = "mochi", name = "Mochi Moon", rarity = "Legendary", price = 750000, income = 7500, weight = 33,
		body = rgb(255, 240, 245), accent = rgb(255, 170, 200), accessory = "ears" },
	{ id = "thunder", name = "Thunder Blob", rarity = "Legendary", price = 1200000, income = 11000, weight = 17,
		body = rgb(60, 60, 110), accent = rgb(255, 250, 90), accessory = "spikes", material = "Neon" },
	-- Mythic
	{ id = "crystal", name = "Crystal Queen", rarity = "Mythic", price = 6000000, income = 55000, weight = 50,
		body = rgb(200, 150, 255), accent = rgb(255, 255, 255), accessory = "crown", material = "Glass" },
	{ id = "dragon", name = "Dragon Drip", rarity = "Mythic", price = 10000000, income = 85000, weight = 33,
		body = rgb(220, 40, 60), accent = rgb(255, 200, 60), accessory = "horns" },
	{ id = "cosmo", name = "Cosmo Goo", rarity = "Mythic", price = 16000000, income = 125000, weight = 17,
		body = rgb(40, 20, 90), accent = rgb(120, 220, 255), accessory = "antenna", material = "Neon" },
	-- Celestial
	{ id = "angel", name = "Angel Ooze", rarity = "Celestial", price = 110000000, income = 900000, weight = 50,
		body = rgb(255, 255, 230), accent = rgb(255, 230, 120), accessory = "halo" },
	{ id = "solar", name = "Solar Splat", rarity = "Celestial", price = 180000000, income = 1400000, weight = 33,
		body = rgb(255, 170, 30), accent = rgb(255, 90, 0), accessory = "flame", material = "Neon" },
	{ id = "nebula", name = "Nebula Nibbler", rarity = "Celestial", price = 280000000, income = 2000000, weight = 17,
		body = rgb(120, 60, 200), accent = rgb(255, 120, 230), accessory = "halo", material = "Neon" },
	-- Secret
	{ id = "gloopus", name = "King Gloopus", rarity = "Secret", price = 3000000000, income = 22000000, weight = 50,
		body = rgb(30, 200, 90), accent = rgb(255, 215, 0), accessory = "crown", material = "Neon" },
	{ id = "void", name = "Void Wobbler", rarity = "Secret", price = 5000000000, income = 34000000, weight = 33,
		body = rgb(15, 10, 25), accent = rgb(170, 0, 255), accessory = "horns", material = "Neon" },
	{ id = "overlord", name = "Prism Overlord", rarity = "Secret", price = 8000000000, income = 50000000, weight = 17,
		body = rgb(255, 255, 255), accent = rgb(255, 0, 170), accessory = "halo", material = "Glass" },
}

Slimes.ById = {}
Slimes.ByRarity = {}
for index, def in Slimes.List do
	def.index = index
	Slimes.ById[def.id] = def
	Slimes.ByRarity[def.rarity] = Slimes.ByRarity[def.rarity] or {}
	table.insert(Slimes.ByRarity[def.rarity], def)
end

return Slimes
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX18AE08B9B93C4C6CA8EDA2F3868B4443">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="RBX049EEEC8673C42BA82CA8B174AA9817F">
      <Properties>
        <string name="Name">Main</string>
        <ProtectedString name="Source"><![CDATA[-- Server bootstrap: loads every service, wires them together (dependency
-- injection through the shared `S` table avoids require cycles), then starts them.
-- ORDER matters: PlayerService runs each service's onReady hook in this order
-- (passes are checked before the plot is sized, the plot exists before slimes spawn).
local Services = script.Parent:WaitForChild("Services")

local ORDER = {
	"Analytics",
	"DataService",
	"WorldBuilder",
	"PlayerService",
	"EventService",
	"MonetizationService",
	"PlotService",
	"EconomyService",
	"SlimeService",
	"CarryService",
	"RewardService",
	"LeaderboardService",
	"AdminService",
	"ToolService",
}

local S = {}
for _, name in ORDER do
	S[name] = require(Services:WaitForChild(name))
end
for _, name in ORDER do
	local service = S[name]
	if service.init then
		service.init(S)
	end
end
for _, name in ORDER do
	local service = S[name]
	if service.start then
		task.spawn(service.start)
	end
end

print(string.format("[SlimeSnatchers] server ready (%d services)", #ORDER))
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="Folder" referent="RBXE3A0EDC69D104BC9B9B2B0F1EEC12D06">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="ModuleScript" referent="RBXA885B8A698224792A2C6A7ADECD6BF1E">
        <Properties>
          <string name="Name">AdminService</string>
          <ProtectedString name="Source"><![CDATA[-- Owner/admin tools for live "admin events" (huge for CCU in steal games):
-- boost luck, start events, spawn rare slimes, announce. Admins are: Studio
-- testers, the experience owner, Config.AdminUserIds, and group ranks >= AdminMinRank.
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Rarities = require(Shared:WaitForChild("Rarities"))

local AdminService = {}

local S
local admins: { [Player]: boolean } = {}

local function rankIn(player: Player, groupId: number): number
	local ok, rank = pcall(function()
		return player:GetRankInGroupAsync(groupId)
	end)
	return if ok and type(rank) == "number" then rank else 0
end

local function computeAdmin(player: Player): boolean
	if RunService:IsStudio() or table.find(Config.AdminUserIds, player.UserId) then
		return true
	end
	if game.CreatorType == Enum.CreatorType.User and game.CreatorId == player.UserId then
		return true
	end
	if game.CreatorType == Enum.CreatorType.Group and rankIn(player, game.CreatorId) >= Config.AdminMinRank then
		return true
	end
	return Config.GroupId > 0 and rankIn(player, Config.GroupId) >= Config.AdminMinRank
end

function AdminService.isAdmin(player: Player): boolean
	return admins[player] == true
end

local COMMANDS = {}

function COMMANDS.luck(_player, args)
	S.EventService.setAdminLuck(tonumber(args.mult) or 2, (tonumber(args.minutes) or 5) * 60)
	return true
end

function COMMANDS.event(_player, args)
	return S.EventService.startEvent(tostring(args.key))
end

function COMMANDS.spawn(_player, args)
	local rarity = tostring(args.rarity)
	if not Rarities.ByKey[rarity] then
		return false
	end
	local count = math.clamp(tonumber(args.count) or 1, 1, 10)
	for _ = 1, count do
		S.SlimeService.forceSpawn(rarity)
		task.wait(0.4)
	end
	return true
end

function COMMANDS.rain(player, args)
	S.EventService.addBoost("rain", (tonumber(args.minutes) or 5) * 60, player.DisplayName .. " (admin)")
	return true
end

function COMMANDS.golden(player, args)
	S.EventService.addBoost("golden", (tonumber(args.minutes) or 5) * 60, player.DisplayName .. " (admin)")
	return true
end

function COMMANDS.cash(player, args)
	S.EconomyService.addCash(player, math.clamp(tonumber(args.amount) or 0, 0, 1e18), "AdminCash", "Gameplay")
	return true
end

function COMMANDS.announce(player, args)
	local text = tostring(args.text or "")
	if #text == 0 or #text > 150 then
		return false
	end
	-- all text shown to other players must pass Roblox text filtering
	local ok, filtered = pcall(function()
		local result = TextService:FilterStringAsync(text, player.UserId)
		return result:GetNonChatStringForBroadcastAsync()
	end)
	if not ok then
		return false
	end
	S.PlayerService.notifyAll("📢 " .. filtered, "event")
	return true
end

function COMMANDS.wipe(player)
	S.DataService.wipe(player)
	S.DataService.saveNow(player)
	player:Kick("Your test data was reset. Rejoin to start fresh!")
	return true
end

function AdminService.init(services)
	S = services
	S.PlayerService.onReady(function(player)
		admins[player] = computeAdmin(player)
		player:SetAttribute("Admin", admins[player])
	end)
	S.PlayerService.onLeaving(function(player)
		admins[player] = nil
	end)
	S.PlayerService.addState(function(player)
		return { isAdmin = admins[player] == true, eventKeys = S.EventService.eventKeys() }
	end)
	S.PlayerService.registerAction("admin", function(player, payload)
		if not admins[player] or type(payload) ~= "table" then
			return { ok = false }
		end
		local command = COMMANDS[tostring(payload.cmd)]
		if not command then
			return { ok = false, msg = "Unknown command" }
		end
		local ok = command(player, payload)
		return { ok = ok == true, msg = if ok then "Done!" else "Failed" }
	end)
end

return AdminService
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXB339E0F082DA4E8B99A46A2B4AF8CBAD">
        <Properties>
          <string name="Name">Analytics</string>
          <ProtectedString name="Source"><![CDATA[-- Thin wrapper over AnalyticsService (Creator Hub > Analytics). Every call is
-- protected so analytics can never break gameplay.
local AnalyticsService = game:GetService("AnalyticsService")

local Analytics = {}

local function safe(fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		warn("[Analytics] " .. tostring(err))
	end
end

-- flow: "Source" (cash in) | "Sink" (cash out)
-- transactionType: an Enum.AnalyticsEconomyTransactionType name, e.g. "Shop", "IAP", "Gameplay"
function Analytics.economy(player: Player, flow: string, amount: number, balance: number, transactionType: string, sku: string)
	if amount <= 0 or amount ~= amount or amount == math.huge then
		return
	end
	safe(function()
		AnalyticsService:LogEconomyEvent(
			player,
			(Enum.AnalyticsEconomyFlowType :: any)[flow],
			"Cash",
			math.floor(math.min(amount, 1e15)),
			math.floor(math.min(balance, 1e15)),
			transactionType,
			sku
		)
	end)
end

function Analytics.onboarding(player: Player, step: number, stepName: string)
	safe(function()
		AnalyticsService:LogOnboardingFunnelStepEvent(player, step, stepName)
	end)
end

function Analytics.funnel(player: Player, funnel: string, sessionId: string, step: number, stepName: string)
	safe(function()
		AnalyticsService:LogFunnelStepEvent(player, funnel, sessionId, step, stepName)
	end)
end

function Analytics.progression(player: Player, path: string, level: number, levelName: string)
	safe(function()
		AnalyticsService:LogProgressionCompleteEvent(player, path, level, levelName)
	end)
end

function Analytics.custom(player: Player, eventName: string, value: number?)
	safe(function()
		AnalyticsService:LogCustomEvent(player, eventName, value or 1)
	end)
end

return Analytics
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXE0699C7B724644ABAF5E01A370A7DF4F">
        <Properties>
          <string name="Name">CarryService</string>
          <ProtectedString name="Source"><![CDATA[-- Stealing: a thief picks up a slime from an unprotected base, carries it over
-- their head (slowed, highlighted) and must reach their own base. Getting
-- bonked, dying, timing out or leaving returns it to the owner. The slime stays
-- in the victim's data (flag `carried`) until delivery, so nothing is lost if a
-- server shuts down mid-steal.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))
local Format = require(Shared:WaitForChild("Format"))
local New = require(Shared:WaitForChild("New"))
local Rarities = require(Shared:WaitForChild("Rarities"))
local SlimeModel = require(Shared:WaitForChild("SlimeModel"))
local Slimes = require(Shared:WaitForChild("Slimes"))

local Tuning = Config.Tuning
local CarryService = {}

local S
local carries: { [Player]: any } = {}

function CarryService.isCarrying(player: Player): boolean
	return carries[player] ~= nil
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function alive(player: Player): boolean
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0
end

local function cleanupVisual(carry)
	if carry.model then
		carry.model:Destroy()
	end
	if carry.highlight then
		carry.highlight:Destroy()
	end
end

function CarryService.tryStealing(thief: Player, victim: Player, uid: string)
	if not S.PlayerService.isReady(thief) or not S.PlayerService.isReady(victim) or thief == victim then
		return
	end
	if carries[thief] then
		S.PlayerService.notify(thief, "You're already carrying a slime!", "warning")
		return
	end
	local plot = S.PlotService.get(victim)
	if not plot then
		return
	end
	local protected, reason = S.PlotService.isProtected(plot)
	if protected then
		S.PlayerService.notify(thief, reason or "Protected!", "error")
		return
	end
	local slime = S.SlimeService.find(victim, uid)
	if not slime or slime.carried then
		return
	end
	if slime.shield and slime.shield > os.time() then
		S.PlayerService.notify(thief, "This slime is 🛡️ protected for " .. Format.time(slime.shield - os.time()), "error")
		return
	end
	if not S.SlimeService.freePad(thief) then
		S.PlayerService.notify(thief, "Your base is full! Make room before stealing.", "error")
		return
	end
	local root = rootOf(thief)
	local model = S.SlimeService.getModel(victim, uid)
	if not root or not alive(thief) or not model or not model.PrimaryPart then
		return
	end
	if (root.Position - model.PrimaryPart.Position).Magnitude > 18 then
		return
	end

	slime.carried = thief.UserId
	S.SlimeService.removeModel(victim, uid)
	S.EconomyService.clearPad(victim, slime.pad)
	S.PlotService.setPadOccupied(plot, slime.pad, false)

	local carryModel = SlimeModel.build(slime.id, slime.mut, slime.lvl, "carry")
	carryModel:ScaleTo(0.75 * Economy.levelScale(slime.lvl))
	local body = carryModel.PrimaryPart :: BasePart
	body.Anchored = false
	body.Massless = true
	body.CanCollide = false
	body.CanQuery = false
	carryModel:PivotTo(root.CFrame * CFrame.new(0, 4.6, 0))
	New("WeldConstraint", { Part0 = root, Part1 = body, Parent = body })
	carryModel.Name = "CarriedSlime"
	carryModel.Parent = thief.Character
	local highlight = New("Highlight", {
		FillColor = Color3.fromRGB(255, 50, 70),
		OutlineColor = Color3.fromRGB(255, 255, 255),
		FillTransparency = 0.65,
		DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
		Adornee = thief.Character,
		Parent = thief.Character,
	})
	carries[thief] = {
		victim = victim,
		uid = uid,
		slime = slime,
		model = carryModel,
		highlight = highlight,
		started = os.clock(),
	}
	S.PlayerService.refreshSpeed(thief)
	local def = Slimes.ById[slime.id]
	S.PlayerService.notify(victim, "🚨 " .. thief.DisplayName .. " is stealing your " .. def.name .. "! BONK them!", "alert")
	S.PlayerService.fx(victim, "stolenAlert", { thief = thief.DisplayName, name = def.name })
	S.PlayerService.notify(thief, "🏃 Run back to YOUR base with " .. def.name .. "!", "info")
	S.PlayerService.sync(thief, { carrying = { id = slime.id, mut = slime.mut, name = def.name } })
end

function CarryService.drop(thief: Player, reason: string)
	local carry = carries[thief]
	if not carry then
		return
	end
	carries[thief] = nil
	cleanupVisual(carry)
	if thief.Parent then
		S.PlayerService.refreshSpeed(thief)
		S.PlayerService.sync(thief, { carrying = false })
		S.PlayerService.notify(thief, "💨 The slime escaped back home! (" .. reason .. ")", "warning")
	end
	local victim = carry.victim
	if victim.Parent and S.PlayerService.isReady(victim) then
		local slime = S.SlimeService.find(victim, carry.uid)
		if slime then
			S.SlimeService.restoreModel(victim, slime)
			S.PlayerService.notify(victim, "✅ Your " .. Slimes.ById[slime.id].name .. " is back!", "success")
		end
	end
end

local function deliver(thief: Player)
	local carry = carries[thief]
	carries[thief] = nil
	cleanupVisual(carry)
	S.PlayerService.refreshSpeed(thief)
	S.PlayerService.sync(thief, { carrying = false })
	local victim = carry.victim
	local removed = S.SlimeService.removeSlime(victim, carry.uid)
	if not removed then
		return
	end
	local granted = S.SlimeService.grantSlime(thief, removed.id, removed.mut, { level = removed.lvl })
	if not granted then
		removed.carried = nil
		S.SlimeService.grantSlime(victim, removed.id, removed.mut, { level = removed.lvl, pad = removed.pad })
		S.PlayerService.notify(thief, "Your base was full — the slime escaped!", "warning")
		return
	end
	local def = Slimes.ById[removed.id]
	local thiefProfile = S.DataService.get(thief)
	local victimProfile = S.DataService.get(victim)
	thiefProfile.data.stats.steals += 1
	S.PlayerService.setStat(thief, "Steals", thiefProfile.data.stats.steals)
	if victimProfile then
		victimProfile.data.stats.stolenFrom += 1
	end
	S.RewardService.progress(thief, "steal", 1)
	S.PlayerService.notify(thief, "😈 You stole " .. def.name .. "!", "success")
	S.PlayerService.fx(thief, "celebrate", { text = "STOLEN!" })
	S.PlayerService.notify(victim, "😭 " .. thief.DisplayName .. " stole your " .. def.name
		.. "! Lock your base 🔒 or get a 🛡️ Shield.", "alert")
	S.PlayerService.fx(victim, "stolen", { name = def.name })
	if Rarities.ByKey[def.rarity].rank >= Rarities.ByKey.Legendary.rank then
		S.PlayerService.notifyAll(string.format("😈 %s stole %s's %s %s!", thief.DisplayName, victim.DisplayName,
			def.rarity, def.name), "event")
	end
end

-- Called when either side leaves or the thief dies.
function CarryService.cancelFor(player: Player, reason: string)
	if carries[player] then
		CarryService.drop(player, reason)
	end
	for thief, carry in carries do
		if carry.victim == player then
			carries[thief] = nil
			cleanupVisual(carry)
			carry.slime.carried = nil
			if thief.Parent then
				S.PlayerService.refreshSpeed(thief)
				S.PlayerService.sync(thief, { carrying = false })
				S.PlayerService.notify(thief, "The owner left — the slime vanished!", "warning")
			end
		end
	end
end

function CarryService.init(services)
	S = services
	S.PlayerService.onLeaving(function(player)
		CarryService.cancelFor(player, "left")
	end)
	S.PlayerService.addState(function()
		return { carrying = false }
	end)
end

function CarryService.start()
	while true do
		task.wait(0.2)
		for thief, carry in carries do
			local root = rootOf(thief)
			if not thief.Parent or not root or not alive(thief) then
				CarryService.drop(thief, "fainted")
			elseif os.clock() - carry.started > Tuning.CarryMaxSeconds then
				CarryService.drop(thief, "too slow")
			else
				local plot = S.PlotService.get(thief)
				if plot and S.PlotService.isInside(plot, root.Position) then
					deliver(thief)
				end
			end
		end
	end
end

return CarryService
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX932DB822F5184EAB80888E879FD53CB1">
        <Properties>
          <string name="Name">DataService</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Player data with session locking.

	* Load: UpdateAsync claims a lock { job = JobId, t = time }. If another live
	  server holds it (player just hopped servers) we retry, then take it over.
	* Save: refuses to overwrite data whose lock belongs to another server
	  (prevents an old server from rolling back newer progress).
	* Receipts: MonetizationService calls saveNow() before telling Roblox a
	  purchase is granted, so a grant is never lost or applied twice.
	* Studio without "Enable Studio Access to API Services" falls back to memory.
]]
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local DataService = {}

local JOB_ID = if game.JobId ~= "" then game.JobId else "studio-" .. tostring(math.random(1, 1e9))
local LOCK_RETRIES = 5
local LOCK_RETRY_WAIT = 4
local MAX_RECEIPTS = 120

DataService.Template = {
	version = 1,
	cash = Config.Tuning.StartingCash,
	totalEarned = 0,
	rebirths = 0,
	nextUid = 1,
	slimes = {},
	giftedPasses = {},
	giftCredits = {},
	giftsReceived = {},
	boosts = {},
	index = {},
	daily = { streak = 0, lastDay = 0 },
	quests = { day = 0, list = {} },
	codes = {},
	receipts = {},
	starterPack = false,
	offlinePending = 0,
	stats = {
		steals = 0,
		stolenFrom = 0,
		bought = 0,
		sold = 0,
		fused = 0,
		bonks = 0,
		playtime = 0,
		sessions = 0,
		robuxSpent = 0,
	},
	settings = { music = true, sfx = true, lowGfx = false },
	tutorial = 0,
	firstJoin = 0,
	lastOnline = 0,
}

local profiles: { [Player]: any } = {}
local store: DataStore? = nil
local memoryMode = false
local warnedMemory = false

local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local out = {}
	for k, v in value do
		out[k] = deepCopy(v)
	end
	return out
end

-- Adds keys that exist in the template but not in saved data (new features).
local function reconcile(data, template)
	for key, value in template do
		if data[key] == nil then
			data[key] = deepCopy(value)
		elseif type(value) == "table" and type(data[key]) == "table" and next(value) ~= nil and #value == 0 then
			reconcile(data[key], value)
		end
	end
end

-- DataStores cannot hold NaN/inf; replace them before every save.
local function sanitize(value)
	if type(value) == "table" then
		for k, v in value do
			if type(v) == "number" and (v ~= v or v == math.huge or v == -math.huge) then
				value[k] = 0
			elseif type(v) == "table" then
				sanitize(v)
			end
		end
	end
end

local function useMemory(reason: string)
	memoryMode = true
	if not warnedMemory then
		warnedMemory = true
		warn("[DataService] Using in-memory data (progress will NOT save): " .. reason
			.. "\nIn Studio: Game Settings > Security > Enable Studio Access to API Services.")
	end
end

local function isStudioAccessError(err: string): boolean
	err = string.lower(tostring(err))
	return RunService:IsStudio() and (string.find(err, "studio", 1, true) ~= nil
		or string.find(err, "403", 1, true) ~= nil
		or string.find(err, "api services", 1, true) ~= nil
		or string.find(err, "publish", 1, true) ~= nil)
end

local function getStore(): DataStore?
	if store or memoryMode then
		return store
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		useMemory(tostring(result))
	end
	return store
end

local function waitForBudget()
	local deadline = os.clock() + 8
	while os.clock() < deadline do
		local ok, budget = pcall(function()
			return DataStoreService:GetRequestBudgetForRequestType(Enum.DataStoreRequestType.UpdateAsync)
		end)
		if not ok or budget > 0 then
			return
		end
		task.wait(0.5)
	end
end

-- Returns true when UpdateAsync completed (the transform may have cancelled).
local function update(key: string, transform, attempts: number): boolean
	local ds = getStore()
	if not ds then
		return false
	end
	for attempt = 1, attempts do
		waitForBudget()
		local ok, err = pcall(function()
			ds:UpdateAsync(key, transform)
		end)
		if ok then
			return true
		end
		if isStudioAccessError(err) then
			useMemory(tostring(err))
			return false
		end
		warn(string.format("[DataService] UpdateAsync %s failed (%d/%d): %s", key, attempt, attempts, tostring(err)))
		if attempt < attempts then
			task.wait(math.min(2 ^ attempt, 12))
		end
	end
	return false
end

local function newProfile(player: Player, data, memoryOnly: boolean)
	reconcile(data, DataService.Template)
	if data.firstJoin == 0 then
		data.firstJoin = os.time()
	end
	data.stats.sessions += 1
	local profile = {
		player = player,
		key = "u_" .. player.UserId,
		data = data,
		memoryOnly = memoryOnly,
		saving = false,
		lockLost = false,
		sessionStart = os.clock(),
		lastOnline = data.lastOnline,
	}
	profiles[player] = profile
	return profile
end

-- Loads (and locks) a player's data. Returns the profile or nil on failure.
function DataService.load(player: Player)
	local key = "u_" .. player.UserId
	if memoryMode or not getStore() then
		return newProfile(player, deepCopy(DataService.Template), true)
	end

	local loaded = nil
	for attempt = 1, LOCK_RETRIES + 1 do
		local force = attempt > LOCK_RETRIES
		local claimed = nil
		local ok = update(key, function(old)
			claimed = nil
			if type(old) ~= "table" then
				old = deepCopy(DataService.Template)
			end
			local lock = old._lock
			if lock and lock.job ~= JOB_ID and not force then
				return nil -- another server still owns this session
			end
			old._lock = { job = JOB_ID, t = os.time() }
			claimed = old
			return old
		end, 3)
		if memoryMode then
			return newProfile(player, deepCopy(DataService.Template), true)
		end
		if not ok then
			return nil
		end
		if claimed then
			loaded = claimed
			break
		end
		if not player.Parent then
			return nil
		end
		task.wait(LOCK_RETRY_WAIT)
	end
	if not loaded then
		return nil
	end
	if not player.Parent then
		-- left while loading: give the lock back
		update(key, function(old)
			if type(old) == "table" and old._lock and old._lock.job == JOB_ID then
				old._lock = nil
				return old
			end
			return nil
		end, 2)
		return nil
	end
	return newProfile(player, loaded, false)
end

local function doSave(profile, release: boolean): boolean
	while profile.saving do
		task.wait(0.1)
	end
	if profile.memoryOnly then
		return true
	end
	if profile.lockLost then
		return false
	end
	profile.saving = true
	local data = profile.data
	data.lastOnline = os.time()
	sanitize(data)
	local ok = update(profile.key, function(old)
		if type(old) == "table" and old._lock and old._lock.job ~= JOB_ID then
			profile.lockLost = true
			return nil
		end
		data._lock = if release then nil else { job = JOB_ID, t = os.time() }
		return data
	end, if release then 5 else 3)
	profile.saving = false
	if profile.lockLost then
		warn("[DataService] session lock lost for " .. profile.key .. "; not saving")
		local player = profile.player
		if player.Parent and not release then
			player:Kick("Your data was opened in another server. Please rejoin.")
		end
		return false
	end
	return ok
end

function DataService.get(player: Player)
	return profiles[player]
end

function DataService.waitFor(player: Player, timeout: number)
	local deadline = os.clock() + timeout
	while not profiles[player] and player.Parent and os.clock() < deadline do
		task.wait(0.2)
	end
	return profiles[player]
end

function DataService.saveNow(player: Player): boolean
	local profile = profiles[player]
	if not profile then
		return false
	end
	return doSave(profile, false)
end

function DataService.release(player: Player)
	local profile = profiles[player]
	if not profile then
		return
	end
	doSave(profile, true)
	profiles[player] = nil
end

function DataService.hasReceipt(profile, purchaseId: string): boolean
	return table.find(profile.data.receipts, purchaseId) ~= nil
end

function DataService.addReceipt(profile, purchaseId: string)
	local receipts = profile.data.receipts
	table.insert(receipts, purchaseId)
	while #receipts > MAX_RECEIPTS do
		table.remove(receipts, 1)
	end
end

function DataService.nextUid(profile): string
	local n = profile.data.nextUid
	profile.data.nextUid = n + 1
	return "s" .. n
end

-- Admin testing helper: wipe the caller's progress (keeps receipts so purchases stay safe).
function DataService.wipe(player: Player)
	local profile = profiles[player]
	if not profile then
		return
	end
	local receipts = profile.data.receipts
	local lock = profile.data._lock
	local fresh = deepCopy(DataService.Template)
	fresh.receipts = receipts
	fresh._lock = lock
	fresh.firstJoin = os.time()
	profile.data = fresh
end

function DataService.isMemoryMode(): boolean
	return memoryMode
end

function DataService.init(_S)
	getStore()
end

function DataService.start()
	-- autosave, staggered so requests are spread over time
	while true do
		task.wait(Config.Tuning.AutosaveSeconds)
		for player, profile in profiles do
			if player.Parent then
				task.spawn(doSave, profile, false)
				task.wait(1)
			end
		end
	end
end

-- Saves and unlocks every remaining profile (server shutdown).
function DataService.releaseAll(timeout: number)
	local pending = 0
	for player, profile in profiles do
		pending += 1
		task.spawn(function()
			doSave(profile, true)
			profiles[player] = nil
			pending -= 1
		end)
	end
	local deadline = os.clock() + timeout
	while pending > 0 and os.clock() < deadline do
		task.wait(0.2)
	end
end

return DataService
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX7DCF89E7A3D04069956D79FC5480577E">
        <Properties>
          <string name="Name">EconomyService</string>
          <ProtectedString name="Source"><![CDATA[-- Cash, multipliers, per-second income, slime growth, boosts, offline earnings
-- and rebirths. All cash changes go through addCash/spend.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))
local Format = require(Shared:WaitForChild("Format"))

local Tuning = Config.Tuning
local EconomyService = {}

local S
local stored: { [Player]: { [number]: number } } = {}
local incomeCache: { [Player]: number } = {}
local earnedAgg: { [Player]: number } = {}

local function profileOf(player: Player)
	return S.DataService.get(player)
end

function EconomyService.boostLeft(player: Player, key: string): number
	local profile = profileOf(player)
	return if profile then (profile.data.boosts[key] or 0) else 0
end

function EconomyService.addBoost(player: Player, key: string, seconds: number)
	local profile = profileOf(player)
	if not profile then
		return
	end
	profile.data.boosts[key] = (profile.data.boosts[key] or 0) + seconds
	if key == "shield" then
		S.PlotService.onShieldChanged(player)
	end
	S.PlayerService.sync(player, { boosts = profile.data.boosts })
end

-- Total cash multiplier. includeTemporary=false excludes potions (used for
-- scaled rewards so buying a potion doesn't inflate cash packs).
function EconomyService.multiplier(player: Player, includeTemporary: boolean?): (number, { [string]: number })
	local profile = profileOf(player)
	local parts = {}
	local total = 1
	if not profile then
		return total, parts
	end
	local function add(name: string, mult: number)
		if mult ~= 1 then
			parts[name] = mult
			total *= mult
		end
	end
	local data = profile.data
	add("Rebirths", Economy.rebirthMult(data.rebirths))
	if S.MonetizationService.has(player, "DoubleCash") then
		add("2x Cash Pass", 2)
	end
	if S.MonetizationService.has(player, "VIP") then
		add("VIP", 1.5)
	end
	if includeTemporary ~= false and (data.boosts.cash2x or 0) > 0 then
		add("2x Potion", 2)
	end
	if player:GetAttribute("InGroup") then
		add("Group", 1 + Config.GroupBonus)
	end
	if S.MonetizationService.isPremium(player) then
		add("Premium", 1 + Config.PremiumBonus)
	end
	if S.MonetizationService.isClub(player) then
		add(Config.SubscriptionName, 1 + Config.SubscriptionBonus)
	end
	local friends = S.PlayerService.friendCount(player)
	if friends > 0 then
		add("Friends", 1 + math.min(friends * Tuning.FriendBonusEach, Tuning.FriendBonusMax))
	end
	local discovered = 0
	for _ in data.index do
		discovered += 1
	end
	if discovered > 0 then
		add("Index", 1 + discovered * Tuning.IndexBonusEach)
	end
	return total, parts
end

function EconomyService.incomePerSecond(player: Player): number
	return incomeCache[player] or 0
end

function EconomyService.baseIncomePerSecond(player: Player): number
	local profile = profileOf(player)
	if not profile then
		return 0
	end
	local mult = EconomyService.multiplier(player, false)
	local total = 0
	for _, slime in profile.data.slimes do
		total += Economy.slimeIncome(slime)
	end
	return total * mult
end

local function publishCash(player: Player, profile)
	S.PlayerService.setStat(player, "Cash", Format.cash(profile.data.cash))
end

-- sku/transactionType are logged to Creator Analytics when given.
function EconomyService.addCash(player: Player, amount: number, sku: string?, transactionType: string?)
	local profile = profileOf(player)
	if not profile or amount ~= amount or amount <= 0 then
		return
	end
	amount = math.min(amount, 1e300)
	profile.data.cash += amount
	profile.data.totalEarned += amount
	if sku then
		S.Analytics.economy(player, "Source", amount, profile.data.cash, transactionType or "Gameplay", sku)
	else
		earnedAgg[player] = (earnedAgg[player] or 0) + amount
	end
	publishCash(player, profile)
	S.PlayerService.sync(player, { cash = profile.data.cash, totalEarned = profile.data.totalEarned })
end

function EconomyService.spend(player: Player, amount: number, sku: string): boolean
	local profile = profileOf(player)
	if not profile or amount ~= amount or amount < 0 or profile.data.cash < amount then
		return false
	end
	profile.data.cash -= amount
	S.Analytics.economy(player, "Sink", amount, profile.data.cash, "Shop", sku)
	publishCash(player, profile)
	S.PlayerService.sync(player, { cash = profile.data.cash })
	return true
end

function EconomyService.collectPad(player: Player, padIndex: number)
	local playerStored = stored[player]
	local amount = playerStored and playerStored[padIndex] or 0
	if amount < 1 then
		return
	end
	playerStored[padIndex] = 0
	EconomyService.addCash(player, amount)
	local plot = S.PlotService.get(player)
	if plot then
		S.PlotService.setPadStored(plot, padIndex, 0)
		local pad = plot.pads[padIndex]
		S.PlayerService.fx(player, "cash", { position = pad.collect.Position, amount = amount })
	end
	S.RewardService.progress(player, "collect", amount)
	S.RewardService.tutorialStep(player, 2)
end

function EconomyService.clearPad(player: Player, padIndex: number)
	local playerStored = stored[player]
	if playerStored and (playerStored[padIndex] or 0) > 0 then
		local amount = playerStored[padIndex]
		playerStored[padIndex] = 0
		EconomyService.addCash(player, amount)
	end
	local plot = S.PlotService.get(player)
	if plot then
		S.PlotService.setPadStored(plot, padIndex, 0)
	end
end

local function collectAll(player: Player)
	local playerStored = stored[player]
	if not playerStored then
		return
	end
	local total = 0
	for i, amount in playerStored do
		total += amount
		playerStored[i] = 0
	end
	if total > 0 then
		EconomyService.addCash(player, total)
	end
end

local function offlineCapHours(player: Player): number
	if S.MonetizationService.isClub(player) then
		return Tuning.OfflineCapHoursClub
	elseif S.MonetizationService.has(player, "VIP") then
		return Tuning.OfflineCapHoursVIP
	end
	return Tuning.OfflineCapHours
end

local function computeOffline(player: Player, profile)
	local data = profile.data
	if data.offlinePending > 0 or profile.lastOnline <= 0 or #data.slimes == 0 then
		return
	end
	local away = os.time() - profile.lastOnline
	if away < 60 then
		return
	end
	local seconds = math.min(away, offlineCapHours(player) * 3600)
	local amount = Economy.offlineEarnings(data.slimes, EconomyService.multiplier(player, false), seconds)
	if amount >= 1 then
		data.offlinePending = amount
		profile.offlineSeconds = seconds
	end
end

function EconomyService.claimOffline(player: Player, factor: number, sku: string)
	local profile = profileOf(player)
	if not profile or profile.data.offlinePending <= 0 then
		return 0
	end
	local amount = profile.data.offlinePending * factor
	profile.data.offlinePending = 0
	EconomyService.addCash(player, amount, sku, if factor > 1 then "IAP" else "TimedReward")
	S.PlayerService.sync(player, { offline = false })
	S.PlayerService.fx(player, "celebrate", { text = "+" .. Format.cash(amount) })
	return amount
end

function EconomyService.rebirth(player: Player)
	local profile = profileOf(player)
	local data = profile.data
	local cost = Economy.rebirthCost(data.rebirths)
	if data.cash < cost then
		return { ok = false, msg = "You need " .. Format.cash(cost) .. " to rebirth!" }
	end
	S.Analytics.economy(player, "Sink", cost, data.cash - cost, "Gameplay", "Rebirth")
	data.cash = Tuning.StartingCash
	data.rebirths += 1
	player:SetAttribute("Rebirths", data.rebirths)
	S.PlayerService.setStat(player, "Rebirths", data.rebirths)
	publishCash(player, profile)
	S.PlotService.refreshPads(player)
	S.PlayerService.refreshNametag(player)
	S.Analytics.progression(player, "Rebirth", data.rebirths, "Rebirth " .. data.rebirths)
	S.PlayerService.notifyAll(string.format("⭐ %s reached REBIRTH %d!", player.DisplayName, data.rebirths), "event")
	S.PlayerService.fx(player, "celebrate", { text = "REBIRTH " .. data.rebirths .. "!" })
	S.PlayerService.sync(player, EconomyService.state(player))
	S.PlayerService.sync(player, S.PlotService.state(player))
	return { ok = true }
end

function EconomyService.state(player: Player)
	local profile = profileOf(player)
	local mult, parts = EconomyService.multiplier(player)
	return {
		cash = profile.data.cash,
		totalEarned = profile.data.totalEarned,
		rebirths = profile.data.rebirths,
		income = incomeCache[player] or 0,
		mult = mult,
		multParts = parts,
		boosts = profile.data.boosts,
		offline = if profile.data.offlinePending > 0
			then { amount = profile.data.offlinePending, seconds = profile.offlineSeconds or 0 }
			else false,
	}
end

local function tickPlayer(player: Player, profile)
	local data = profile.data
	local mult = EconomyService.multiplier(player)
	local auto = S.MonetizationService.has(player, "AutoCollect")
	local plot = S.PlotService.get(player)
	local playerStored = stored[player]
	if not playerStored then
		playerStored = {}
		stored[player] = playerStored
	end
	local total = 0
	for _, slime in data.slimes do
		if not slime.carried then
			local income = Economy.slimeIncome(slime) * mult
			total += income
			if not auto then
				playerStored[slime.pad] = (playerStored[slime.pad] or 0) + income
				if plot then
					S.PlotService.setPadStored(plot, slime.pad, playerStored[slime.pad])
				end
			end
			if slime.lvl < Economy.LEVEL_MAX then
				slime.xp = (slime.xp or 0) + 1
				if slime.xp >= Economy.xpToNext(slime.lvl) then
					slime.xp = 0
					slime.lvl += 1
					S.SlimeService.onLevelUp(player, slime)
				end
			end
		end
	end
	incomeCache[player] = total
	if auto and total > 0 then
		EconomyService.addCash(player, total)
	end
	for key, left in data.boosts do
		if left > 0 then
			data.boosts[key] = math.max(0, left - 1)
			if data.boosts[key] == 0 then
				if key == "shield" then
					S.PlotService.onShieldChanged(player)
					S.PlayerService.notify(player, "🛡️ Your base shield expired.", "warning")
				elseif key == "cash2x" then
					S.PlayerService.notify(player, "🧪 2x Cash boost ended.", "info")
				end
			end
		end
	end
	S.PlayerService.sync(player, {
		cash = data.cash,
		income = total,
		baseIncome = EconomyService.baseIncomePerSecond(player),
		mult = mult,
		boosts = data.boosts,
	})
end

function EconomyService.init(services)
	S = services
	S.PlayerService.onReady(function(player, profile)
		stored[player] = {}
		computeOffline(player, profile)
	end)
	S.PlayerService.onLeaving(function(player)
		collectAll(player)
		local agg = earnedAgg[player]
		if agg and agg > 0 then
			local profile = profileOf(player)
			S.Analytics.economy(player, "Source", agg, profile.data.cash, "Gameplay", "SlimeIncome")
		end
		stored[player] = nil
		incomeCache[player] = nil
		earnedAgg[player] = nil
	end)
	S.PlayerService.addState(function(player)
		return EconomyService.state(player)
	end)
	S.PlayerService.registerAction("rebirth", function(player)
		return EconomyService.rebirth(player)
	end)
	S.PlayerService.registerAction("claimOffline", function(player, mode)
		if mode == "ad" then
			return S.MonetizationService.showAd(player, "offline")
		elseif mode == "robux" then
			return S.MonetizationService.promptProduct(player, "OfflineDouble")
		end
		EconomyService.claimOffline(player, 1, "OfflineEarnings")
		return { ok = true }
	end)
end

function EconomyService.start()
	local lastFlush = os.clock()
	while true do
		task.wait(1)
		for _, player in S.PlayerService.readyPlayers() do
			local profile = profileOf(player)
			if profile then
				local ok, err = pcall(tickPlayer, player, profile)
				if not ok then
					warn("[EconomyService] tick failed: " .. tostring(err))
				end
			end
		end
		if os.clock() - lastFlush > 60 then
			lastFlush = os.clock()
			for player, amount in earnedAgg do
				local profile = profileOf(player)
				if profile and amount > 0 then
					S.Analytics.economy(player, "Source", amount, profile.data.cash, "Gameplay", "SlimeIncome")
				end
				earnedAgg[player] = 0
			end
		end
	end
end

return EconomyService
]]></ProtectedString>
