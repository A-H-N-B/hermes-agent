        <Item class="Folder" referent="RBXB0DB3035EF9045D5A0A006E5262D0272">
          <Properties>
            <string name="Name">Panels</string>
          </Properties>
          <Item class="ModuleScript" referent="RBX379E7A5F62D8461294236EA9C2ADEAF8">
            <Properties>
              <string name="Name">Collection</string>
              <ProtectedString name="Source"><![CDATA[-- "Slimes" (your base: sell / fuse) and "Index" (collection book) panels.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))
local Format = require(Shared:WaitForChild("Format"))
local Mutations = require(Shared:WaitForChild("Mutations"))
local Rarities = require(Shared:WaitForChild("Rarities"))
local Slimes = require(Shared:WaitForChild("Slimes"))
local Client = script.Parent.Parent
local Net = require(Client:WaitForChild("Net"))
local Notify = require(Client:WaitForChild("Notify"))
local State = require(Client:WaitForChild("State"))
local Theme = require(Client:WaitForChild("Theme"))
local UIKit = require(Client:WaitForChild("UIKit"))

local C = Theme.Colors
local New = UIKit.New
local Collection = {}

local function slimeLabel(slime): string
	local def = Slimes.ById[slime.id]
	return (if slime.mut ~= "None" then slime.mut .. " " else "") .. def.name
end

local function buildSlimesPanel()
	local panel = UIKit.panel("Slimes", "🟢 MY SLIMES", Vector2.new(780, 520))
	local header = UIKit.label({ Text = "", Size = UDim2.new(1, 0, 0, 28), TextColor3 = C.SubText, MaxTextSize = 20,
		Parent = panel.content })
	local list = UIKit.scroll({ Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, 0, 1, -34), Parent = panel.content })
	local confirmUid: string? = nil

	local function render()
		UIKit.clear(list)
		UIKit.list(Enum.FillDirection.Vertical, 8).Parent = list
		local slimes = table.clone(State.get("slimes") or {})
		table.sort(slimes, function(a, b)
			return Economy.slimeIncome(a) > Economy.slimeIncome(b)
		end)
		header.Text = string.format("%d / %d pads used   ·   3 identical slimes = Fuse into a better mutation!",
			#slimes, State.get("maxPads") or Config.Tuning.BasePads)

		-- fusion offers
		local counts, order = {}, 0
		for _, slime in slimes do
			counts[slime.id] = (counts[slime.id] or 0) + 1
		end
		for id, count in counts do
			if count >= 3 then
				order += 1
				local def = Slimes.ById[id]
				local row = New("Frame", {
					BackgroundColor3 = C.Purple,
					Size = UDim2.new(1, -12, 0, 64),
					LayoutOrder = order,
					Parent = list,
				}, { UIKit.corner(0.2), UIKit.stroke(3, C.Gold) })
				local icon = UIKit.slimeIcon(id, "None", UDim2.fromOffset(60, 50), true)
				icon.Position = UDim2.fromOffset(10, 7)
				icon.Parent = row
				UIKit.label({ Text = "✨ Fuse 3x " .. def.name .. " → upgraded mutation!", Size = UDim2.new(0.62, 0, 0.7, 0),
					Position = UDim2.fromOffset(84, 10), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 22,
					Parent = row })
				UIKit.button({
					Text = "FUSE",
					Color = C.Gold,
					Size = UDim2.fromOffset(130, 46),
					Position = UDim2.new(1, -140, 0.5, 0),
					AnchorPoint = Vector2.new(0, 0.5),
					Parent = row,
					OnClick = function()
						local result = Net.call("fuse", id)
						if not result.ok and result.msg then
							Notify.show(result.msg, "warning")
						end
					end,
				})
			end
		end

		for i, slime in slimes do
			local def = Slimes.ById[slime.id]
			local rarity = Rarities.ByKey[def.rarity]
			local row = New("Frame", {
				BackgroundColor3 = C.Card,
				Size = UDim2.new(1, -12, 0, 70),
				LayoutOrder = 100 + i,
				Parent = list,
			}, { UIKit.corner(0.2), UIKit.stroke(3, rarity.color) })
			local icon = UIKit.slimeIcon(slime.id, slime.mut, UDim2.fromOffset(64, 54), true)
			icon.Position = UDim2.fromOffset(10, 8)
			icon.Parent = row
			UIKit.label({ Text = slimeLabel(slime), Size = UDim2.new(0.42, 0, 0, 30), Position = UDim2.fromOffset(86, 6),
				TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Mutations.ByKey[slime.mut].color, MaxTextSize = 24,
				Parent = row })
			UIKit.label({
				Text = string.format("%s · Lv %d%s", def.rarity, slime.lvl, if slime.lvl >= Economy.LEVEL_MAX then " MAX" else ""),
				Size = UDim2.new(0.42, 0, 0, 24),
				Position = UDim2.fromOffset(86, 38),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextColor3 = rarity.color,
				MaxTextSize = 18,
				Parent = row,
			})
			UIKit.label({ Text = Format.rate(Economy.slimeIncome(slime)), Size = UDim2.new(0.2, 0, 0, 30),
				Position = UDim2.new(0.55, 0, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), TextColor3 = C.Cash, MaxTextSize = 22,
				Parent = row })
			local confirming = confirmUid == slime.uid
			UIKit.button({
				Text = if confirming then "Sure?" else "Sell " .. Format.cash(Economy.sellValue(slime)),
				Color = if confirming then C.Red else C.PanelLight,
				Size = UDim2.fromOffset(150, 44),
				Position = UDim2.new(1, -160, 0.5, 0),
				AnchorPoint = Vector2.new(0, 0.5),
				MaxTextSize = 20,
				Parent = row,
				OnClick = function()
					if rarity.rank >= Rarities.ByKey.Epic.rank and confirmUid ~= slime.uid then
						confirmUid = slime.uid
						render()
						return
					end
					confirmUid = nil
					Net.call("sell", slime.uid)
				end,
			})
		end
	end
	panel.onOpen = function()
		confirmUid = nil
		render()
	end
	State.on("slimes", function()
		if UIKit.isOpen("Slimes") then
			render()
		end
	end)
end

local function buildIndexPanel()
	local panel = UIKit.panel("Index", "📖 SLIME INDEX", Vector2.new(800, 520))
	local header = UIKit.label({ Text = "", Size = UDim2.new(1, 0, 0, 30), MaxTextSize = 22, Parent = panel.content })
	local grid = UIKit.scroll({ Position = UDim2.fromOffset(0, 38), Size = UDim2.new(1, 0, 1, -38), Parent = panel.content })

	local function render()
		UIKit.clear(grid)
		UIKit.grid(Vector2.new(140, 168), 10).Parent = grid
		local index = State.get("index") or {}
		local found = 0
		for _, def in Slimes.List do
			local entry = index[def.id]
			local known = entry ~= nil
			if known then
				found += 1
			end
			local rarity = Rarities.ByKey[def.rarity]
			local card = New("Frame", {
				BackgroundColor3 = if known then C.Card else C.PanelLight,
				LayoutOrder = def.index,
				Parent = grid,
			}, { UIKit.corner(0.12), UIKit.stroke(3, if known then rarity.color else C.Stroke) })
			local icon = UIKit.slimeIcon(def.id, "None", UDim2.fromOffset(76, 63), known)
			icon.AnchorPoint = Vector2.new(0.5, 0)
			icon.Position = UDim2.new(0.5, 0, 0, 10)
			icon.Parent = card
			UIKit.label({ Text = if known then def.name else "???", Size = UDim2.new(1, -10, 0, 26),
				Position = UDim2.fromOffset(5, 80), MaxTextSize = 20, Parent = card })
			UIKit.label({ Text = def.rarity, Size = UDim2.new(1, -10, 0, 20), Position = UDim2.fromOffset(5, 106),
				TextColor3 = rarity.color, MaxTextSize = 16, Parent = card })
			-- mutation dots
			local dots = New("Frame", {
				BackgroundTransparency = 1,
				Size = UDim2.new(1, -10, 0, 22),
				Position = UDim2.fromOffset(5, 134),
				Parent = card,
			}, { UIKit.list(Enum.FillDirection.Horizontal, 4) })
			for _, mut in Mutations.List do
				local has = entry ~= nil and entry[mut.key] == true
				New("Frame", {
					BackgroundColor3 = if has then mut.color else Color3.fromRGB(40, 35, 60),
					Size = UDim2.fromOffset(18, 18),
					LayoutOrder = mut.rank,
					Parent = dots,
				}, { UIKit.corner(0.5), UIKit.stroke(1) })
			end
		end
		header.Text = string.format("Discovered %d / %d   ·   +%d%% cash bonus   ·   dots = mutations found", found,
			#Slimes.List, math.floor(found * Config.Tuning.IndexBonusEach * 100 + 0.5))
	end
	panel.onOpen = render
	State.on("index", function()
		if UIKit.isOpen("Index") then
			render()
		end
	end)
end

function Collection.init()
	buildSlimesPanel()
	buildIndexPanel()
end

return Collection
]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX8D69A9C5086144EC843468BAF4102009">
            <Properties>
              <string name="Name">Misc</string>
              <ProtectedString name="Source"><![CDATA[-- Smaller panels: Codes (+ group join / invites), Settings, the offline
-- earnings popup, the Starter Pack offer and the admin panel.
local GroupService = game:GetService("GroupService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SocialService = game:GetService("SocialService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Rarities = require(Shared:WaitForChild("Rarities"))
local Client = script.Parent.Parent
local Net = require(Client:WaitForChild("Net"))
local Notify = require(Client:WaitForChild("Notify"))
local State = require(Client:WaitForChild("State"))
local Theme = require(Client:WaitForChild("Theme"))
local UIKit = require(Client:WaitForChild("UIKit"))

local C = Theme.Colors
local New = UIKit.New
local player = Players.LocalPlayer
local Misc = {}

local function report(result)
	if result.msg then
		Notify.show(result.msg, if result.ok then "success" else "warning")
	end
end

local function invite()
	local ok, canSend = pcall(function()
		return SocialService:CanSendGameInviteAsync(player)
	end)
	if ok and canSend then
		pcall(function()
			SocialService:PromptGameInvite(player)
		end)
	else
		Notify.show("Invites aren't available on this device.", "warning")
	end
end

local function buildCodes()
	local panel = UIKit.panel("Codes", "🔑 CODES", Vector2.new(600, 430))
	local c = panel.content
	UIKit.label({ Text = "Enter a code for free rewards!", Size = UDim2.new(1, 0, 0, 30), MaxTextSize = 24, Parent = c })
	local box = New("TextBox", {
		Name = "CodeBox",
		BackgroundColor3 = Color3.fromRGB(25, 20, 45),
		Position = UDim2.fromOffset(20, 44),
		Size = UDim2.new(1, -40, 0, 56),
		Font = Theme.Font,
		PlaceholderText = "TYPE CODE HERE",
		PlaceholderColor3 = C.SubText,
		Text = "",
		TextColor3 = C.Text,
		TextScaled = true,
		ClearTextOnFocus = false,
		Parent = c,
	}, { UIKit.corner(0.25), UIKit.stroke(3), New("UITextSizeConstraint", { MaxTextSize = 30 }) })
	UIKit.button({
		Text = "REDEEM",
		Color = C.Green,
		Size = UDim2.fromOffset(220, 54),
		Position = UDim2.new(0.5, 0, 0, 140),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Parent = c,
		OnClick = function()
			local result = Net.call("redeem", box.Text)
			if not result.ok then
				Notify.show(result.msg or "Invalid code", "error")
			end
			box.Text = ""
		end,
	})
	local groupButton = UIKit.button({
		Text = "👥 Join Group (+" .. math.floor(Config.GroupBonus * 100) .. "% cash)",
		Color = C.Blue,
		Size = UDim2.new(1, -40, 0, 50),
		Position = UDim2.fromOffset(20, 190),
		MaxTextSize = 22,
		Parent = c,
		OnClick = function()
			if Config.GroupId > 0 then
				pcall(function()
					GroupService:PromptJoinAsync(Config.GroupId)
				end)
				report(Net.call("checkGroup"))
			end
		end,
	})
	groupButton.Visible = Config.GroupId > 0
	UIKit.button({
		Text = "📨 Invite Friends (+5% cash each!)",
		Color = C.Pink,
		Size = UDim2.new(1, -40, 0, 50),
		Position = UDim2.fromOffset(20, 250),
		MaxTextSize = 22,
		Parent = c,
		OnClick = invite,
	})
	UIKit.label({ Text = Config.SocialText, Size = UDim2.new(1, -40, 0, 26), Position = UDim2.fromOffset(20, 310),
		TextColor3 = C.SubText, MaxTextSize = 18, Parent = c })
	State.on("inGroup", function(inGroup)
		groupButton.Visible = Config.GroupId > 0 and not inGroup
	end)
end

local function buildSettings()
	local panel = UIKit.panel("Settings", "⚙️ SETTINGS", Vector2.new(560, 400))
	local c = panel.content
	UIKit.list(Enum.FillDirection.Vertical, 12).Parent = c
	local rows = {}
	-- music/sfx default ON, low graphics default OFF
	local function isOn(key: string, settings): boolean
		if key == "lowGfx" then
			return settings[key] == true
		end
		return settings[key] ~= false
	end
	local function toggle(key: string, text: string, order: number)
		local _, label = UIKit.button({
			Text = "",
			Color = C.Card,
			Size = UDim2.new(1, -20, 0, 56),
			LayoutOrder = order,
			MaxTextSize = 24,
			Parent = c,
			OnClick = function()
				local settings = table.clone(State.get("settings") or {})
				settings[key] = not isOn(key, settings)
				State.apply({ settings = settings })
				Net.call("settings", settings)
			end,
		})
		rows[key] = { label = label, text = text }
	end
	toggle("music", "🎵 Music", 1)
	toggle("sfx", "🔊 Sound effects", 2)
	toggle("lowGfx", "📱 Low graphics (faster phones)", 3)
	UIKit.button({ Text = "📨 Invite Friends", Color = C.Pink, Size = UDim2.new(1, -20, 0, 56), LayoutOrder = 4,
		MaxTextSize = 24, Parent = c, OnClick = invite })
	State.on("settings", function(settings)
		for key, row in rows do
			row.label.Text = row.text .. ":  " .. (if isOn(key, settings) then "ON ✅" else "OFF ❌")
		end
	end)
end

local function buildOffline()
	local panel = UIKit.panel("Offline", "🌙 WELCOME BACK!", Vector2.new(600, 400))
	local c = panel.content
	local text = UIKit.label({ Text = "", Size = UDim2.new(1, 0, 0, 90), TextWrapped = true, MaxTextSize = 28, Parent = c })
	local amountLabel = UIKit.label({ Text = "", Size = UDim2.new(1, 0, 0, 60), Position = UDim2.fromOffset(0, 92),
		TextColor3 = C.Cash, MaxTextSize = 48, StrokeThickness = 3, Parent = c })
	local buttons = New("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 170),
		Size = UDim2.new(1, 0, 0, 140),
		Parent = c,
	}, { UIKit.list(Enum.FillDirection.Vertical, 10) })
	UIKit.button({ Text = "Collect", Color = C.Green, Size = UDim2.fromOffset(300, 50), LayoutOrder = 3, Parent = buttons,
		OnClick = function()
			Net.call("claimOffline", "normal")
			UIKit.close("Offline")
		end })
	local adButton = UIKit.button({ Text = "📺 Watch video: 2x", Color = C.Blue, Size = UDim2.fromOffset(300, 50),
		LayoutOrder = 1, Parent = buttons, OnClick = function()
			local result = Net.call("claimOffline", "ad")
			if result.ok then
				UIKit.close("Offline")
			else
				report(result)
			end
		end })
	local robuxButton, robuxLabel = UIKit.button({ Text = "", Color = C.Robux, Size = UDim2.fromOffset(300, 50),
		LayoutOrder = 2, Parent = buttons, OnClick = function()
			Net.call("claimOffline", "robux")
		end })
	State.on("offline", function(offline)
		if type(offline) ~= "table" then
			UIKit.close("Offline")
			return
		end
		local hours = math.floor(offline.seconds / 3600)
		local minutes = math.floor((offline.seconds % 3600) / 60)
		text.Text = string.format("Your slimes kept working while you were away (%dh %dm)!", hours, minutes)
		amountLabel.Text = "+" .. Format.cash(offline.amount)
		adButton.Visible = State.get("adsEnabled") == true
		local product = State.productInfo("OfflineDouble")
		robuxButton.Visible = product ~= nil
		if product then
			robuxLabel.Text = "2x for R$ " .. product.price
		end
		UIKit.open("Offline")
	end)
end

local function buildStarter()
	local panel = UIKit.panel("Starter", "🎁 STARTER PACK", Vector2.new(580, 440))
	local c = panel.content
	UIKit.list(Enum.FillDirection.Vertical, 10).Parent = c
	UIKit.label({ Text = "A one-time boost to get you going:", Size = UDim2.new(1, 0, 0, 30), MaxTextSize = 24,
		LayoutOrder = 1, Parent = c })
	for i, line in {
		"💰 30 minutes of your income (at least $25K)",
		"🧪 2x Cash for 1 hour",
		"🟢 Golden Neon Noodle (Epic) — protected from thieves for 10 min",
	} do
		UIKit.label({ Text = line, Size = UDim2.new(1, -20, 0, 34), TextColor3 = C.SubText, MaxTextSize = 22,
			LayoutOrder = 1 + i, Parent = c })
	end
	local _, buyLabel = UIKit.button({ Text = "", Color = C.Robux, Size = UDim2.fromOffset(300, 60), LayoutOrder = 10,
		MaxTextSize = 30, Parent = c, OnClick = function()
			report(Net.call("buyProduct", "StarterPack"))
		end })
	UIKit.label({ Text = "Only once per account.", Size = UDim2.new(1, 0, 0, 24), TextColor3 = C.SubText, MaxTextSize = 18,
		LayoutOrder = 11, Parent = c })
	panel.onOpen = function()
		local product = State.productInfo("StarterPack")
		buyLabel.Text = if product then "R$ " .. product.price else "—"
	end
	State.on("starterPackBought", function(bought)
		if bought then
			UIKit.close("Starter")
		end
	end)
	-- offer it once per session after the player has tried the game a bit
	task.delay(150, function()
		if State.productInfo("StarterPack") and State.get("starterPackBought") == false
			and (State.get("tutorial") or 0) >= 1 and not UIKit.isOpen("Offline") then
			UIKit.open("Starter")
		end
	end)
end

local function buildAdmin()
	local panel = UIKit.panel("Admin", "🛠️ ADMIN", Vector2.new(780, 520))
	local list = UIKit.scroll({ Size = UDim2.fromScale(1, 1), Parent = panel.content })
	UIKit.grid(Vector2.new(176, 52), 8).Parent = list
	local function add(text: string, color: Color3, payload)
		UIKit.button({ Text = text, Color = color, MaxTextSize = 18, Parent = list, OnClick = function()
			report(Net.call("admin", payload))
		end })
	end
	add("🍀 Luck x2 (10m)", C.Green, { cmd = "luck", mult = 2, minutes = 10 })
	add("🍀 Luck x5 (5m)", C.Green, { cmd = "luck", mult = 5, minutes = 5 })
	add("🍀 Luck x10 (5m)", C.Green, { cmd = "luck", mult = 10, minutes = 5 })
	add("🌧️ Rain (5m)", C.Blue, { cmd = "rain", minutes = 5 })
	add("✨ Golden (5m)", C.Gold, { cmd = "golden", minutes = 5 })
	for _, key in State.get("eventKeys") or { "LuckyHour", "GoldenHour", "SlimeRain", "GooMoon" } do
		add("▶ " .. key, C.Purple, { cmd = "event", key = key })
	end
	for _, rarity in Rarities.List do
		if rarity.rank >= 4 then
			add("Spawn " .. rarity.key, C.Pink, { cmd = "spawn", rarity = rarity.key, count = 1 })
		end
	end
	add("+$1M (test)", C.Card, { cmd = "cash", amount = 1e6 })
	add("+$1B (test)", C.Card, { cmd = "cash", amount = 1e9 })
	add("⚠️ Wipe MY data", C.Red, { cmd = "wipe" })
	local box = New("TextBox", {
		BackgroundColor3 = Color3.fromRGB(25, 20, 45),
		Size = UDim2.fromOffset(176, 52),
		Font = Theme.Font,
		PlaceholderText = "Announcement…",
		Text = "",
		TextColor3 = C.Text,
		TextScaled = true,
		ClearTextOnFocus = false,
		Parent = list,
	}, { UIKit.corner(0.25), UIKit.stroke(2) })
	UIKit.button({ Text = "📢 Announce", Color = C.Gold, MaxTextSize = 18, Parent = list, OnClick = function()
		report(Net.call("admin", { cmd = "announce", text = box.Text }))
		box.Text = ""
	end })
end

function Misc.init()
	buildCodes()
	buildSettings()
	buildOffline()
	buildStarter()
	buildAdmin()
end

return Misc
]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX31750AB3E4F7460D83652D6C7DD0841E">
            <Properties>
              <string name="Name">Progress</string>
              <ProtectedString name="Source"><![CDATA[-- Rebirth panel and the Odds panel (every chance shown as a percentage,
-- including the effect of active luck boosts).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))
local Format = require(Shared:WaitForChild("Format"))
local Mutations = require(Shared:WaitForChild("Mutations"))
local Rarities = require(Shared:WaitForChild("Rarities"))
local Client = script.Parent.Parent
local Net = require(Client:WaitForChild("Net"))
local Notify = require(Client:WaitForChild("Notify"))
local State = require(Client:WaitForChild("State"))
local Theme = require(Client:WaitForChild("Theme"))
local UIKit = require(Client:WaitForChild("UIKit"))

local C = Theme.Colors
local New = UIKit.New
local Progress = {}

local function buildRebirth()
	local panel = UIKit.panel("Rebirth", "⭐ REBIRTH", Vector2.new(640, 470))
	local c = panel.content
	local title = UIKit.label({ Text = "", Size = UDim2.new(1, 0, 0, 40), MaxTextSize = 34, Parent = c })
	local cost = UIKit.label({ Text = "", Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 44),
		TextColor3 = C.Gold, MaxTextSize = 26, Parent = c })
	local bar = UIKit.progress(c, UDim2.new(1, -40, 0, 30), C.Gold)
	bar.frame.Position = UDim2.fromOffset(20, 84)
	local perks = New("Frame", {
		BackgroundColor3 = C.Card,
		Position = UDim2.fromOffset(20, 128),
		Size = UDim2.new(1, -40, 0, 150),
		Parent = c,
	}, { UIKit.corner(0.1), UIKit.stroke(3), UIKit.padding(10), UIKit.list(Enum.FillDirection.Vertical, 6) })
	local perkLabels = {}
	for i = 1, 4 do
		perkLabels[i] = UIKit.label({ Text = "", Size = UDim2.new(1, 0, 0, 28), TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 22, LayoutOrder = i, Parent = perks })
	end
	local confirming = false
	local button, buttonLabel = UIKit.button({
		Text = "REBIRTH",
		Color = C.Gray,
		Size = UDim2.fromOffset(260, 60),
		Position = UDim2.new(0.5, 0, 1, -40),
		AnchorPoint = Vector2.new(0.5, 0.5),
		MaxTextSize = 32,
		Parent = c,
		OnClick = function()
			local rebirths = State.get("rebirths") or 0
			if (State.get("cash") or 0) < Economy.rebirthCost(rebirths) then
				Notify.show("Not enough cash yet!", "warning")
				return
			end
			if not confirming then
				confirming = true
				return
			end
			confirming = false
			local result = Net.call("rebirth")
			if not result.ok and result.msg then
				Notify.show(result.msg, "warning")
			end
		end,
	})

	local function refresh()
		local rebirths = State.get("rebirths") or 0
		local cash = State.get("cash") or 0
		local need = Economy.rebirthCost(rebirths)
		title.Text = "Rebirth " .. rebirths .. "  →  " .. rebirths + 1
		cost.Text = "Cost: " .. Format.cash(need)
		bar.set(cash / need, Format.cash(cash) .. " / " .. Format.cash(need))
		local padsNow = math.min(rebirths * Config.Tuning.PadsPerRebirth, Config.Tuning.MaxRebirthPads)
		local padsNext = math.min((rebirths + 1) * Config.Tuning.PadsPerRebirth, Config.Tuning.MaxRebirthPads)
		perkLabels[1].Text = "💰 Cash multiplier: " .. Format.mult(Economy.rebirthMult(rebirths)) .. " → "
			.. Format.mult(Economy.rebirthMult(rebirths + 1))
		perkLabels[2].Text = if padsNext > padsNow then "🧱 +" .. (padsNext - padsNow) .. " slime pads" else "🧱 Max rebirth pads reached"
		perkLabels[3].Text = "🟢 Your slimes STAY in your base!"
		perkLabels[4].Text = "⚠️ Your cash resets to " .. Format.cash(Config.Tuning.StartingCash)
		local affordable = cash >= need
		button.BackgroundColor3 = if affordable then (if confirming then C.Red else C.Green) else C.Gray
		buttonLabel.Text = if confirming then "TAP AGAIN TO CONFIRM" else "REBIRTH"
	end
	panel.onOpen = function()
		confirming = false
		refresh()
	end
	State.on("cash", function()
		if UIKit.isOpen("Rebirth") then
			refresh()
		end
	end)
	State.on("rebirths", function()
		if UIKit.isOpen("Rebirth") then
			refresh()
		end
	end)
end

local function buildOdds()
	local panel = UIKit.panel("Odds", "🎲 SPAWN ODDS", Vector2.new(720, 520))
	local list = UIKit.scroll({ Size = UDim2.fromScale(1, 1), Parent = panel.content })
	local serverState = ReplicatedStorage:WaitForChild("ServerState")

	local function row(order: number, cells: { string }, color: Color3?, header: boolean?)
		local frame = New("Frame", {
			BackgroundColor3 = if header then C.PanelLight else C.Card,
			Size = UDim2.new(1, -12, 0, 34),
			LayoutOrder = order,
			Parent = list,
		}, { UIKit.corner(0.25), UIKit.list(Enum.FillDirection.Horizontal, 0) })
		for i, text in cells do
			UIKit.label({
				Text = text,
				Size = UDim2.new(1 / #cells, 0, 1, -6),
				TextColor3 = if i == 1 and color then color else C.Text,
				MaxTextSize = 20,
				LayoutOrder = i,
				Parent = frame,
			})
		end
	end

	local function render()
		UIKit.clear(list)
		UIKit.list(Enum.FillDirection.Vertical, 4).Parent = list
		local luck = serverState:GetAttribute("LuckMult") or 1
		local mutMult = serverState:GetAttribute("MutationMult") or 1
		local base = Economy.rarityOdds(1)
		local now = Economy.rarityOdds(luck)
		UIKit.label({ Text = "Server luck now: " .. Format.mult(luck) .. "   ·   Mutation chance: " .. Format.mult(mutMult),
			Size = UDim2.new(1, -12, 0, 30), TextColor3 = C.Gold, MaxTextSize = 22, LayoutOrder = 0, Parent = list })
		row(1, { "Rarity", "Base chance", "Chance now" }, nil, true)
		for _, def in Rarities.List do
			row(1 + def.rank, { def.key, Format.percent(base[def.key]), Format.percent(now[def.key]) }, def.color)
		end
		row(20, { "Mutation", "Cash bonus", "Chance now" }, nil, true)
		local mutOdds = Economy.mutationOdds(mutMult)
		for _, mut in Mutations.List do
			row(20 + mut.rank, { if mut.key == "None" then "No mutation" else mut.key, Format.mult(mut.mult),
				Format.percent(mutOdds[mut.key]) }, mut.color)
		end
		local notes = {
			"• Which slime spawns within a rarity: cheaper ones are more common.",
			"• Guarantee: an Epic or better slime spawns at least every " .. Config.Tuning.GuaranteeEpicSeconds .. " seconds.",
			"• 🍀 Server Luck (Robux or events) changes the 'Chance now' column for everyone.",
			"• ✨ Golden Hour / Golden boosts multiply mutation chances.",
			"• You always SEE the slime before buying it — nothing for sale is random.",
		}
		for i, text in notes do
			UIKit.label({ Text = text, Size = UDim2.new(1, -12, 0, 26), TextXAlignment = Enum.TextXAlignment.Left,
				TextColor3 = C.SubText, Font = Theme.FontBody, MaxTextSize = 17, StrokeThickness = 0, LayoutOrder = 40 + i,
				Parent = list })
		end
	end
	panel.onOpen = render
	for _, attr in { "LuckMult", "MutationMult" } do
		serverState:GetAttributeChangedSignal(attr):Connect(function()
			if UIKit.isOpen("Odds") then
				render()
			end
		end)
	end
end

function Progress.init()
	buildRebirth()
	buildOdds()
end

return Progress
]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBXFDF10A61104D4F978912E3E4900A0F85">
            <Properties>
              <string name="Name">Rewards</string>
              <ProtectedString name="Source"><![CDATA[-- Rewards: 7-day login streak, session playtime gifts and daily quests.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared:WaitForChild("Format"))
local RewardDefs = require(Shared:WaitForChild("RewardDefs"))
local Client = script.Parent.Parent
local Net = require(Client:WaitForChild("Net"))
local Notify = require(Client:WaitForChild("Notify"))
local State = require(Client:WaitForChild("State"))
local Theme = require(Client:WaitForChild("Theme"))
local UIKit = require(Client:WaitForChild("UIKit"))

local C = Theme.Colors
local New = UIKit.New
local Rewards = {}

local function call(action: string, payload: any?)
	local result = Net.call(action, payload)
	if not result.ok and result.msg then
		Notify.show(result.msg, "warning")
	end
end

function Rewards.init()
	local panel = UIKit.panel("Rewards", "🎁 REWARDS", Vector2.new(780, 500))
	local tab = "📅 Daily"
	local body = New("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 58),
		Size = UDim2.new(1, 0, 1, -58),
		Parent = panel.content,
	})
	local giftTimers = {}

	local function renderDaily()
		UIKit.clear(body)
		local daily = State.get("daily") or { streak = 0, canClaim = false, nextDay = 1, resetIn = 0 }
		UIKit.label({
			Text = "🔥 Streak: " .. daily.streak .. " day" .. (if daily.streak == 1 then "" else "s")
				.. "   ·   Come back every day for bigger rewards!",
			Size = UDim2.new(1, 0, 0, 30),
			MaxTextSize = 22,
			Parent = body,
		})
		local row = New("Frame", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(0, 40),
			Size = UDim2.new(1, 0, 0, 230),
			Parent = body,
		}, { UIKit.list(Enum.FillDirection.Horizontal, 8) })
		for day, reward in RewardDefs.Daily do
			local isNext = day == daily.nextDay
			local done = day < daily.nextDay or (isNext and not daily.canClaim)
			local frame = New("Frame", {
				BackgroundColor3 = if isNext and daily.canClaim then C.Pink elseif done then C.PanelLight else C.Card,
				Size = UDim2.fromOffset(98, 220),
				LayoutOrder = day,
				Parent = row,
			}, { UIKit.corner(0.12), UIKit.stroke(3, if isNext then C.Gold else C.Stroke) })
			UIKit.label({ Text = "Day " .. day, Size = UDim2.new(1, -8, 0, 30), Position = UDim2.fromOffset(4, 8),
				MaxTextSize = 24, Parent = frame })
			UIKit.label({
				Text = if day == 7 then "🏆" elseif reward.slimeMinRarity then "🟢" elseif reward.boostMinutes then "🧪" else "💰",
				Size = UDim2.new(1, 0, 0, 50),
				Position = UDim2.fromOffset(0, 42),
				StrokeThickness = 0,
				Parent = frame,
			})
			UIKit.label({
				Text = RewardDefs.describe(reward),
				Size = UDim2.new(1, -10, 0, 70),
				Position = UDim2.fromOffset(5, 96),
				TextWrapped = true,
				Font = Theme.FontBody,
				TextColor3 = C.SubText,
				MaxTextSize = 15,
				StrokeThickness = 0,
				Parent = frame,
			})
			if done then
				UIKit.label({ Text = "✓", Size = UDim2.new(1, 0, 0, 36), Position = UDim2.new(0, 0, 1, -44),
					TextColor3 = C.Green, Parent = frame })
			elseif isNext then
				UIKit.button({
					Text = "CLAIM",
					Color = C.Green,
					Size = UDim2.new(1, -12, 0, 40),
					Position = UDim2.new(0, 6, 1, -48),
					MaxTextSize = 20,
					Parent = frame,
					OnClick = function()
						call("claimDaily")
					end,
				})
			end
		end
		if not daily.canClaim then
			UIKit.label({
				Text = "Next reward in " .. Format.time(daily.resetIn),
				Size = UDim2.new(1, 0, 0, 30),
				Position = UDim2.fromOffset(0, 285),
				TextColor3 = C.SubText,
				MaxTextSize = 22,
				Parent = body,
			})
		end
	end

	local function renderGifts()
		UIKit.clear(body)
		table.clear(giftTimers)
		local gifts = State.get("gifts")
		if not gifts then
			return
		end
		local claimed = {}
		for _, i in gifts.claimed do
			claimed[i] = true
		end
		local grid = New("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Parent = body,
		}, { UIKit.grid(Vector2.new(170, 180), 12) })
		for i, gift in RewardDefs.Gifts do
			local frame = New("Frame", {
				BackgroundColor3 = C.Card,
				LayoutOrder = i,
				Parent = grid,
			}, { UIKit.corner(0.12), UIKit.stroke(3) })
			UIKit.label({ Text = "🎁", Size = UDim2.new(1, 0, 0, 46), Position = UDim2.fromOffset(0, 6), StrokeThickness = 0,
				Parent = frame })
			UIKit.label({
				Text = RewardDefs.describe(gift.reward),
				Size = UDim2.new(1, -12, 0, 50),
				Position = UDim2.fromOffset(6, 54),
				TextWrapped = true,
				Font = Theme.FontBody,
				TextColor3 = C.SubText,
				MaxTextSize = 15,
				StrokeThickness = 0,
				Parent = frame,
			})
			if claimed[i] then
				UIKit.label({ Text = "✓ Claimed", Size = UDim2.new(1, 0, 0, 34), Position = UDim2.new(0, 0, 1, -44),
					TextColor3 = C.Green, MaxTextSize = 22, Parent = frame })
			else
				local button, label = UIKit.button({
					Text = "",
					Color = C.Gray,
					Size = UDim2.new(1, -16, 0, 40),
					Position = UDim2.new(0, 8, 1, -48),
					MaxTextSize = 20,
					Parent = frame,
					OnClick = function()
						call("claimGift", i)
					end,
				})
				table.insert(giftTimers, { button = button, label = label, at = gift.at * 60 })
			end
		end
	end

	local function renderQuests()
		UIKit.clear(body)
		UIKit.list(Enum.FillDirection.Vertical, 12).Parent = body
		UIKit.label({ Text = "New quests every day (UTC midnight)", Size = UDim2.new(1, 0, 0, 28), TextColor3 = C.SubText,
			MaxTextSize = 20, LayoutOrder = 0, Parent = body })
		for i, quest in State.get("quests") or {} do
			local row = New("Frame", {
				BackgroundColor3 = C.Card,
				Size = UDim2.new(1, 0, 0, 96),
				LayoutOrder = i,
				Parent = body,
			}, { UIKit.corner(0.15), UIKit.stroke(3) })
			UIKit.label({ Text = "📜 " .. quest.text, Size = UDim2.new(0.62, 0, 0, 34), Position = UDim2.fromOffset(14, 8),
				TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 24, Parent = row })
			UIKit.label({ Text = "Reward: " .. RewardDefs.describe(quest.reward), Size = UDim2.new(0.62, 0, 0, 22),
				Position = UDim2.fromOffset(14, 42), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.SubText,
				Font = Theme.FontBody, MaxTextSize = 16, StrokeThickness = 0, Parent = row })
			local bar = UIKit.progress(row, UDim2.new(0.62, 0, 0, 20), C.Green)
			bar.frame.Position = UDim2.fromOffset(14, 68)
			local shown = if quest.kind == "collect" then Format.cash(quest.progress) .. " / " .. Format.cash(quest.target)
				else quest.progress .. " / " .. quest.target
			bar.set(quest.progress / math.max(quest.target, 1), shown)
			UIKit.button({
				Text = if quest.claimed then "✓ Done" elseif quest.done then "CLAIM" else "In progress",
				Color = if quest.claimed then C.Gray elseif quest.done then C.Green else C.PanelLight,
				Size = UDim2.new(0.3, -20, 0, 50),
				Position = UDim2.new(0.7, 0, 0.5, 0),
				AnchorPoint = Vector2.new(0, 0.5),
				MaxTextSize = 22,
				Parent = row,
				OnClick = if quest.done and not quest.claimed then function()
					call("claimQuest", i)
				end else nil,
			})
		end
	end

	local renderers = { ["📅 Daily"] = renderDaily, ["🎁 Gifts"] = renderGifts, ["📜 Quests"] = renderQuests }
	local select = UIKit.tabs(panel.content, { "📅 Daily", "🎁 Gifts", "📜 Quests" }, function(name)
		tab = name
		renderers[name]()
	end)
	panel.onOpen = function()
		renderers[tab]()
	end
	for key, name in { daily = "📅 Daily", gifts = "🎁 Gifts", quests = "📜 Quests" } do
		State.on(key, function()
			if UIKit.isOpen("Rewards") and tab == name then
				renderers[tab]()
			end
		end)
	end
	task.spawn(function()
		while true do
			task.wait(0.5)
			local gifts = State.get("gifts")
			if gifts and UIKit.isOpen("Rewards") and tab == "🎁 Gifts" then
				local elapsed = workspace:GetServerTimeNow() - gifts.startedAt
				for _, timer in giftTimers do
					local left = timer.at - elapsed
					if left <= 0 then
						timer.label.Text = "CLAIM!"
						timer.button.BackgroundColor3 = C.Green
					else
						timer.label.Text = "⏳ " .. Format.time(left)
					end
				end
			end
		end
	end)
	select("📅 Daily")
end

return Rewards
]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX35B31F00207349F381FFF296A16911FB">
            <Properties>
              <string name="Name">Shop</string>
              <ProtectedString name="Source"><![CDATA[-- Shop: passes, scaled cash packs (exact amount shown before buying), boosts
-- and gifting. Prices come from Roblox so they always match the purchase prompt.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))
local Format = require(Shared:WaitForChild("Format"))
local Client = script.Parent.Parent
local Net = require(Client:WaitForChild("Net"))
local Notify = require(Client:WaitForChild("Notify"))
local State = require(Client:WaitForChild("State"))
local Theme = require(Client:WaitForChild("Theme"))
local UIKit = require(Client:WaitForChild("UIKit"))

local C = Theme.Colors
local New = UIKit.New
local Shop = {}

local BOOST_TEXT = {
	ServerLuck = "🍀 2x luck for EVERYONE in the server for 15 min. Exact odds in 🎲 Odds.",
	ServerRain = "🌧️ Slimes spawn 2x faster for everyone for 10 min.",
	CashBoost = "🧪 2x cash for you for 30 min. Time stacks!",
	Shield = "🛡️ Nobody can steal from your base for 10 min.",
}

local function call(action: string, payload: any?)
	local result = Net.call(action, payload)
	if not result.ok and result.msg then
		Notify.show(result.msg, "warning")
	end
	return result
end

local function card(parent: Instance, order: number, icon: string, title: string, desc: string, buttonText: string,
	color: Color3, onClick: (() -> ())?)
	local frame = New("Frame", {
		Name = title,
		BackgroundColor3 = C.Card,
		LayoutOrder = order,
		Parent = parent,
	}, { UIKit.corner(0.1), UIKit.stroke(3) })
	UIKit.label({ Text = icon, Size = UDim2.new(1, 0, 0, 48), Position = UDim2.fromOffset(0, 8), StrokeThickness = 0,
		Parent = frame })
	UIKit.label({ Text = title, Size = UDim2.new(1, -16, 0, 28), Position = UDim2.fromOffset(8, 58), MaxTextSize = 24,
		Parent = frame })
	local descLabel = UIKit.label({
		Text = desc,
		Size = UDim2.new(1, -16, 0, 52),
		Position = UDim2.fromOffset(8, 88),
		TextColor3 = C.SubText,
		Font = Theme.FontBody,
		TextWrapped = true,
		MaxTextSize = 16,
		StrokeThickness = 0,
		Parent = frame,
	})
	UIKit.button({
		Text = buttonText,
		Color = color,
		Size = UDim2.new(1, -20, 0, 42),
		Position = UDim2.new(0, 10, 1, -50),
		MaxTextSize = 22,
		Parent = frame,
		OnClick = onClick,
	})
	return frame, descLabel
end

local function sortByOrder(list)
	local copy = table.clone(list)
	table.sort(copy, function(a, b)
		return (a.order or 99) < (b.order or 99)
	end)
	return copy
end

function Shop.init()
	local panel = UIKit.panel("Shop", "🛒 SHOP", Vector2.new(780, 520))
	local tab = "⭐ Passes"
	local giftTarget: number? = nil
	local cashLabels = {}

	local body = UIKit.scroll({
		Name = "Items",
		Position = UDim2.fromOffset(0, 56),
		Size = UDim2.new(1, 0, 1, -56),
		Parent = panel.content,
	})

	local function grid()
		UIKit.clear(body)
		local layout = UIKit.grid(Vector2.new(230, 204), 12)
		layout.Parent = body
		New("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 8), Parent = body })
	end

	local function renderPasses()
		grid()
		for i, pass in sortByOrder(State.get("passes") or {}) do
			local owned = State.has(pass.key)
			card(body, i, pass.icon, pass.name, pass.desc, if owned then "✓ OWNED" else "R$ " .. pass.price,
				if owned then C.Gray else C.Robux, if owned then nil else function()
					call("buyPass", pass.key)
				end)
		end
		if not State.get("isPremium") then
			card(body, 50, "⭐", "Roblox Plus", "Members get +" .. math.floor(Config.PremiumBonus * 100) .. "% cash in this game!",
				"Get Plus", C.Blue, function()
					call("premium")
				end)
		end
		if State.get("clubConfigured") and not State.get("isClub") then
			card(body, 51, "💎", Config.SubscriptionName, "+" .. math.floor(Config.SubscriptionBonus * 100)
				.. "% cash, [Club] tag, 8h offline cash. Monthly, cancel anytime.", "Subscribe", C.Purple, function()
				call("subscribe")
			end)
		end
	end

	local function refreshCash()
		local base = State.get("baseIncome") or 0
		for _, entry in cashLabels do
			entry.label.Text = "+" .. Format.cash(Economy.scaledCash(base, entry.minutes, entry.min))
				.. "\n(" .. entry.minutes .. " min of your income)"
		end
	end

	local function renderCash()
		grid()
		table.clear(cashLabels)
		for i, product in sortByOrder(State.get("products") or {}) do
			if product.minutes and product.min then
				local _, label = card(body, i, product.icon, product.name, "", "R$ " .. product.price, C.Robux, function()
					call("buyProduct", product.key)
				end)
				table.insert(cashLabels, { label = label, minutes = product.minutes, min = product.min })
			end
		end
		refreshCash()
	end

	local function renderBoosts()
		grid()
		local order = 0
		for _, product in sortByOrder(State.get("products") or {}) do
			if BOOST_TEXT[product.key] then
				order += 1
				card(body, order, product.icon, product.name, BOOST_TEXT[product.key], "R$ " .. product.price, C.Robux,
					function()
						call("buyProduct", product.key)
					end)
			end
		end
		if State.get("adsEnabled") then
			card(body, 90, "📺", "Free 2x Cash", "Watch a short video for " .. Config.RewardedAds.BoostMinutes
				.. " min of 2x cash.", "Watch", C.Blue, function()
				call("watchAd", "boost")
			end)
		end
	end

	local function renderGifts()
		UIKit.clear(body)
		UIKit.list(Enum.FillDirection.Vertical, 10).Parent = body
		UIKit.label({ Text = "1) Pick a player in this server:", Size = UDim2.new(1, 0, 0, 30), MaxTextSize = 22,
			LayoutOrder = 1, Parent = body })
		local row = New("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 46),
			LayoutOrder = 2,
			Parent = body,
		}, { UIKit.list(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Left) })
		local others = 0
		for _, other in Players:GetPlayers() do
			if other ~= Players.LocalPlayer then
				others += 1
				UIKit.button({
					Text = other.DisplayName,
					Color = if giftTarget == other.UserId then C.Pink else C.Card,
					Size = UDim2.fromOffset(170, 44),
					MaxTextSize = 20,
					LayoutOrder = others,
					Parent = row,
					OnClick = function()
						giftTarget = other.UserId
						renderGifts()
					end,
				})
			end
		end
		if others == 0 then
			UIKit.label({ Text = "Invite a friend to gift them! (⚙️ Settings > Invite)", Size = UDim2.fromOffset(500, 40),
				TextColor3 = C.SubText, MaxTextSize = 20, Parent = row })
		end
		UIKit.label({ Text = "2) Choose a gift:", Size = UDim2.new(1, 0, 0, 30), MaxTextSize = 22, LayoutOrder = 3,
			Parent = body })
		local cards = New("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 216),
			LayoutOrder = 4,
			Parent = body,
		}, { UIKit.grid(Vector2.new(230, 204), 12) })
		local credits = State.get("giftCredits") or {}
		for i, product in sortByOrder(State.get("products") or {}) do
			if product.gift then
				local credit = credits[product.gift] or 0
				local pass = Config.Passes[product.gift]
				card(cards, i, "🎁", pass.name, "Give " .. pass.name .. " to a friend, even if they're offline later.",
					if credit > 0 then ("Send (" .. credit .. " ready)") else "R$ " .. product.price,
					if credit > 0 then C.Pink else C.Robux, function()
						if not giftTarget then
							Notify.show("Pick a player first!", "warning")
							return
						end
						local result = call("gift", { key = product.key, target = giftTarget })
						if result.ok and result.msg then
							Notify.show(result.msg, "success")
						end
					end)
			end
		end
	end

	local renderers = {
		["⭐ Passes"] = renderPasses,
		["💵 Cash"] = renderCash,
		["⚡ Boosts"] = renderBoosts,
		["🎁 Gifts"] = renderGifts,
	}
	local function render()
		renderers[tab]()
	end
	local select = UIKit.tabs(panel.content, { "⭐ Passes", "💵 Cash", "⚡ Boosts", "🎁 Gifts" }, function(name)
		tab = name
		render()
	end)
	panel.onOpen = render
	for _, key in { "passes", "products", "owned", "gifted", "giftCredits", "isPremium", "isClub" } do
		State.on(key, function()
			if UIKit.isOpen("Shop") then
				render()
			end
		end)
	end
	State.on("baseIncome", function()
		if UIKit.isOpen("Shop") and tab == "💵 Cash" then
			refreshCash()
		end
	end)
	select("⭐ Passes")
end

return Shop
]]></ProtectedString>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="RBX8C6D23FB3F064F12B0BB0789F9B6E813">
          <Properties>
            <string name="Name">Sounds</string>
            <ProtectedString name="Source"><![CDATA[-- UI/world sounds from Config.Sounds, respecting the player's settings.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local State = require(script.Parent:WaitForChild("State"))

local Sounds = {}

local cache: { [string]: Sound } = {}
local music: Sound? = nil

local VOLUME = { Click = 0.35, Cash = 0.4, Buy = 0.5, Bonk = 0.6, Alert = 0.7, LevelUp = 0.5 }
local PITCH = { Click = 1.4, Cash = 1.8, Buy = 1.1, Bonk = 1, Alert = 0.7, LevelUp = 1.25 }

local function enabled(key: string): boolean
	local settings = State.get("settings")
	return settings == nil or settings[key] ~= false
end

function Sounds.play(name: string)
	if not enabled("sfx") then
		return
	end
	local id = Config.Sounds[name]
	if not id or id == "" then
		return
	end
	local sound = cache[name]
	if not sound then
		sound = Instance.new("Sound")
		sound.Name = name
		sound.SoundId = id
		sound.Volume = VOLUME[name] or 0.5
		sound.PlaybackSpeed = PITCH[name] or 1
		sound.Parent = SoundService
		cache[name] = sound
	end
	SoundService:PlayLocalSound(sound)
end

function Sounds.init()
	if Config.Sounds.Music ~= "" then
		music = Instance.new("Sound")
		music.Name = "Music"
		music.SoundId = Config.Sounds.Music
		music.Looped = true
		music.Volume = 0.25
		music.Parent = SoundService
	end
	State.on("settings", function(settings)
		if music then
			if settings.music ~= false then
				if not music.IsPlaying then
					music:Play()
				end
			else
				music:Stop()
			end
		end
	end)
end

return Sounds
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX7121005EC02844C1AD865DEB0CCA219D">
          <Properties>
            <string name="Name">State</string>
            <ProtectedString name="Source"><![CDATA[-- Client-side mirror of the player's state. The server pushes partial tables
-- (Sync remote); UI modules subscribe to the keys they render.
local State = {}

State.data = {}
local listeners: { [string]: { (any) -> () } } = {}

function State.get(key: string): any
	return State.data[key]
end

function State.on(key: string, fn: (any) -> ())
	listeners[key] = listeners[key] or {}
	table.insert(listeners[key], fn)
	if key ~= "*" and State.data[key] ~= nil then
		task.spawn(fn, State.data[key])
	end
end

function State.apply(partial)
	if type(partial) ~= "table" then
		return
	end
	for key, value in partial do
		State.data[key] = value
	end
	for key, value in partial do
		local list = listeners[key]
		if list then
			for _, fn in list do
				task.spawn(fn, value)
			end
		end
	end
	local any = listeners["*"]
	if any then
		for _, fn in any do
			task.spawn(fn, partial)
		end
	end
end

-- Convenience: does the player own a pass (bought or gifted)?
function State.has(passKey: string): boolean
	local owned = State.data.owned
	local gifted = State.data.gifted
	return (owned ~= nil and owned[passKey] == true) or (gifted ~= nil and gifted[passKey] == true)
end

function State.passInfo(passKey: string)
	for _, pass in State.data.passes or {} do
		if pass.key == passKey then
			return pass
		end
	end
	return nil
end

function State.productInfo(productKey: string)
	for _, product in State.data.products or {} do
		if product.key == productKey then
			return product
		end
	end
	return nil
end

return State
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBXA5D44BA9AE994031827C7790933D1FFB">
          <Properties>
            <string name="Name">Theme</string>
            <ProtectedString name="Source"><![CDATA[-- Visual language: bubbly, high-contrast, readable on small phones.
local Theme = {}

Theme.Font = Enum.Font.FredokaOne
Theme.FontBody = Enum.Font.GothamBold

Theme.Colors = {
	Panel = Color3.fromRGB(42, 34, 74),
	PanelLight = Color3.fromRGB(62, 52, 104),
	Card = Color3.fromRGB(74, 62, 122),
	Stroke = Color3.fromRGB(20, 14, 38),
	Text = Color3.fromRGB(255, 255, 255),
	SubText = Color3.fromRGB(205, 195, 240),
	Green = Color3.fromRGB(70, 220, 110),
	Blue = Color3.fromRGB(70, 160, 255),
	Pink = Color3.fromRGB(255, 95, 170),
	Gold = Color3.fromRGB(255, 200, 50),
	Red = Color3.fromRGB(255, 75, 90),
	Purple = Color3.fromRGB(165, 95, 255),
	Gray = Color3.fromRGB(120, 115, 140),
	Robux = Color3.fromRGB(0, 176, 111),
	Cash = Color3.fromRGB(120, 255, 140),
}

-- Reference resolution the UI is laid out for; UIScale adapts it to the screen.
Theme.Reference = Vector2.new(1100, 640)

return Theme
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBXEBD2AC4E48754D73AE8227D550C3D5D0">
          <Properties>
            <string name="Name">Tutorial</string>
            <ProtectedString name="Source"><![CDATA[-- First-time guide: a hint bar plus a glowing guide line from the player to
-- the next thing to do (buy -> collect -> lock -> steal). The server advances
-- the step when the player actually does it.
local Players = game:GetService("Players")

local Net = require(script.Parent:WaitForChild("Net"))
local State = require(script.Parent:WaitForChild("State"))
local Theme = require(script.Parent:WaitForChild("Theme"))
local UIKit = require(script.Parent:WaitForChild("UIKit"))

local C = Theme.Colors
local New = UIKit.New
local player = Players.LocalPlayer
local Tutorial = {}

local STEPS = {
	[0] = { text = "👉 Walk to the conveyor and BUY a slime (press E or tap)!", target = "belt" },
	[1] = { text = "💰 Step on the GREEN plate next to your slime to collect cash!", target = "collect" },
	[2] = { text = "🔒 Step on the RED button at your base entrance to lock it!", target = "lock" },
	[3] = { text = "🔒 Step on the RED button at your base entrance to lock it!", target = "lock" },
	[4] = { text = "😈 Sneak into other bases and HOLD E on a slime to steal it. 🔨 Bonk thieves!", autoFinish = 25 },
}
local DONE = 5

local function myPlot(): Instance?
	local plots = workspace:FindFirstChild("Plots")
	if not plots then
		return nil
	end
	for _, plot in plots:GetChildren() do
		if plot:GetAttribute("OwnerId") == player.UserId then
			return plot
		end
	end
	return nil
end

local function findTarget(kind: string?, from: Vector3): BasePart?
	if kind == "belt" then
		local folder = workspace:FindFirstChild("BeltSlimes")
		local best, bestDist = nil, math.huge
		for _, model in if folder then folder:GetChildren() else {} do
			local body = model:IsA("Model") and model.PrimaryPart
			if body then
				local d = (body.Position - from).Magnitude
				if d < bestDist then
					best, bestDist = body, d
				end
			end
		end
		return best
	end
	local plot = myPlot()
	if not plot then
		return nil
	end
	if kind == "lock" then
		local button = plot:FindFirstChild("LockButton")
		return if button and button:IsA("BasePart") then button else nil
	end
	if kind == "collect" then
		local pads = plot:FindFirstChild("Pads")
		for i = 1, 40 do
			local pad = pads and pads:FindFirstChild("Pad" .. i)
			local collect = pad and pad:FindFirstChild("Collect")
			if collect and collect:IsA("BasePart") and collect.Transparency < 1 then
				return collect
			end
		end
	end
	return nil
end

function Tutorial.init(gui: ScreenGui)
	local hint = New("Frame", {
		Name = "Hint",
		AnchorPoint = Vector2.new(0.5, 1),
		-- above the bottom HUD group at every UI scale
		Position = UDim2.new(0.5, 0, 0.72, 0),
		Size = UDim2.fromOffset(640, 52),
		BackgroundColor3 = C.Panel,
		Visible = false,
		Parent = gui,
	}, { UIKit.corner(0.4), UIKit.stroke(4, C.Gold) })
	UIKit.scaled(hint)
	local label = UIKit.label({ Text = "", Size = UDim2.new(1, -24, 0.8, 0), Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5), MaxTextSize = 24, Parent = hint })

	local anchor = New("Part", {
		Name = "TutorialTarget",
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Transparency = 1,
		Size = Vector3.new(0.2, 0.2, 0.2),
		Parent = workspace,
	})
	local targetAttachment = New("Attachment", { Parent = anchor })
	local beam = New("Beam", {
		Attachment1 = targetAttachment,
		Color = ColorSequence.new(Color3.fromRGB(255, 230, 90)),
		Width0 = 0.6,
		Width1 = 0.6,
		FaceCamera = true,
		LightEmission = 1,
		Segments = 12,
		CurveSize0 = 4,
		Enabled = false,
		Parent = anchor,
	})
	local autoStarted = false

	task.spawn(function()
		while true do
			task.wait(0.4)
			local step = State.get("tutorial") or 0
			local def = STEPS[step]
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if step >= DONE or not def or not root or not root:IsA("BasePart") then
				hint.Visible = false
				beam.Enabled = false
				continue
			end
			hint.Visible = true
			label.Text = def.text
			local target = findTarget(def.target, root.Position)
			if target then
				local attach = root:FindFirstChild("TutorialSource")
				if not attach then
					attach = New("Attachment", { Name = "TutorialSource", Parent = root })
				end
				beam.Attachment0 = attach :: Attachment
				anchor.Position = target.Position + Vector3.new(0, 1, 0)
				beam.Enabled = true
			else
				beam.Enabled = false
			end
			if def.autoFinish and not autoStarted then
				autoStarted = true
				task.delay(def.autoFinish, function()
					Net.call("tutorial", DONE)
					State.apply({ tutorial = DONE })
				end)
			end
		end
	end)
end

return Tutorial
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX8AD928153BC047CD89F6E4F1C1925B70">
          <Properties>
            <string name="Name">UIKit</string>
            <ProtectedString name="Source"><![CDATA[-- Small UI toolkit: styled labels/buttons, modal panels with one-at-a-time
-- behaviour, responsive scaling, tabs, progress bars and 2D slime icons.
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Mutations = require(Shared:WaitForChild("Mutations"))
local New = require(Shared:WaitForChild("New"))
local Rarities = require(Shared:WaitForChild("Rarities"))
local Slimes = require(Shared:WaitForChild("Slimes"))
local Sounds = require(script.Parent:WaitForChild("Sounds"))
local Theme = require(script.Parent:WaitForChild("Theme"))

local C = Theme.Colors
local UIKit = {}
UIKit.New = New

local screen: ScreenGui? = nil
local panels = {}
local current: string? = nil
local scalers: { UIScale } = {}
local blur: BlurEffect? = nil

function UIKit.tween(inst: Instance, seconds: number, goal, style: Enum.EasingStyle?, direction: Enum.EasingDirection?)
	local t = TweenService:Create(inst, TweenInfo.new(seconds, style or Enum.EasingStyle.Quad,
		direction or Enum.EasingDirection.Out), goal)
	t:Play()
	return t
end

function UIKit.corner(radius: number?)
	return New("UICorner", { CornerRadius = UDim.new(radius or 0.18, 0) })
end

function UIKit.stroke(thickness: number?, color: Color3?, transparency: number?)
	return New("UIStroke", {
		Thickness = thickness or 3,
		Color = color or C.Stroke,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UIKit.padding(px: number)
	local u = UDim.new(0, px)
	return New("UIPadding", { PaddingTop = u, PaddingBottom = u, PaddingLeft = u, PaddingRight = u })
end

function UIKit.list(direction: Enum.FillDirection?, padding: number?, hAlign: Enum.HorizontalAlignment?,
	vAlign: Enum.VerticalAlignment?)
	return New("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, padding or 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Center,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
	})
end

function UIKit.grid(cell: Vector2, pad: number?)
	return New("UIGridLayout", {
		CellSize = UDim2.fromOffset(cell.X, cell.Y),
		CellPadding = UDim2.fromOffset(pad or 10, pad or 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
	})
end

function UIKit.gradient(top: Color3, bottom: Color3, rotation: number?)
	return New("UIGradient", { Color = ColorSequence.new(top, bottom), Rotation = rotation or 90 })
end

-- props are TextLabel properties plus MaxTextSize / StrokeThickness (0 = none).
function UIKit.label(props)
	local maxSize = props.MaxTextSize
	local strokeThickness = props.StrokeThickness
	props.MaxTextSize = nil
	props.StrokeThickness = nil
	if props.BackgroundTransparency == nil then
		props.BackgroundTransparency = 1
	end
	props.Font = props.Font or Theme.Font
	props.TextColor3 = props.TextColor3 or C.Text
	if props.TextScaled == nil then
		props.TextScaled = true
	end
	local label = New("TextLabel", props)
	if maxSize then
		New("UITextSizeConstraint", { MaxTextSize = maxSize, Parent = label })
	end
	if strokeThickness ~= 0 then
		New("UIStroke", {
			Thickness = strokeThickness or 2,
			Color = C.Stroke,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
			Parent = label,
		})
	end
	return label
end

-- props: Text, Color, Size, Position, AnchorPoint, LayoutOrder, Parent, OnClick,
--        TextColor, MaxTextSize, Name, Radius
function UIKit.button(props)
	local button = New("TextButton", {
		Name = props.Name or "Button",
		AutoButtonColor = false,
		BackgroundColor3 = props.Color or C.Green,
		Size = props.Size or UDim2.fromOffset(160, 50),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
		Text = "",
	})
	UIKit.corner(props.Radius or 0.28).Parent = button
	UIKit.stroke(3).Parent = button
	UIKit.gradient(Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 200)).Parent = button
	local label = UIKit.label({
		Name = "Label",
		Text = props.Text or "",
		Size = UDim2.fromScale(0.92, 0.78),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		TextColor3 = props.TextColor or C.Text,
		MaxTextSize = props.MaxTextSize or 26,
		Parent = button,
	})
	local scale = New("UIScale", { Parent = button })
	button.MouseButton1Down:Connect(function()
		UIKit.tween(scale, 0.07, { Scale = 0.92 })
	end)
	local function release()
		UIKit.tween(scale, 0.12, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	button.MouseButton1Up:Connect(release)
	button.MouseLeave:Connect(release)
	button.Activated:Connect(function()
		Sounds.play("Click")
		if props.OnClick then
			props.OnClick()
		end
	end)
	button.Parent = props.Parent
	return button, label
end

function UIKit.scroll(props)
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.BorderSizePixel = 0
	props.ScrollBarThickness = props.ScrollBarThickness or 8
	props.ScrollBarImageColor3 = props.ScrollBarImageColor3 or C.SubText
	props.AutomaticCanvasSize = Enum.AutomaticSize.Y
	props.CanvasSize = UDim2.new()
	props.ScrollingDirection = Enum.ScrollingDirection.Y
	return New("ScrollingFrame", props)
end

function UIKit.progress(parent: Instance, size: UDim2, color: Color3?)
	local bar = New("Frame", {
		Name = "Progress",
		BackgroundColor3 = Color3.fromRGB(25, 20, 45),
		Size = size,
		Parent = parent,
	}, { UIKit.corner(0.5), UIKit.stroke(2) })
	local fill = New("Frame", {
		Name = "Fill",
		BackgroundColor3 = color or C.Green,
		Size = UDim2.fromScale(0, 1),
		Parent = bar,
	}, { UIKit.corner(0.5), UIKit.gradient(Color3.new(1, 1, 1), Color3.fromRGB(180, 180, 180)) })
	local text = UIKit.label({
		Size = UDim2.fromScale(1, 0.85),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = "",
		MaxTextSize = 20,
		ZIndex = 3,
		Parent = bar,
	})
	return {
		frame = bar,
		set = function(fraction: number, caption: string?)
			fill.Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1)
			text.Text = caption or ""
		end,
	}
end

-- Tabs row; returns select(name). onSelect(name) is called on change.
function UIKit.tabs(parent: Instance, names: { string }, onSelect: (string) -> ())
	local row = New("Frame", {
		Name = "Tabs",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 46),
		Parent = parent,
	}, { UIKit.list(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Left) })
	local buttons = {}
	local function select(name: string)
		for n, b in buttons do
			b.BackgroundColor3 = if n == name then C.Pink else C.Card
		end
		onSelect(name)
	end
	for i, name in names do
		local button = UIKit.button({
			Text = name,
			Color = C.Card,
			Size = UDim2.new(1 / #names, -8, 1, 0),
			LayoutOrder = i,
			MaxTextSize = 22,
			Parent = row,
			OnClick = function()
				select(name)
			end,
		})
		buttons[name] = button
	end
	return select, row
end

-- 2D slime icon: a blob with eyes, coloured by slime/mutation.
function UIKit.slimeIcon(slimeId: string, mutKey: string?, size: UDim2, discovered: boolean?)
	local def = Slimes.ById[slimeId]
	local known = discovered ~= false
	local mut = Mutations.ByKey[mutKey or "None"]
	local color = if not known then Color3.fromRGB(70, 65, 90)
		elseif mut and mut.key ~= "None" and mut.key ~= "Rainbow" then mut.color
		else def.body
	local icon = New("Frame", {
		Name = "SlimeIcon",
		BackgroundColor3 = color,
		Size = size,
	}, {
		New("UICorner", { CornerRadius = UDim.new(0.5, 0) }),
		New("UIAspectRatioConstraint", { AspectRatio = 1.2 }),
		UIKit.stroke(2, Rarities.ByKey[def.rarity].color),
	})
	if known then
		if mut and mut.key == "Rainbow" then
			New("UIGradient", {
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 90, 90)),
					ColorSequenceKeypoint.new(0.5, Color3.fromRGB(110, 255, 140)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(110, 140, 255)),
				}),
				Rotation = 30,
				Parent = icon,
			})
		end
		for _, x in { 0.3, 0.62 } do
			local eye = New("Frame", {
				BackgroundColor3 = Color3.new(1, 1, 1),
				Size = UDim2.fromScale(0.22, 0.27),
				Position = UDim2.fromScale(x, 0.3),
				Parent = icon,
			}, { New("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
			New("Frame", {
				BackgroundColor3 = Color3.fromRGB(25, 20, 30),
				Size = UDim2.fromScale(0.55, 0.55),
				Position = UDim2.fromScale(0.3, 0.32),
				Parent = eye,
			}, { New("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
		end
	else
		UIKit.label({ Text = "?", Size = UDim2.fromScale(0.6, 0.7), Position = UDim2.fromScale(0.2, 0.15), Parent = icon })
	end
	return icon
end

---------------------------------------------------------------------------
-- Responsive scale + panels
---------------------------------------------------------------------------
function UIKit.screenScale(): number
	local camera = workspace.CurrentCamera
	local viewport = if camera then camera.ViewportSize else Theme.Reference
	return math.clamp(math.min(viewport.X / Theme.Reference.X, viewport.Y / Theme.Reference.Y), 0.5, 1.3)
end

-- Gives a top-level container its own UIScale that follows the screen size.
function UIKit.scaled(frame: GuiObject)
	local scale = New("UIScale", { Name = "ScreenScale", Scale = UIKit.screenScale(), Parent = frame })
	table.insert(scalers, scale)
	return scale
end

function UIKit.init(gui: ScreenGui)
	screen = gui
	local function refresh()
		local s = UIKit.screenScale()
		for _, scale in scalers do
			scale.Scale = s
		end
	end
	local function hookCamera()
		local camera = workspace.CurrentCamera
		if camera then
			camera:GetPropertyChangedSignal("ViewportSize"):Connect(refresh)
		end
		refresh()
	end
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(hookCamera)
	hookCamera()
	blur = New("BlurEffect", { Name = "PanelBlur", Size = 0, Parent = Lighting })
end

function UIKit.panel(name: string, title: string, size: Vector2)
	assert(screen, "UIKit.init first")
	local holder = New("Frame", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(size.X, size.Y),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 20,
		Parent = screen,
	})
	UIKit.scaled(holder)
	local frame = New("Frame", {
		Name = "Body",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Panel,
		Parent = holder,
	}, {
		UIKit.corner(0.05),
		UIKit.stroke(5),
		UIKit.gradient(Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 190, 230)),
	})
	local pop = New("UIScale", { Name = "Pop", Parent = frame })
	local titleLabel = UIKit.label({
		Name = "Title",
		Text = title,
		Size = UDim2.new(1, -140, 0, 50),
		Position = UDim2.fromOffset(70, 10),
		MaxTextSize = 40,
		StrokeThickness = 3,
		Parent = frame,
	})
	local content = New("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(16, 68),
		Size = UDim2.new(1, -32, 1, -84),
		Parent = frame,
	})
	local panel = {
		name = name,
		holder = holder,
		frame = frame,
		content = content,
		title = titleLabel,
		pop = pop,
		onOpen = nil :: (() -> ())?,
	}
	UIKit.button({
		Name = "Close",
		Text = "✕",
		Color = C.Red,
		Size = UDim2.fromOffset(52, 52),
		Position = UDim2.new(1, -10, 0, -10),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Radius = 0.5,
		MaxTextSize = 30,
		Parent = frame,
		OnClick = function()
			UIKit.close(name)
		end,
	})
	panels[name] = panel
	return panel
end

function UIKit.open(name: string)
	local panel = panels[name]
	if not panel then
		return
	end
	if current and current ~= name then
		UIKit.close(current)
	end
	current = name
	panel.holder.Visible = true
	panel.pop.Scale = 0.75
	UIKit.tween(panel.pop, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	if blur then
		UIKit.tween(blur, 0.2, { Size = 10 })
	end
	if panel.onOpen then
		task.spawn(panel.onOpen)
	end
end

function UIKit.close(name: string)
	local panel = panels[name]
	if not panel then
		return
	end
	panel.holder.Visible = false
	if current == name then
		current = nil
		if blur then
			UIKit.tween(blur, 0.2, { Size = 0 })
		end
	end
end

function UIKit.toggle(name: string)
	if current == name then
		UIKit.close(name)
	else
		UIKit.open(name)
	end
end

function UIKit.isOpen(name: string): boolean
	return current == name
end

function UIKit.clear(container: Instance)
	for _, child in container:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

return UIKit
