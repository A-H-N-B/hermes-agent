      <Item class="ModuleScript" referent="RBXA238774B53DF46C0BD7CD19568383E91">
        <Properties>
          <string name="Name">EventService</string>
          <ProtectedString name="Source"><![CDATA[-- Server-wide boosts and timed events. State is mirrored as attributes on
-- ReplicatedStorage.ServerState so every client can show banners/countdowns.
-- Times use workspace:GetServerTimeNow() so client countdowns match the server.
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))

local EventService = {}

local S
local folder: Folder
local rng = Random.new()

-- purchased / admin boosts: ends = server time, mult = strength
local boosts = {
	luck = { ends = 0, mult = 2 },
	rain = { ends = 0, mult = 2 },
	golden = { ends = 0, mult = 3 },
}
local adminLuck = { ends = 0, mult = 1 }
local current = nil -- natural event definition while active
local currentEnds = 0

local EVENTS = {
	{ key = "LuckyHour", name = "🍀 LUCKY HOUR", desc = "2x luck for everyone!", luck = 2 },
	{ key = "GoldenHour", name = "✨ GOLDEN HOUR", desc = "3x mutation chance!", golden = 3 },
	{ key = "SlimeRain", name = "🌧️ SLIME RAIN", desc = "Slimes spawn 2x faster!", rain = 2 },
	{ key = "GooMoon", name = "🌙 GOO MOON", desc = "All base locks are DOWN! Defend your slimes!", noLocks = true, duration = 60 },
}

local function now(): number
	return workspace:GetServerTimeNow()
end

local function active(b): boolean
	return b.ends > now()
end

local function publish()
	folder:SetAttribute("LuckMult", EventService.luck())
	folder:SetAttribute("LuckEnds", math.max(boosts.luck.ends, adminLuck.ends))
	folder:SetAttribute("RainEnds", boosts.rain.ends)
	folder:SetAttribute("GoldenEnds", boosts.golden.ends)
	folder:SetAttribute("MutationMult", EventService.mutationMult())
	folder:SetAttribute("SpawnMult", EventService.spawnRateMult())
	folder:SetAttribute("EventKey", if current then current.key else "")
	folder:SetAttribute("EventName", if current then current.name else "")
	folder:SetAttribute("EventDesc", if current then current.desc else "")
	folder:SetAttribute("EventEnds", currentEnds)
	folder:SetAttribute("LocksDisabled", EventService.locksDisabled())
end

function EventService.luck(): number
	local luck = 1
	if active(boosts.luck) then
		luck *= boosts.luck.mult
	end
	if active(adminLuck) then
		luck *= adminLuck.mult
	end
	if current and current.luck and currentEnds > now() then
		luck *= current.luck
	end
	return math.min(luck, 100)
end

function EventService.mutationMult(): number
	local mult = 1
	if active(boosts.golden) then
		mult *= boosts.golden.mult
	end
	if current and current.golden and currentEnds > now() then
		mult *= current.golden
	end
	return mult
end

function EventService.spawnRateMult(): number
	local mult = 1
	if active(boosts.rain) then
		mult *= boosts.rain.mult
	end
	if current and current.rain and currentEnds > now() then
		mult *= current.rain
	end
	return mult
end

function EventService.locksDisabled(): boolean
	return current ~= nil and current.noLocks == true and currentEnds > now()
end

-- kind: "luck" | "rain" | "golden". Stacks duration; buyerName is announced.
function EventService.addBoost(kind: string, seconds: number, buyerName: string?)
	local b = boosts[kind]
	assert(b, "unknown boost " .. kind)
	b.ends = math.max(b.ends, now()) + seconds
	publish()
	local labels = { luck = "🍀 2x SERVER LUCK", rain = "🌧️ SLIME RAIN", golden = "✨ GOLDEN SLIMES" }
	if buyerName then
		S.PlayerService.notifyAll(string.format("%s activated %s for everyone! (%s) 💚", buyerName, labels[kind],
			Format.time(b.ends - now())), "event")
		S.PlayerService.fxAll("celebrate", { text = labels[kind] })
	end
	task.delay(seconds + 0.5, publish)
end

function EventService.setAdminLuck(mult: number, seconds: number)
	adminLuck.mult = math.clamp(mult, 1, 100)
	adminLuck.ends = now() + seconds
	publish()
	S.PlayerService.notifyAll(string.format("🛠️ ADMIN EVENT: %dx LUCK for %s!", adminLuck.mult, Format.time(seconds)), "event")
	S.PlayerService.fxAll("celebrate", { text = string.format("%dx LUCK!", adminLuck.mult) })
	task.delay(seconds + 0.5, publish)
end

local function tweenSky(night: boolean)
	local info = TweenInfo.new(3, Enum.EasingStyle.Sine)
	TweenService:Create(Lighting, info, { ClockTime = if night then 0.3 else 14.5 }):Play()
	local grade = Lighting:FindFirstChild("Grade")
	if grade and grade:IsA("ColorCorrectionEffect") then
		TweenService:Create(grade, info, {
			TintColor = if night then Color3.fromRGB(200, 170, 255) else Color3.fromRGB(255, 255, 255),
		}):Play()
	end
end

function EventService.startEvent(key: string, seconds: number?)
	local def = nil
	for _, e in EVENTS do
		if e.key == key then
			def = e
		end
	end
	if not def then
		return false
	end
	local duration = seconds or def.duration or Config.Tuning.EventDuration
	current = def
	currentEnds = now() + duration
	publish()
	if def.noLocks then
		tweenSky(true)
		S.PlotService.unlockAll()
	end
	S.PlayerService.notifyAll(def.name .. " — " .. def.desc, "event")
	S.PlayerService.fxAll("event", { name = def.name, desc = def.desc })
	local token = currentEnds
	task.delay(duration, function()
		if currentEnds == token then
			if def.noLocks then
				tweenSky(false)
			end
			current = nil
			currentEnds = 0
			publish()
			S.PlayerService.notifyAll(def.name .. " has ended.", "info")
		end
	end)
	return true
end

function EventService.eventKeys(): { string }
	local keys = {}
	for _, e in EVENTS do
		table.insert(keys, e.key)
	end
	return keys
end

function EventService.init(services)
	S = services
	folder = Instance.new("Folder")
	folder.Name = "ServerState"
	folder.Parent = ReplicatedStorage
	publish()
end

function EventService.start()
	while true do
		task.wait(rng:NextInteger(Config.Tuning.EventMinGap, Config.Tuning.EventMaxGap))
		if not current and #S.PlayerService.readyPlayers() > 0 then
			EventService.startEvent(EVENTS[rng:NextInteger(1, #EVENTS)].key)
		end
	end
end

return EventService
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX684A14AED34B4513976F15C19F65F59A">
        <Properties>
          <string name="Name">LeaderboardService</string>
          <ProtectedString name="Source"><![CDATA[-- Global leaderboards (OrderedDataStore) rendered on the two plaza boards.
-- OrderedDataStores only hold integers, so lifetime cash is stored as
-- log10(cash) * 1e6, which keeps ordering and 6 digits of precision.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local New = require(Shared:WaitForChild("New"))

local LeaderboardService = {}

local S
local stores = {}
local rows = {} -- [boardName] = { TextLabel }
local names: { [number]: string } = {}

local SUBMIT_EVERY = 300
local REFRESH_EVERY = 180
local ROWS = 10

local function encodeEarned(x: number): number
	return math.floor(math.log10(math.max(x, 1)) * 1e6)
end

local function decodeEarned(v: number): number
	return 10 ^ (v / 1e6)
end

local BOARDS = {
	{ name = "Earned", store = Config.LeaderboardEarnedStore, encode = encodeEarned, decode = decodeEarned,
		format = Format.cash, field = "totalEarned" },
	{ name = "Rebirths", store = Config.LeaderboardRebirthStore, encode = math.floor,
		decode = function(v)
			return v
		end, format = function(v)
			return "⭐ " .. Format.num(v)
		end, field = "rebirths" },
}

local function getStore(board)
	if stores[board.name] == nil and not S.DataService.isMemoryMode() then
		local ok, result = pcall(function()
			return DataStoreService:GetOrderedDataStore(board.store)
		end)
		stores[board.name] = if ok then result else false
	end
	return stores[board.name] or nil
end

local function nameOf(userId: number): string
	if names[userId] then
		return names[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	names[userId] = if ok then name else ("User " .. userId)
	return names[userId]
end

function LeaderboardService.submit(player: Player)
	local profile = S.DataService.get(player)
	if not profile then
		return
	end
	-- read values up front: the profile may be released while SetAsync yields
	local values = {}
	for _, board in BOARDS do
		values[board.name] = board.encode(profile.data[board.field])
	end
	for _, board in BOARDS do
		local store = getStore(board)
		local value = values[board.name]
		if store and value > 0 then
			pcall(function()
				store:SetAsync(tostring(player.UserId), value)
			end)
		end
	end
end

local function buildBoard(part: BasePart)
	local gui = New("SurfaceGui", {
		Face = Enum.NormalId.Back,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 30,
		LightInfluence = 0,
		Parent = part,
	})
	local frame = New("Frame", {
		BackgroundColor3 = Color3.fromRGB(30, 25, 50),
		Size = UDim2.fromScale(1, 1),
		Parent = gui,
	}, {
		New("UIPadding", {
			PaddingTop = UDim.new(0.03, 0),
			PaddingLeft = UDim.new(0.05, 0),
			PaddingRight = UDim.new(0.05, 0),
		}),
		New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0.012, 0) }),
	})
	New("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 0.1),
		Font = Enum.Font.FredokaOne,
		Text = part:GetAttribute("Title") or part.Name,
		TextColor3 = Color3.fromRGB(255, 220, 90),
		TextScaled = true,
		LayoutOrder = 0,
		Parent = frame,
	})
	local list = {}
	for i = 1, ROWS do
		list[i] = New("TextLabel", {
			BackgroundColor3 = if i % 2 == 0 then Color3.fromRGB(45, 40, 70) else Color3.fromRGB(55, 48, 85),
			Size = UDim2.fromScale(1, 0.074),
			Font = Enum.Font.FredokaOne,
			Text = "",
			TextColor3 = if i == 1 then Color3.fromRGB(255, 215, 0)
				elseif i == 2 then Color3.fromRGB(220, 220, 235)
				elseif i == 3 then Color3.fromRGB(230, 160, 90)
				else Color3.fromRGB(255, 255, 255),
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = i,
			Parent = frame,
		}, { New("UICorner", { CornerRadius = UDim.new(0.2, 0) }) })
	end
	return list
end

local function refresh()
	for _, board in BOARDS do
		local store = getStore(board)
		local labels = rows[board.name]
		if store and labels then
			local ok, pages = pcall(function()
				return store:GetSortedAsync(false, ROWS)
			end)
			if ok then
				local entries = pages:GetCurrentPage()
				for i = 1, ROWS do
					local entry = entries[i]
					if entry then
						local userId = tonumber(entry.key) or 0
						labels[i].Text = string.format("  #%d  %s   %s", i, nameOf(userId), board.format(board.decode(entry.value)))
					else
						labels[i].Text = string.format("  #%d  —", i)
					end
				end
			end
		end
	end
end

function LeaderboardService.init(services)
	S = services
	local folder = workspace:FindFirstChild("World") and workspace.World:FindFirstChild("Leaderboards")
	if folder then
		for _, board in BOARDS do
			local part = folder:FindFirstChild(board.name)
			if part and part:IsA("BasePart") then
				rows[board.name] = buildBoard(part)
			end
		end
	end
	S.PlayerService.onLeaving(function(player)
		task.spawn(LeaderboardService.submit, player)
	end)
end

function LeaderboardService.start()
	task.wait(10)
	refresh()
	local lastSubmit = os.clock()
	while true do
		task.wait(REFRESH_EVERY)
		if os.clock() - lastSubmit >= SUBMIT_EVERY then
			lastSubmit = os.clock()
			for _, player in S.PlayerService.readyPlayers() do
				LeaderboardService.submit(player)
				task.wait(1)
			end
		end
		refresh()
	end
end

return LeaderboardService
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXCE887383C0A24954805F745FEBDCD386">
        <Properties>
          <string name="Name">MonetizationService</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Game passes, developer products, gifting, rewarded video ads, Premium/Plus
	and experience subscriptions.

	Receipt safety (ProcessReceipt):
	  1. wait until the buyer's data is loaded
	  2. skip if this PurchaseId was already granted (stored in player data)
	  3. grant, record the PurchaseId, SAVE, and only then return PurchaseGranted
	A failed save returns NotProcessedYet; Roblox retries and step 2 prevents a
	double grant. Nothing sold here is random: every product grants exactly what
	the shop shows.
]]
local AdService = game:GetService("AdService")
local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))
local Format = require(Shared:WaitForChild("Format"))

local MonetizationService = {}

local S
local owned: { [Player]: { [string]: boolean } } = {}
local club: { [Player]: boolean } = {}
local prices = { passes = {}, products = {} }
local productKeyById: { [number]: string } = {}
local passKeyById: { [number]: string } = {}
local inFlight: { [string]: boolean } = {}
local pendingGift: { [Player]: { target: number, key: string } } = {}
local pendingAd: { [Player]: string } = {}
local lastAd: { [Player]: number } = {}
local giftStore: DataStore? = nil

local MAX_GIFT_IDS = 200

local function profileOf(player: Player)
	return S.DataService.get(player)
end

function MonetizationService.isConfigured(kind: string, key: string): boolean
	local def = if kind == "pass" then Config.Passes[key] else Config.Products[key]
	return def ~= nil and type(def.id) == "number" and def.id > 0
end

function MonetizationService.has(player: Player, passKey: string): boolean
	local list = owned[player]
	if list and list[passKey] then
		return true
	end
	local profile = profileOf(player)
	return profile ~= nil and profile.data.giftedPasses[passKey] == true
end

function MonetizationService.isPremium(player: Player): boolean
	return player.MembershipType == Enum.MembershipType.Premium
end

function MonetizationService.isClub(player: Player): boolean
	return club[player] == true
end

local function priceOf(kind: string, key: string): number
	local def = if kind == "pass" then Config.Passes[key] else Config.Products[key]
	local cache = if kind == "pass" then prices.passes else prices.products
	return cache[key] or def.price
end

function MonetizationService.state(player: Player)
	local passes = {}
	for key, def in Config.Passes do
		if MonetizationService.isConfigured("pass", key) then
			table.insert(passes, {
				key = key,
				name = def.name,
				icon = def.icon,
				desc = def.desc,
				price = priceOf("pass", key),
				owned = MonetizationService.has(player, key),
				order = def.order,
			})
		end
	end
	local products = {}
	for key, def in Config.Products do
		if MonetizationService.isConfigured("product", key) and not def.hidden then
			table.insert(products, {
				key = key,
				name = def.name,
				icon = def.icon,
				price = priceOf("product", key),
				minutes = def.minutes,
				min = def.min,
				gift = def.gift,
				rarity = def.rarity,
				order = def.order,
			})
		end
	end
	local profile = profileOf(player)
	return {
		passes = passes,
		products = products,
		owned = owned[player] or {},
		gifted = profile.data.giftedPasses,
		giftCredits = profile.data.giftCredits,
		starterPackBought = profile.data.starterPack,
		isPremium = MonetizationService.isPremium(player),
		isClub = MonetizationService.isClub(player),
		clubName = Config.SubscriptionName,
		clubConfigured = Config.SubscriptionId ~= "",
		adsEnabled = Config.RewardedAds.Enabled and MonetizationService.isConfigured("product", "AdReward"),
		adReadyAt = (lastAd[player] or 0) + Config.RewardedAds.CooldownSeconds,
	}
end

local function pushState(player: Player)
	S.PlayerService.sync(player, MonetizationService.state(player))
end

-- Applies side effects of owning a pass (called on join, purchase or gift).
local function applyPass(player: Player, key: string)
	if key == "VIP" then
		player:SetAttribute("VIP", true)
		S.PlayerService.refreshNametag(player)
	elseif key == "ExtraPads" then
		S.PlotService.refreshPads(player)
		S.PlayerService.sync(player, S.PlotService.state(player))
	elseif key == "Speed" or key == "FastSteal" then
		S.PlayerService.refreshSpeed(player)
	end
end

---------------------------------------------------------------------------
-- Gifts: buying a Gift* product adds a credit to the buyer (saved with the
-- receipt). Sending a credit appends to the recipient's queue in a separate
-- DataStore; recipients claim queued gifts when they are online.
---------------------------------------------------------------------------
local function getGiftStore(): DataStore?
	if giftStore or S.DataService.isMemoryMode() then
		return giftStore
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.GiftStoreName)
	end)
	if ok then
		giftStore = result
	end
	return giftStore
end

local function deliverGiftsTo(player: Player)
	local profile = profileOf(player)
	local ds = getGiftStore()
	if not profile or not ds then
		return
	end
	local key = "g_" .. player.UserId
	local ok, queue = pcall(function()
		return ds:GetAsync(key)
	end)
	if not ok or type(queue) ~= "table" or #queue == 0 then
		return
	end
	local received = profile.data.giftsReceived
	local applied = {}
	for _, gift in queue do
		if type(gift) == "table" and type(gift.id) == "string" then
			table.insert(applied, gift.id)
			if not table.find(received, gift.id) and Config.Passes[gift.key] then
				table.insert(received, gift.id)
				profile.data.giftedPasses[gift.key] = true
				applyPass(player, gift.key)
				S.PlayerService.notify(player, string.format("🎁 %s gifted you %s!", tostring(gift.from),
					Config.Passes[gift.key].name), "purchase")
				S.PlayerService.fx(player, "celebrate", { text = "GIFT: " .. Config.Passes[gift.key].name })
			end
		end
	end
	while #received > MAX_GIFT_IDS do
		table.remove(received, 1)
	end
	if not S.DataService.saveNow(player) then
		return -- keep the queue; dedupe by id makes a retry safe
	end
	pcall(function()
		ds:UpdateAsync(key, function(old)
			if type(old) ~= "table" then
				return nil
			end
			local keep = {}
			for _, gift in old do
				if type(gift) ~= "table" or not table.find(applied, gift.id) then
					table.insert(keep, gift)
				end
			end
			return keep
		end)
	end)
	pushState(player)
end

local function sendGiftCredit(sender: Player, passKey: string, targetUserId: number)
	local profile = profileOf(sender)
	local credits = profile.data.giftCredits
	if (credits[passKey] or 0) < 1 then
		return false, "No gift credit for that item."
	end
	local ds = getGiftStore()
	if not ds then
		return false, "Gifts are unavailable right now."
	end
	local giftId = string.format("%d-%d-%d", sender.UserId, os.time(), math.random(1, 1e6))
	local ok = pcall(function()
		ds:UpdateAsync("g_" .. targetUserId, function(old)
			old = if type(old) == "table" then old else {}
			table.insert(old, { id = giftId, key = passKey, from = sender.DisplayName, fromId = sender.UserId, t = os.time() })
			return old
		end)
	end)
	if not ok then
		return false, "Couldn't send the gift, try again."
	end
	credits[passKey] -= 1
	S.DataService.saveNow(sender)
	local target = Players:GetPlayerByUserId(targetUserId)
	if target and S.PlayerService.isReady(target) then
		task.spawn(deliverGiftsTo, target)
	end
	pushState(sender)
	return true, nil
end

---------------------------------------------------------------------------
-- Product handlers: handler(player, profile, receiptInfo). Must not yield on
-- external services; everything is applied to in-memory data.
---------------------------------------------------------------------------
local handlers = {}

local function cashPack(key: string)
	return function(player: Player)
		local def = Config.Products[key]
		local amount = Economy.scaledCash(S.EconomyService.baseIncomePerSecond(player), def.minutes, def.min)
		S.EconomyService.addCash(player, amount, key, "IAP")
		S.PlayerService.fx(player, "celebrate", { text = "+" .. Format.cash(amount) })
	end
end
for _, key in { "CashSmall", "CashMedium", "CashLarge", "CashMega" } do
	handlers[key] = cashPack(key)
end

function handlers.ServerLuck(player: Player)
	S.EventService.addBoost("luck", Config.Products.ServerLuck.minutes * 60, player.DisplayName)
end

function handlers.ServerRain(player: Player)
	S.EventService.addBoost("rain", Config.Products.ServerRain.minutes * 60, player.DisplayName)
end

function handlers.CashBoost(player: Player)
	S.EconomyService.addBoost(player, "cash2x", Config.Products.CashBoost.minutes * 60)
	S.PlayerService.fx(player, "celebrate", { text = "2x CASH!" })
end

function handlers.Shield(player: Player)
	S.EconomyService.addBoost(player, "shield", Config.Products.Shield.minutes * 60)
	S.PlayerService.notify(player, "🛡️ Base shielded for " .. Config.Products.Shield.minutes .. " minutes!", "success")
end

function handlers.StarterPack(player: Player, profile)
	local income = S.EconomyService.baseIncomePerSecond(player)
	if profile.data.starterPack then
		-- bought twice (e.g. two prompts at once): pay out the cash value instead
		S.EconomyService.addCash(player, Economy.scaledCash(income, 60, 50000), "StarterPackRepeat", "IAP")
		return
	end
	profile.data.starterPack = true
	S.EconomyService.addCash(player, Economy.scaledCash(income, 30, 25000), "StarterPack", "IAP")
	S.EconomyService.addBoost(player, "cash2x", 60 * 60)
	S.SlimeService.grantSlime(player, "noodle", "Golden", {
		allowOverflow = true,
		shieldSeconds = Config.Tuning.RobuxSlimeShieldMinutes * 60,
	})
	S.PlayerService.fx(player, "celebrate", { text = "STARTER PACK!" })
end

function handlers.OfflineDouble(player: Player, profile)
	if profile.data.offlinePending > 0 then
		S.EconomyService.claimOffline(player, 2, "OfflineDouble")
	else
		local amount = Economy.scaledCash(S.EconomyService.baseIncomePerSecond(player), 20, 5000)
		S.EconomyService.addCash(player, amount, "OfflineDoubleFallback", "IAP")
	end
end

for key, def in Config.Products do
	if def.rarity then
		handlers[key] = function(player: Player)
			S.SlimeService.grantInstant(player, key, def.rarity)
		end
	elseif def.gift then
		handlers[key] = function(player: Player, profile)
			local credits = profile.data.giftCredits
			credits[def.gift] = (credits[def.gift] or 0) + 1
		end
	end
end

function handlers.AdReward(player: Player)
	local context = pendingAd[player]
	pendingAd[player] = nil
	if context == "offline" and S.EconomyService.claimOffline(player, 2, "AdOffline") > 0 then
		return
	end
	S.EconomyService.addBoost(player, "cash2x", Config.RewardedAds.BoostMinutes * 60)
	S.PlayerService.notify(player, "📺 Thanks for watching! 2x cash for " .. Config.RewardedAds.BoostMinutes .. " min.",
		"success")
end

local function afterGrant(player: Player, key: string)
	local def = Config.Products[key]
	if def and def.gift then
		local pending = pendingGift[player]
		pendingGift[player] = nil
		if pending and pending.key == key then
			task.spawn(function()
				local ok, err = sendGiftCredit(player, def.gift, pending.target)
				local target = Players:GetPlayerByUserId(pending.target)
				local name = if target then target.DisplayName else "your friend"
				if ok then
					S.PlayerService.notify(player, "🎁 Gift sent to " .. name .. "!", "success")
					S.PlayerService.notifyAll(string.format("🎁 %s gifted %s to %s!", player.DisplayName,
						Config.Passes[def.gift].name, name), "purchase")
				else
					S.PlayerService.notify(player, tostring(err) .. " Your gift is saved in Shop > Gifts.", "warning")
				end
			end)
		end
	end
end

local function processReceipt(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local profile = S.DataService.waitFor(player, 20)
	local deadline = os.clock() + 20
	while profile and not S.PlayerService.isReady(player) and player.Parent and os.clock() < deadline do
		task.wait(0.25)
	end
	if not profile or not S.PlayerService.isReady(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local purchaseId = tostring(info.PurchaseId)
	if S.DataService.hasReceipt(profile, purchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local key = productKeyById[info.ProductId]
	local handler = key and handlers[key]
	if not handler then
		warn("[Monetization] no handler for product " .. tostring(info.ProductId) .. " (add its id to Config.Products)")
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if inFlight[purchaseId] then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	inFlight[purchaseId] = true
	local ok, err = pcall(handler, player, profile, info)
	if not ok then
		inFlight[purchaseId] = nil
		warn("[Monetization] grant failed for " .. tostring(key) .. ": " .. tostring(err))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	S.DataService.addReceipt(profile, purchaseId)
	local spent = tonumber(info.CurrencySpent) or 0
	profile.data.stats.robuxSpent += spent
	local saved = S.DataService.saveNow(player)
	inFlight[purchaseId] = nil
	if not saved then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	S.Analytics.custom(player, "Purchase_" .. key, spent)
	afterGrant(player, key)
	pushState(player)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

---------------------------------------------------------------------------
-- Prompts
---------------------------------------------------------------------------
function MonetizationService.promptPass(player: Player, key: string)
	if not MonetizationService.isConfigured("pass", key) then
		return { ok = false, msg = "Not available yet." }
	end
	if MonetizationService.has(player, key) then
		return { ok = false, msg = "You already own this!" }
	end
	S.Analytics.custom(player, "PromptPass_" .. key)
	MarketplaceService:PromptGamePassPurchase(player, Config.Passes[key].id)
	return { ok = true }
end

function MonetizationService.promptProduct(player: Player, key: string)
	if not MonetizationService.isConfigured("product", key) then
		return { ok = false, msg = "Not available yet." }
	end
	local profile = profileOf(player)
	if key == "StarterPack" and profile.data.starterPack then
		return { ok = false, msg = "You already got the Starter Pack!" }
	end
	S.Analytics.custom(player, "PromptProduct_" .. key)
	MarketplaceService:PromptProductPurchase(player, Config.Products[key].id)
	return { ok = true }
end

function MonetizationService.showAd(player: Player, context: string)
	if not (Config.RewardedAds.Enabled and MonetizationService.isConfigured("product", "AdReward")) then
		return { ok = false, msg = "Free rewards are not available." }
	end
	local readyAt = (lastAd[player] or 0) + Config.RewardedAds.CooldownSeconds
	if os.time() < readyAt and context ~= "offline" then
		return { ok = false, msg = "Next free reward in " .. Format.time(readyAt - os.time()) }
	end
	pendingAd[player] = context
	local ok, result = pcall(function()
		local reward = AdService:CreateAdRewardFromDevProductId(Config.Products.AdReward.id)
		return AdService:ShowRewardedVideoAdAsync(player, reward)
	end)
	if ok and result == Enum.ShowAdResult.ShowCompleted then
		lastAd[player] = os.time()
		pushState(player)
		return { ok = true }
	end
	pendingAd[player] = nil
	return { ok = false, msg = "No video available right now — try again later!" }
end

local function checkSubscription(player: Player)
	if Config.SubscriptionId == "" then
		return
	end
	local ok, status = pcall(function()
		return MarketplaceService:GetUserSubscriptionStatusAsync(player, Config.SubscriptionId)
	end)
	local isSub = ok and type(status) == "table" and status.IsSubscribed == true
	club[player] = isSub
	player:SetAttribute("Club", isSub)
end

local function onReady(player: Player)
	owned[player] = {}
	local pending = 0
	for key, def in Config.Passes do
		if MonetizationService.isConfigured("pass", key) then
			pending += 1
			task.spawn(function()
				local ok, has = pcall(function()
					return MarketplaceService:UserOwnsGamePassAsync(player.UserId, def.id)
				end)
				if ok and has and owned[player] then
					owned[player][key] = true
				end
				pending -= 1
			end)
		end
	end
	local deadline = os.clock() + 6
	while pending > 0 and os.clock() < deadline do
		task.wait(0.1)
	end
	checkSubscription(player)
	for key in Config.Passes do
		if MonetizationService.has(player, key) then
			applyPass(player, key)
		end
	end
	task.spawn(deliverGiftsTo, player)
end

function MonetizationService.init(services)
	S = services
	for key, def in Config.Products do
		if def.id > 0 then
			productKeyById[def.id] = key
		end
	end
	for key, def in Config.Passes do
		if def.id > 0 then
			passKeyById[def.id] = key
		end
	end
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		local key = passKeyById[passId]
		if not purchased or not key or not owned[player] then
			return
		end
		owned[player][key] = true
		applyPass(player, key)
		S.Analytics.custom(player, "BoughtPass_" .. key, priceOf("pass", key))
		S.PlayerService.fx(player, "celebrate", { text = Config.Passes[key].name .. "!" })
		S.PlayerService.notifyAll(string.format("🎉 %s got %s %s!", player.DisplayName, Config.Passes[key].icon,
			Config.Passes[key].name), "purchase")
		pushState(player)
		S.PlayerService.sync(player, S.EconomyService.state(player))
	end)

	Players.PlayerMembershipChanged:Connect(function(player)
		if S.PlayerService.isReady(player) then
			pushState(player)
		end
	end)
	Players.UserSubscriptionStatusChanged:Connect(function(player, subscriptionId)
		if subscriptionId == Config.SubscriptionId and S.PlayerService.isReady(player) then
			checkSubscription(player)
			S.PlayerService.refreshNametag(player)
			pushState(player)
		end
	end)

	S.PlayerService.onReady(onReady)
	S.PlayerService.onLeaving(function(player)
		owned[player] = nil
		club[player] = nil
		pendingGift[player] = nil
		pendingAd[player] = nil
		lastAd[player] = nil
	end)
	S.PlayerService.addState(function(player)
		return MonetizationService.state(player)
	end)

	S.PlayerService.registerAction("buyPass", function(player, key)
		return MonetizationService.promptPass(player, tostring(key))
	end)
	S.PlayerService.registerAction("buyProduct", function(player, key)
		key = tostring(key)
		local def = Config.Products[key]
		if not def or def.hidden or def.rarity or def.gift then
			return { ok = false }
		end
		return MonetizationService.promptProduct(player, key)
	end)
	S.PlayerService.registerAction("gift", function(player, payload)
		if type(payload) ~= "table" then
			return { ok = false }
		end
		local key = tostring(payload.key)
		local def = Config.Products[key]
		local target = Players:GetPlayerByUserId(tonumber(payload.target) or 0)
		if not def or not def.gift or not target or target == player then
			return { ok = false, msg = "Pick a player in this server." }
		end
		if MonetizationService.has(target, def.gift) then
			return { ok = false, msg = target.DisplayName .. " already has " .. Config.Passes[def.gift].name .. "!" }
		end
		local profile = profileOf(player)
		if (profile.data.giftCredits[def.gift] or 0) > 0 then
			local ok, err = sendGiftCredit(player, def.gift, target.UserId)
			return { ok = ok, msg = if ok then "🎁 Gift sent!" else err }
		end
		pendingGift[player] = { target = target.UserId, key = key }
		return MonetizationService.promptProduct(player, key)
	end)
	S.PlayerService.registerAction("watchAd", function(player, context)
		return MonetizationService.showAd(player, if context == "offline" then "offline" else "boost")
	end)
	S.PlayerService.registerAction("subscribe", function(player)
		if Config.SubscriptionId == "" then
			return { ok = false }
		end
		MarketplaceService:PromptSubscriptionPurchase(player, Config.SubscriptionId)
		return { ok = true }
	end)
	S.PlayerService.registerAction("premium", function(player)
		local ok = pcall(function()
			MarketplaceService:PromptRobloxSubscriptionPurchase(player)
		end)
		return { ok = ok }
	end)
end

function MonetizationService.start()
	-- real prices from Roblox so the shop always shows what players will pay
	for key, def in Config.Passes do
		if def.id > 0 then
			local ok, info = pcall(function()
				return MarketplaceService:GetProductInfoAsync(def.id, Enum.InfoType.GamePass)
			end)
			if ok and type(info) == "table" and type(info.PriceInRobux) == "number" then
				prices.passes[key] = info.PriceInRobux
			end
		end
	end
	for key, def in Config.Products do
		if def.id > 0 then
			local ok, info = pcall(function()
				return MarketplaceService:GetProductInfoAsync(def.id, Enum.InfoType.Product)
			end)
			if ok and type(info) == "table" and type(info.PriceInRobux) == "number" then
				prices.products[key] = info.PriceInRobux
			end
		end
	end
	for _, player in S.PlayerService.readyPlayers() do
		pushState(player)
	end
	-- pick up gifts sent while players are online in other servers
	while true do
		task.wait(90)
		for _, player in S.PlayerService.readyPlayers() do
			task.spawn(deliverGiftsTo, player)
			task.wait(0.5)
		end
	end
end

return MonetizationService
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXEF4A5CDD5B0A4734A52F480F7182F116">
        <Properties>
          <string name="Name">PlayerService</string>
          <ProtectedString name="Source"><![CDATA[-- Player lifecycle hub: loads data, runs every service's ready/leave hooks in
-- order, spawns characters at their base, and owns the single validated,
-- rate-limited Action remote plus Sync/Notify/FX helpers.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local New = require(Shared:WaitForChild("New"))

local PlayerService = {}

local S
local actions = {}
local readyHooks = {}
local leaveHooks = {}
local stateProviders = {}
local ready: { [Player]: boolean } = {}
local buckets: { [Player]: { tokens: number, t: number } } = {}
local friendCounts: { [Player]: number } = {}
local stunnedUntil: { [Player]: number } = {}

local BUCKET_SIZE = 16
local BUCKET_REFILL = 8 -- tokens per second

function PlayerService.registerAction(name: string, handler)
	assert(actions[name] == nil, "duplicate action " .. name)
	actions[name] = handler
end

function PlayerService.onReady(fn)
	table.insert(readyHooks, fn)
end

function PlayerService.onLeaving(fn)
	table.insert(leaveHooks, fn)
end

function PlayerService.addState(fn)
	table.insert(stateProviders, fn)
end

function PlayerService.isReady(player: Player): boolean
	return ready[player] == true
end

function PlayerService.readyPlayers(): { Player }
	local list = {}
	for player in ready do
		if player.Parent then
			table.insert(list, player)
		end
	end
	return list
end

function PlayerService.sync(player: Player, partial)
	if ready[player] and player.Parent then
		Remotes.get("Sync"):FireClient(player, partial)
	end
end

function PlayerService.notify(player: Player, text: string, kind: string?)
	if player.Parent then
		Remotes.get("Notify"):FireClient(player, text, kind or "info")
	end
end

function PlayerService.notifyAll(text: string, kind: string?)
	Remotes.get("Notify"):FireAllClients(text, kind or "info")
end

function PlayerService.fx(player: Player, name: string, data)
	if player.Parent then
		Remotes.get("FX"):FireClient(player, name, data)
	end
end

function PlayerService.fxAll(name: string, data)
	Remotes.get("FX"):FireAllClients(name, data)
end

function PlayerService.fullState(player: Player)
	local profile = S.DataService.get(player)
	if not profile then
		return nil
	end
	local state = { full = true }
	for _, provider in stateProviders do
		local ok, partial = pcall(provider, player, profile)
		if ok and partial then
			for k, v in partial do
				state[k] = v
			end
		elseif not ok then
			warn("[PlayerService] state provider failed: " .. tostring(partial))
		end
	end
	return state
end

function PlayerService.friendCount(player: Player): number
	return friendCounts[player] or 0
end

local function takeToken(player: Player): boolean
	local now = os.clock()
	local bucket = buckets[player]
	if not bucket then
		bucket = { tokens = BUCKET_SIZE, t = now }
		buckets[player] = bucket
	end
	bucket.tokens = math.min(BUCKET_SIZE, bucket.tokens + (now - bucket.t) * BUCKET_REFILL)
	bucket.t = now
	if bucket.tokens < 1 then
		return false
	end
	bucket.tokens -= 1
	return true
end

-- Walk speed = base x Turbo pass x carry slowdown (0 while stunned).
function PlayerService.refreshSpeed(player: Player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	if (stunnedUntil[player] or 0) > os.clock() then
		humanoid.WalkSpeed = 0
		return
	end
	local speed = Config.Tuning.WalkSpeed
	if S.MonetizationService.has(player, "Speed") then
		speed *= Config.Tuning.SpeedPassMult
	end
	if S.CarryService.isCarrying(player) and not S.MonetizationService.has(player, "FastSteal") then
		speed *= Config.Tuning.CarrySpeedMult
	end
	humanoid.WalkSpeed = speed
end

function PlayerService.stun(player: Player, seconds: number)
	stunnedUntil[player] = os.clock() + seconds
	PlayerService.refreshSpeed(player)
	task.delay(seconds + 0.05, function()
		if player.Parent then
			PlayerService.refreshSpeed(player)
		end
	end)
end

local function spawnCharacter(player: Player)
	if not player.Parent then
		return
	end
	local ok = pcall(function()
		player:LoadCharacterAsync()
	end)
	if not ok and player.Parent then
		player:LoadCharacter()
	end
end

local function nametag(player: Player, character: Model)
	local head = character:WaitForChild("Head", 10)
	if not head or not head:IsA("BasePart") then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	local old = head:FindFirstChild("Nametag")
	if old then
		old:Destroy()
	end
	local gui = New("BillboardGui", {
		Name = "Nametag",
		Size = UDim2.fromScale(6, 1.6),
		StudsOffset = Vector3.new(0, 2.6, 0),
		MaxDistance = 90,
		LightInfluence = 0,
		Adornee = head,
	})
	New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Parent = gui })
	local vip = player:GetAttribute("VIP") == true
	New("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 0.4),
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		TextStrokeTransparency = 0.2,
		Text = PlayerService.titleFor(player),
		TextColor3 = if vip then Color3.fromRGB(255, 215, 70) else Color3.fromRGB(170, 220, 255),
		LayoutOrder = 1,
		Parent = gui,
	})
	New("TextLabel", {
		Name = "PlayerName",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 0.6),
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		TextStrokeTransparency = 0.1,
		Text = player.DisplayName,
		TextColor3 = if vip then Color3.fromRGB(255, 225, 120) else Color3.fromRGB(255, 255, 255),
		LayoutOrder = 2,
		Parent = gui,
	})
	gui.Parent = head
end

function PlayerService.titleFor(player: Player): string
	local parts = {}
	if player:GetAttribute("Admin") then
		table.insert(parts, "🛠️ DEV")
	end
	if player:GetAttribute("VIP") then
		table.insert(parts, "👑 VIP")
	end
	if player:GetAttribute("Club") then
		table.insert(parts, "💎 " .. Config.SubscriptionName)
	end
	local rebirths = player:GetAttribute("Rebirths") or 0
	if rebirths > 0 then
		table.insert(parts, "⭐ " .. rebirths)
	end
	return table.concat(parts, "  ")
end

function PlayerService.refreshNametag(player: Player)
	local character = player.Character
	if character then
		task.spawn(nametag, player, character)
	end
end

local function onCharacterAdded(player: Player, character: Model)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not root or not humanoid or not player.Parent then
		return
	end
	local plot = S.PlotService.get(player)
	if plot then
		task.defer(function()
			character:PivotTo(plot.spawn)
		end)
	end
	PlayerService.refreshSpeed(player)
	nametag(player, character)
	S.ToolService.equipStarterTools(player)
	humanoid.Died:Connect(function()
		S.CarryService.cancelFor(player, "fainted")
		task.delay(3, function()
			if player.Parent and player.Character == character then
				spawnCharacter(player)
			end
		end)
	end)
end

local function updateFriends(player: Player)
	for _, other in Players:GetPlayers() do
		if other ~= player then
			task.spawn(function()
				local ok, isFriend = pcall(function()
					return player:IsFriendsWithAsync(other.UserId)
				end)
				if ok and isFriend and player.Parent and other.Parent then
					friendCounts[player] = (friendCounts[player] or 0) + 1
					friendCounts[other] = (friendCounts[other] or 0) + 1
					PlayerService.notify(player, "🤝 Friend bonus! " .. other.DisplayName .. " is here (+5% cash)", "success")
					PlayerService.notify(other, "🤝 Friend bonus! " .. player.DisplayName .. " joined (+5% cash)", "success")
				end
			end)
		end
	end
end

local function setupLeaderstats(player: Player, profile)
	local stats = New("Folder", { Name = "leaderstats" })
	New("StringValue", { Name = "Cash", Value = Format.cash(profile.data.cash), Parent = stats })
	New("IntValue", { Name = "Rebirths", Value = profile.data.rebirths, Parent = stats })
	New("IntValue", { Name = "Steals", Value = profile.data.stats.steals, Parent = stats })
	stats.Parent = player
	player:SetAttribute("Rebirths", profile.data.rebirths)
end

function PlayerService.setStat(player: Player, name: string, value: any)
	local stats = player:FindFirstChild("leaderstats")
	local obj = stats and stats:FindFirstChild(name)
	if obj and (obj:IsA("StringValue") or obj:IsA("IntValue")) then
		(obj :: any).Value = value
	end
end

local function onPlayerAdded(player: Player)
	local profile = S.DataService.load(player)
	if not profile then
		if player.Parent then
			player:Kick("We couldn't load your data. Please rejoin in a minute!")
		end
		return
	end
	if not player.Parent then
		S.DataService.release(player)
		return
	end
	setupLeaderstats(player, profile)
	for _, hook in readyHooks do
		local ok, err = pcall(hook, player, profile)
		if not ok then
			warn("[PlayerService] ready hook failed: " .. tostring(err))
		end
	end
	ready[player] = true
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	spawnCharacter(player)
	Remotes.get("Sync"):FireClient(player, PlayerService.fullState(player))
	updateFriends(player)
	S.Analytics.onboarding(player, 1, "Joined")
end

local function onPlayerRemoving(player: Player)
	if ready[player] then
		ready[player] = nil
		for _, hook in leaveHooks do
			local ok, err = pcall(hook, player)
			if not ok then
				warn("[PlayerService] leave hook failed: " .. tostring(err))
			end
		end
		S.DataService.release(player)
	end
	buckets[player] = nil
	stunnedUntil[player] = nil
	friendCounts[player] = nil
	for _, other in Players:GetPlayers() do
		if other ~= player and friendCounts[other] then
			task.spawn(function()
				local ok, isFriend = pcall(function()
					return other:IsFriendsWithAsync(player.UserId)
				end)
				if ok and isFriend and friendCounts[other] then
					friendCounts[other] = math.max(0, friendCounts[other] - 1)
				end
			end)
		end
	end
end

function PlayerService.init(services)
	S = services
	-- characters spawn only after the player's base is assigned
	Players.CharacterAutoLoads = false
	Remotes.init()
	Remotes.get("Action").OnServerInvoke = function(player: Player, name: any, payload: any)
		if type(name) ~= "string" then
			return { ok = false }
		end
		local handler = actions[name]
		if not handler then
			return { ok = false, msg = "Unknown action" }
		end
		if not takeToken(player) then
			return { ok = false, msg = "Slow down!" }
		end
		if name ~= "ready" and not ready[player] then
			return { ok = false, msg = "Loading..." }
		end
		local ok, result = pcall(handler, player, payload)
		if not ok then
			warn(string.format("[Action %s] %s", name, tostring(result)))
			return { ok = false, msg = "Something went wrong" }
		end
		return result or { ok = true }
	end

	PlayerService.registerAction("ready", function(player)
		if not ready[player] then
			return { ok = false, notReady = true }
		end
		return { ok = true, state = PlayerService.fullState(player) }
	end)

	PlayerService.registerAction("settings", function(player, payload)
		local profile = S.DataService.get(player)
		if type(payload) ~= "table" then
			return { ok = false }
		end
		for _, key in { "music", "sfx", "lowGfx" } do
			if type(payload[key]) == "boolean" then
				profile.data.settings[key] = payload[key]
			end
		end
		return { ok = true }
	end)

	PlayerService.registerAction("tutorial", function(player, step)
		local profile = S.DataService.get(player)
		if type(step) == "number" and step > profile.data.tutorial and step <= 10 then
			profile.data.tutorial = math.floor(step)
			S.Analytics.onboarding(player, 1 + profile.data.tutorial, "Tutorial" .. profile.data.tutorial)
		end
		return { ok = true }
	end)

	PlayerService.addState(function(player, profile)
		return {
			settings = profile.data.settings,
			tutorial = profile.data.tutorial,
			stats = profile.data.stats,
			userId = player.UserId,
			memoryMode = S.DataService.isMemoryMode(),
		}
	end)
end

function PlayerService.start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	-- On shutdown run the normal leave flow (collect pad cash, cancel steals,
	-- save) for everyone, then release any profile that never became ready.
	game:BindToClose(function()
		local pending = 0
		for player in ready do
			pending += 1
			task.spawn(function()
				onPlayerRemoving(player)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 20
		while pending > 0 and os.clock() < deadline do
			task.wait(0.2)
		end
		S.DataService.releaseAll(math.max(1, deadline + 5 - os.clock()))
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	-- playtime stat
	while true do
		task.wait(60)
		for player in ready do
			local profile = S.DataService.get(player)
			if profile then
				profile.data.stats.playtime += 60
			end
		end
	end
end

return PlayerService
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXFC98FAB7512541F3A3EB75DC24AE66A0">
        <Properties>
          <string name="Name">PlotService</string>
          <ProtectedString name="Source"><![CDATA[-- Base ownership, locks/shields, pads and cash collect plates.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))
local Format = require(Shared:WaitForChild("Format"))

local PlotService = {}

local S
local byPlayer: { [Player]: any } = {}

local LOCK_COLOR = Color3.fromRGB(255, 60, 80)
local SHIELD_COLOR = Color3.fromRGB(80, 170, 255)
local PAD_ON = Color3.fromRGB(90, 230, 255)
local PAD_OFF = Color3.fromRGB(70, 70, 80)

local function now(): number
	return workspace:GetServerTimeNow()
end

local function playerFromHit(hit: BasePart): Player?
	local model = hit:FindFirstAncestorOfClass("Model")
	return model and Players:GetPlayerFromCharacter(model)
end

function PlotService.get(player: Player)
	return byPlayer[player]
end

function PlotService.isInside(plot, position: Vector3): boolean
	local p = plot.center:PointToObjectSpace(position)
	return math.abs(p.X) <= plot.size.X / 2 and math.abs(p.Y) <= plot.size.Y / 2 and math.abs(p.Z) <= plot.size.Z / 2
end

function PlotService.shieldLeft(plot): number
	if not plot.owner then
		return 0
	end
	return S.EconomyService.boostLeft(plot.owner, "shield")
end

function PlotService.lockLeft(plot): number
	if S.EventService.locksDisabled() then
		return 0
	end
	return math.max(0, plot.lockedUntil - now())
end

-- Returns true + reason when nobody may steal from this base right now.
function PlotService.isProtected(plot): (boolean, string?)
	if PlotService.shieldLeft(plot) > 0 then
		return true, "This base has a 🛡️ shield!"
	end
	if PlotService.lockLeft(plot) > 0 then
		return true, "This base is 🔒 locked!"
	end
	return false, nil
end

local function setBarrier(plot)
	local shield = PlotService.shieldLeft(plot) > 0
	local locked = PlotService.lockLeft(plot) > 0
	local barrier = plot.barrier :: BasePart
	if shield or locked then
		barrier.Transparency = 0.35
		barrier.CanCollide = true
		barrier.Color = if shield then SHIELD_COLOR else LOCK_COLOR
	else
		barrier.Transparency = 1
		barrier.CanCollide = false
	end
	plot.model:SetAttribute("Protected", shield or locked)
end

function PlotService.refreshPads(player: Player)
	local plot = byPlayer[player]
	local profile = S.DataService.get(player)
	if not plot or not profile then
		return
	end
	local unlocked = PlotService.maxPads(player)
	for i, pad in plot.pads do
		local on = i <= unlocked
		pad.glow.Color = if on then PAD_ON else PAD_OFF
		pad.part.Color = if on then Color3.fromRGB(245, 245, 250) else Color3.fromRGB(150, 150, 160)
	end
end

function PlotService.maxPads(player: Player): number
	local profile = S.DataService.get(player)
	if not profile then
		return Config.Tuning.BasePads
	end
	return Economy.maxPads(profile.data.rebirths, S.MonetizationService.has(player, "ExtraPads"))
end

function PlotService.setPadStored(plot, padIndex: number, amount: number)
	local pad = plot.pads[padIndex]
	if not pad then
		return
	end
	if amount >= 1 then
		pad.storedLabel.Text = Format.cash(amount)
		pad.storedGui.Enabled = true
	else
		pad.storedGui.Enabled = false
	end
end

function PlotService.setPadOccupied(plot, padIndex: number, occupied: boolean)
	local pad = plot.pads[padIndex]
	if pad then
		pad.collect.Transparency = if occupied then 0.1 else 1
		if not occupied then
			pad.storedGui.Enabled = false
		end
	end
end

function PlotService.lock(player: Player)
	local plot = byPlayer[player]
	if not plot then
		return { ok = false }
	end
	if S.EventService.locksDisabled() then
		S.PlayerService.notify(player, "🌙 Locks are down during the Goo Moon!", "warning")
		return { ok = false }
	end
	local t = now()
	if plot.lockedUntil > t then
		return { ok = false }
	end
	if plot.lockCooldownUntil > t then
		S.PlayerService.notify(player, "Lock recharging: " .. Format.time(plot.lockCooldownUntil - t), "warning")
		return { ok = false }
	end
	local duration = Config.Tuning.LockSeconds * (if S.MonetizationService.has(player, "LongLock") then 2 else 1)
	plot.lockedUntil = t + duration
	plot.lockCooldownUntil = plot.lockedUntil + Config.Tuning.LockCooldown
	plot.model:SetAttribute("LockedUntil", plot.lockedUntil)
	setBarrier(plot)
	S.PlayerService.notify(player, "🔒 Base locked for " .. Format.time(duration), "success")
	S.PlayerService.fx(player, "sound", { name = "Click" })
	S.RewardService.tutorialStep(player, 4)
	S.PlayerService.sync(player, PlotService.state(player))
	return { ok = true }
end

function PlotService.unlockAll()
	for _, plot in S.WorldBuilder.Plots do
		setBarrier(plot)
	end
end

function PlotService.onShieldChanged(player: Player)
	local plot = byPlayer[player]
	if plot then
		setBarrier(plot)
	end
end

function PlotService.state(player: Player)
	local plot = byPlayer[player]
	if not plot then
		return {}
	end
	return {
		plotIndex = plot.index,
		lockedUntil = plot.lockedUntil,
		lockCooldownUntil = plot.lockCooldownUntil,
		maxPads = PlotService.maxPads(player),
	}
end

local function assign(player: Player)
	for _, plot in S.WorldBuilder.Plots do
		if not plot.owner then
			plot.owner = player
			plot.lockedUntil = 0
			plot.lockCooldownUntil = 0
			plot.model:SetAttribute("OwnerId", player.UserId)
			plot.model:SetAttribute("LockedUntil", 0)
			plot.signLabel.Text = player.DisplayName .. "'s Base"
			player:SetAttribute("PlotIndex", plot.index)
			byPlayer[player] = plot
			PlotService.refreshPads(player)
			setBarrier(plot)
			return plot
		end
	end
	return nil
end

local function free(player: Player)
	local plot = byPlayer[player]
	if not plot then
		return
	end
	byPlayer[player] = nil
	plot.owner = nil
	plot.lockedUntil = 0
	plot.model:SetAttribute("OwnerId", 0)
	plot.signLabel.Text = "Empty Base"
	for i in plot.pads do
		PlotService.setPadOccupied(plot, i, false)
		plot.pads[i].glow.Color = PAD_OFF
	end
	setBarrier(plot)
	plot.lockLabel.Text = "🔒 LOCK BASE"
end

local function ejectIntruders(plot)
	for _, other in Players:GetPlayers() do
		if other ~= plot.owner then
			local character = other.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") and PlotService.isInside(plot, root.Position) then
				character:PivotTo(plot.outside)
			end
		end
	end
end

local function hookPlot(plot)
	local lastTouch = {}
	for i, pad in plot.pads do
		pad.collect.Touched:Connect(function(hit)
			if not plot.owner then
				return
			end
			local player = playerFromHit(hit)
			if player ~= plot.owner then
				return
			end
			local t = os.clock()
			if (lastTouch[i] or 0) + 0.25 > t then
				return
			end
			lastTouch[i] = t
			S.EconomyService.collectPad(player, i)
		end)
	end
	local lastLockTouch = 0
	plot.lockButton.Touched:Connect(function(hit)
		local player = playerFromHit(hit)
		if not player or player ~= plot.owner or plot.lockedUntil > now() then
			return
		end
		-- Touched fires many times while standing on the button
		if os.clock() - lastLockTouch < 2 then
			return
		end
		lastLockTouch = os.clock()
		PlotService.lock(player)
	end)
end

function PlotService.init(services)
	S = services
	for _, plot in S.WorldBuilder.Plots do
		plot.lockedUntil = 0
		plot.lockCooldownUntil = 0
		hookPlot(plot)
	end
	S.PlayerService.onReady(function(player)
		if not assign(player) then
			player:Kick("This server is full. Please join another server!")
		end
	end)
	S.PlayerService.onLeaving(free)
	S.PlayerService.registerAction("lock", function(player)
		return PlotService.lock(player)
	end)
	S.PlayerService.addState(function(player)
		return PlotService.state(player)
	end)
end

function PlotService.start()
	while true do
		task.wait(0.5)
		local t = now()
		for _, plot in S.WorldBuilder.Plots do
			if plot.owner then
				local protected = PlotService.isProtected(plot)
				setBarrier(plot)
				if protected then
					ejectIntruders(plot)
				end
				local shield = PlotService.shieldLeft(plot)
				local lock = PlotService.lockLeft(plot)
				if shield > 0 then
					plot.lockLabel.Text = "🛡️ SHIELD " .. Format.time(shield)
				elseif lock > 0 then
					plot.lockLabel.Text = "🔒 LOCKED " .. Format.time(lock)
				elseif S.EventService.locksDisabled() then
					plot.lockLabel.Text = "🌙 LOCKS DOWN"
				elseif plot.lockCooldownUntil > t then
					plot.lockLabel.Text = "⏳ " .. Format.time(plot.lockCooldownUntil - t)
				else
					plot.lockLabel.Text = "🔓 STEP TO LOCK"
				end
			end
		end
	end
end

return PlotService
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX3D47F0816E1043A3B199E20DFD8B3B8B">
        <Properties>
          <string name="Name">RewardService</string>
          <ProtectedString name="Source"><![CDATA[-- Retention systems: 7-day login streak, session playtime gifts, 3 daily
-- quests, codes, group bonus and onboarding steps. Every reward is free; cash
-- rewards scale with the player's income so they stay meaningful.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))
local Format = require(Shared:WaitForChild("Format"))
local Rarities = require(Shared:WaitForChild("Rarities"))
local RewardDefs = require(Shared:WaitForChild("RewardDefs"))
local Slimes = require(Shared:WaitForChild("Slimes"))

local RewardService = {}

local S
local rng = Random.new()
local sessions: { [Player]: { start: number, claimed: { [number]: boolean } } } = {}

RewardService.Daily = RewardDefs.Daily
RewardService.Gifts = RewardDefs.Gifts

local QUEST_POOL = {
	{ kind = "buy", target = 12, text = "Buy %s slimes", reward = { cashMinutes = 10, minCash = 2000 } },
	{ kind = "collect", target = 0, text = "Collect %s cash", reward = { boostMinutes = 10 } },
	{ kind = "steal", target = 2, text = "Steal %s slimes", reward = { cashMinutes = 20, minCash = 5000 } },
	{ kind = "fuse", target = 1, text = "Fuse %s slime", reward = { cashMinutes = 15, minCash = 4000 } },
	{ kind = "levelup", target = 8, text = "Level up slimes %s times", reward = { cashMinutes = 12, minCash = 3000 } },
	{ kind = "bonk", target = 3, text = "Bonk %s thieves", reward = { boostMinutes = 15 } },
	{ kind = "playtime", target = 20, text = "Play for %s minutes", reward = { slimeMinRarity = "Rare" } },
}

local function today(): number
	return os.time() // 86400
end

local function profileOf(player: Player)
	return S.DataService.get(player)
end

-- reward: { cashMinutes?, minCash?, cash?, boostMinutes?, slimeMinRarity? }
-- Returns a short description of what was granted.
function RewardService.grant(player: Player, reward, sku: string): string
	local parts = {}
	if reward.cashMinutes or reward.minCash or reward.cash then
		local amount = reward.cash
			or Economy.scaledCash(S.EconomyService.baseIncomePerSecond(player), reward.cashMinutes or 0, reward.minCash or 0)
		S.EconomyService.addCash(player, amount, sku, "TimedReward")
		table.insert(parts, Format.cash(amount))
	end
	if reward.boostMinutes then
		S.EconomyService.addBoost(player, "cash2x", reward.boostMinutes * 60)
		table.insert(parts, "2x Cash " .. reward.boostMinutes .. "m")
	end
	if reward.slimeMinRarity then
		local minRank = Rarities.ByKey[reward.slimeMinRarity].rank
		local id, mut = Economy.rollSpawn(rng, 1, 1, minRank)
		local slime = S.SlimeService.grantSlime(player, id, mut, { allowOverflow = true })
		if slime then
			table.insert(parts, Slimes.ById[id].name .. " (" .. Slimes.ById[id].rarity .. ")")
		else
			local amount = Economy.slimePrice(id, mut)
			S.EconomyService.addCash(player, amount, sku .. "_SlimeCash", "TimedReward")
			table.insert(parts, Format.cash(amount))
		end
	end
	local text = table.concat(parts, " + ")
	S.PlayerService.fx(player, "celebrate", { text = text })
	return text
end

function RewardService.tutorialStep(player: Player, step: number)
	local profile = profileOf(player)
	if not profile or profile.data.tutorial >= step then
		return
	end
	profile.data.tutorial = step
	S.Analytics.onboarding(player, step + 1, "Step" .. step)
	S.PlayerService.sync(player, { tutorial = step })
end

---------------------------------------------------------------------------
-- Daily streak
---------------------------------------------------------------------------
local function dailyState(profile)
	local daily = profile.data.daily
	local t = today()
	local streakAlive = daily.lastDay >= t - 1
	local nextStreak = if daily.lastDay == t then daily.streak elseif streakAlive then daily.streak + 1 else 1
	return {
		streak = daily.streak,
		canClaim = daily.lastDay < t,
		nextDay = (nextStreak - 1) % #RewardService.Daily + 1,
		resetIn = (t + 1) * 86400 - os.time(),
	}
end

local function claimDaily(player: Player)
	local profile = profileOf(player)
	local daily = profile.data.daily
	local t = today()
	if daily.lastDay >= t then
		return { ok = false, msg = "Come back tomorrow!" }
	end
	daily.streak = if daily.lastDay == t - 1 then daily.streak + 1 else 1
	daily.lastDay = t
	local day = (daily.streak - 1) % #RewardService.Daily + 1
	local text = RewardService.grant(player, RewardService.Daily[day], "Daily" .. day)
	S.PlayerService.notify(player, "📅 Day " .. day .. " reward: " .. text, "success")
	S.PlayerService.sync(player, { daily = dailyState(profile) })
	return { ok = true }
end

---------------------------------------------------------------------------
-- Session gifts
---------------------------------------------------------------------------
local function giftState(player: Player)
	local session = sessions[player]
	if not session then
		return nil
	end
	local claimed = {}
	for i in session.claimed do
		table.insert(claimed, i)
	end
	return {
		startedAt = workspace:GetServerTimeNow() - (os.clock() - session.start),
		claimed = claimed,
	}
end

local function claimGift(player: Player, index: any)
	local session = sessions[player]
	local gift = RewardService.Gifts[tonumber(index) or 0]
	if not session or not gift then
		return { ok = false }
	end
	if session.claimed[index] then
		return { ok = false, msg = "Already claimed!" }
	end
	if (os.clock() - session.start) < gift.at * 60 then
		return { ok = false, msg = "Not ready yet!" }
	end
	session.claimed[index] = true
	local text = RewardService.grant(player, gift.reward, "Gift" .. index)
	S.PlayerService.notify(player, "🎁 Gift: " .. text, "success")
	S.PlayerService.sync(player, { gifts = giftState(player) })
	return { ok = true }
end

---------------------------------------------------------------------------
-- Quests
---------------------------------------------------------------------------
local function questState(profile)
	return profile.data.quests.list
end

local function ensureQuests(player: Player, profile)
	local quests = profile.data.quests
	local t = today()
	if quests.day == t and #quests.list > 0 then
		return
	end
	local seeded = Random.new(player.UserId * 7 + t)
	local pool = table.clone(QUEST_POOL)
	local list = {}
	for _ = 1, 3 do
		local def = table.remove(pool, seeded:NextInteger(1, #pool))
		local target = def.target
		if def.kind == "collect" then
			target = math.max(1500, math.floor(S.EconomyService.baseIncomePerSecond(player) * 60 * 15))
		end
		table.insert(list, {
			kind = def.kind,
			target = target,
			progress = 0,
			text = string.format(def.text, if def.kind == "collect" then Format.cash(target) else tostring(target)),
			reward = def.reward,
			done = false,
			claimed = false,
		})
	end
	quests.day = t
	quests.list = list
end

function RewardService.progress(player: Player, kind: string, amount: number)
	local profile = profileOf(player)
	if not profile then
		return
	end
	local changed = false
	for _, quest in profile.data.quests.list do
		if quest.kind == kind and not quest.done then
			quest.progress = math.min(quest.target, quest.progress + amount)
			changed = true
			if quest.progress >= quest.target then
				quest.done = true
				S.PlayerService.notify(player, "📜 Quest complete: " .. quest.text .. "! Claim your reward.", "success")
			end
		end
	end
	if changed then
		S.PlayerService.sync(player, { quests = questState(profile) })
	end
end

local function claimQuest(player: Player, index: any)
	local profile = profileOf(player)
	local quest = profile.data.quests.list[tonumber(index) or 0]
	if not quest or not quest.done or quest.claimed then
		return { ok = false }
	end
	quest.claimed = true
	local text = RewardService.grant(player, quest.reward, "Quest_" .. quest.kind)
	S.PlayerService.notify(player, "📜 Quest reward: " .. text, "success")
	S.PlayerService.sync(player, { quests = questState(profile) })
	return { ok = true }
end

---------------------------------------------------------------------------
-- Codes & group
---------------------------------------------------------------------------
local function redeem(player: Player, raw: any)
	if type(raw) ~= "string" or #raw > 40 then
		return { ok = false, msg = "Invalid code" }
	end
	local code = string.upper((string.gsub(raw, "%s", "")))
	local def = Config.Codes[code]
	local profile = profileOf(player)
	if not def then
		return { ok = false, msg = "Invalid code" }
	end
	if profile.data.codes[code] then
		return { ok = false, msg = "Already redeemed!" }
	end
	if def.expires and os.time() > def.expires then
		return { ok = false, msg = "This code has expired" }
	end
	profile.data.codes[code] = true
	local text = RewardService.grant(player, def, "Code_" .. code)
	S.PlayerService.notify(player, "🔑 Code redeemed: " .. text, "success")
	return { ok = true, msg = text }
end

local function checkGroup(player: Player): boolean
	if Config.GroupId <= 0 then
		return false
	end
	local ok, inGroup = pcall(function()
		return player:IsInGroupAsync(Config.GroupId)
	end)
	local member = ok and inGroup == true
	player:SetAttribute("InGroup", member)
	return member
end

function RewardService.init(services)
	S = services
	S.PlayerService.onReady(function(player, profile)
		sessions[player] = { start = os.clock(), claimed = {} }
		ensureQuests(player, profile)
		checkGroup(player)
	end)
	S.PlayerService.onLeaving(function(player)
		sessions[player] = nil
	end)
	S.PlayerService.addState(function(player, profile)
		return {
			daily = dailyState(profile),
			gifts = giftState(player),
			quests = questState(profile),
			inGroup = player:GetAttribute("InGroup") == true,
			groupId = Config.GroupId,
			socialText = Config.SocialText,
		}
	end)
	S.PlayerService.registerAction("claimDaily", claimDaily)
	S.PlayerService.registerAction("claimGift", claimGift)
	S.PlayerService.registerAction("claimQuest", claimQuest)
	S.PlayerService.registerAction("redeem", redeem)
	S.PlayerService.registerAction("checkGroup", function(player)
		local was = player:GetAttribute("InGroup") == true
		local now = checkGroup(player)
		if now and not was then
			S.PlayerService.notify(player, "👥 Thanks for joining! +" .. math.floor(Config.GroupBonus * 100) .. "% cash forever!",
				"success")
		end
		return { ok = true, inGroup = now }
	end)
end

function RewardService.start()
	while true do
		task.wait(60)
		for _, player in S.PlayerService.readyPlayers() do
			local profile = profileOf(player)
			if profile then
				ensureQuests(player, profile)
				RewardService.progress(player, "playtime", 1)
			end
		end
	end
end

return RewardService
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXA5DE50865E904E629FAB9D5D0CDE27BC">
        <Properties>
          <string name="Name">SlimeService</string>
          <ProtectedString name="Source"><![CDATA[-- Conveyor spawning, buying (cash or Robux instant-buy of the visible slime),
-- base pads, selling, fusion and growth visuals.
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))
local Format = require(Shared:WaitForChild("Format"))
local Mutations = require(Shared:WaitForChild("Mutations"))
local New = require(Shared:WaitForChild("New"))
local Rarities = require(Shared:WaitForChild("Rarities"))
local SlimeModel = require(Shared:WaitForChild("SlimeModel"))
local Slimes = require(Shared:WaitForChild("Slimes"))

local Tuning = Config.Tuning
local SlimeService = {}

local S
local rng = Random.new()
local belt = {} -- [beltUid] = entry
local beltCount = 0
local beltCounter = 0
local models: { [Player]: { [string]: Model } } = {}
local pendingInstant: { [Player]: any } = {}

local INSTANT_RESERVE_SECONDS = 25

local function profileOf(player: Player)
	return S.DataService.get(player)
end

function SlimeService.find(player: Player, uid: string)
	local profile = profileOf(player)
	if not profile then
		return nil
	end
	for i, slime in profile.data.slimes do
		if slime.uid == uid then
			return slime, i
		end
	end
	return nil
end

function SlimeService.getModel(player: Player, uid: string): Model?
	local list = models[player]
	return list and list[uid]
end

function SlimeService.syncSlimes(player: Player)
	local profile = profileOf(player)
	if not profile then
		return
	end
	S.PlayerService.sync(player, { slimes = profile.data.slimes, index = profile.data.index })
end

-- First free pad index. allowOverflow lets paid grants use pads beyond the
-- unlocked count so a purchase is never lost.
function SlimeService.freePad(player: Player, allowOverflow: boolean?): number?
	local profile = profileOf(player)
	if not profile then
		return nil
	end
	local used = {}
	for _, slime in profile.data.slimes do
		used[slime.pad] = true
	end
	local limit = if allowOverflow then Economy.maxPossiblePads() else S.PlotService.maxPads(player)
	for i = 1, limit do
		if not used[i] then
			return i
		end
	end
	return nil
end

local function padCFrame(plot, padIndex: number, model: Model): CFrame
	local pad = plot.pads[padIndex]
	local position = pad.top.Position + Vector3.new(0, SlimeModel.restHeight(model), 0)
	local outward = -plot.cf.LookVector
	return CFrame.lookAt(position, position + outward)
end

local function addPrompt(parent: Instance, props, mode: string, ownerId: number)
	props.RequiresLineOfSight = false
	props.MaxActivationDistance = props.MaxActivationDistance or 10
	local prompt = New("ProximityPrompt", props)
	prompt:SetAttribute("Mode", mode)
	prompt:SetAttribute("OwnerId", ownerId)
	prompt.Parent = parent
	return prompt
end

local function placeModel(player: Player, slime)
	local plot = S.PlotService.get(player)
	if not plot or not plot.pads[slime.pad] then
		return
	end
	local list = models[player]
	if not list then
		list = {}
		models[player] = list
	end
	if list[slime.uid] then
		list[slime.uid]:Destroy()
	end
	local def = Slimes.ById[slime.id]
	local model = SlimeModel.build(slime.id, slime.mut, slime.lvl, "pad")
	model:SetAttribute("Uid", slime.uid)
	model:SetAttribute("OwnerId", player.UserId)
	model:SetAttribute("Shield", slime.shield or 0)
	local cf = padCFrame(plot, slime.pad, model)
	model:PivotTo(cf)
	model:SetAttribute("BaseCFrame", cf)
	local body = model.PrimaryPart :: BasePart
	local steal = addPrompt(body, {
		Name = "Steal",
		ActionText = "Steal",
		ObjectText = def.name,
		HoldDuration = Tuning.StealHoldSeconds,
		KeyboardKeyCode = Enum.KeyCode.E,
	}, "steal", player.UserId)
	steal.Triggered:Connect(function(thief)
		if thief ~= player then
			S.CarryService.tryStealing(thief, player, slime.uid)
		end
	end)
	local sell = addPrompt(body, {
		Name = "Sell",
		ActionText = "Sell " .. Format.cash(Economy.sellValue(slime)),
		ObjectText = def.name,
		HoldDuration = 1.2,
		KeyboardKeyCode = Enum.KeyCode.R,
	}, "sell", player.UserId)
	sell.Triggered:Connect(function(who)
		if who == player then
			SlimeService.sell(player, slime.uid)
		end
	end)
	model.Parent = workspace:FindFirstChild("BaseSlimes")
	list[slime.uid] = model
	S.PlotService.setPadOccupied(plot, slime.pad, true)
end

function SlimeService.removeModel(player: Player, uid: string)
	local list = models[player]
	local model = list and list[uid]
	if model then
		model:Destroy()
		list[uid] = nil
	end
end

local function discover(player: Player, profile, id: string, mut: string)
	local entry = profile.data.index[id]
	local firstOfType = entry == nil
	if not entry then
		entry = {}
		profile.data.index[id] = entry
	end
	if not entry[mut] then
		entry[mut] = true
		local def = Slimes.ById[id]
		local label = (if mut ~= "None" then mut .. " " else "") .. def.name
		S.PlayerService.notify(player, "📖 New discovery: " .. label .. (if firstOfType then " (+1% cash forever!)" else ""),
			"success")
	end
end

-- opts: { pad = number?, level = number?, shieldSeconds = number?, allowOverflow = boolean? }
function SlimeService.grantSlime(player: Player, id: string, mut: string, opts)
	opts = opts or {}
	local profile = profileOf(player)
	if not profile or not Slimes.ById[id] then
		return nil
	end
	local pad = opts.pad or SlimeService.freePad(player, opts.allowOverflow)
	if not pad then
		return nil
	end
	local slime = {
		uid = S.DataService.nextUid(profile),
		id = id,
		mut = if Mutations.ByKey[mut] then mut else "None",
		lvl = math.clamp(opts.level or 1, 1, Economy.LEVEL_MAX),
		xp = 0,
		pad = pad,
		shield = if opts.shieldSeconds then os.time() + opts.shieldSeconds else nil,
	}
	table.insert(profile.data.slimes, slime)
	discover(player, profile, slime.id, slime.mut)
	placeModel(player, slime)
	SlimeService.syncSlimes(player)
	return slime
end

function SlimeService.removeSlime(player: Player, uid: string)
	local profile = profileOf(player)
	local slime, i = SlimeService.find(player, uid)
	if not slime then
		return nil
	end
	table.remove(profile.data.slimes, i)
	SlimeService.removeModel(player, uid)
	S.EconomyService.clearPad(player, slime.pad)
	local plot = S.PlotService.get(player)
	if plot then
		S.PlotService.setPadOccupied(plot, slime.pad, false)
	end
	SlimeService.syncSlimes(player)
	return slime
end

-- Re-creates the model of a slime that was carried and dropped.
function SlimeService.restoreModel(player: Player, slime)
	slime.carried = nil
	placeModel(player, slime)
end

function SlimeService.onLevelUp(player: Player, slime)
	local model = SlimeService.getModel(player, slime.uid)
	local plot = S.PlotService.get(player)
	if model and plot then
		SlimeModel.setLevel(model, slime.lvl)
		local cf = padCFrame(plot, slime.pad, model)
		model:PivotTo(cf)
		model:SetAttribute("BaseCFrame", cf)
		local sell = (model.PrimaryPart :: BasePart):FindFirstChild("Sell")
		if sell and sell:IsA("ProximityPrompt") then
			sell.ActionText = "Sell " .. Format.cash(Economy.sellValue(slime))
		end
		S.PlayerService.fx(player, "levelup", { position = (model.PrimaryPart :: BasePart).Position, level = slime.lvl })
	end
	if slime.lvl >= Economy.LEVEL_MAX then
		S.PlayerService.notify(player, "🌟 " .. Slimes.ById[slime.id].name .. " reached MAX level!", "success")
	end
	S.RewardService.progress(player, "levelup", 1)
	SlimeService.syncSlimes(player)
end

function SlimeService.sell(player: Player, uid: string)
	local slime = SlimeService.find(player, uid)
	if not slime or slime.carried then
		return { ok = false }
	end
	local value = Economy.sellValue(slime)
	SlimeService.removeSlime(player, uid)
	S.EconomyService.addCash(player, value, "Sell_" .. slime.id, "Gameplay")
	local profile = profileOf(player)
	profile.data.stats.sold += 1
	S.PlayerService.notify(player, "Sold " .. Slimes.ById[slime.id].name .. " for " .. Format.cash(value), "success")
	S.PlayerService.fx(player, "sound", { name = "Cash" })
	return { ok = true }
end

-- 3 slimes of the same kind -> 1 with the next mutation (keeps the best level).
-- Uses the 3 weakest copies so the player's best one survives untouched.
function SlimeService.fuse(player: Player, slimeId: string)
	local profile = profileOf(player)
	if type(slimeId) ~= "string" or not Slimes.ById[slimeId] then
		return { ok = false }
	end
	local copies = {}
	for _, slime in profile.data.slimes do
		if slime.id == slimeId and not slime.carried then
			table.insert(copies, slime)
		end
	end
	if #copies < 3 then
		return { ok = false, msg = "You need 3 of the same slime to fuse." }
	end
	table.sort(copies, function(a, b)
		local ra, rb = Mutations.ByKey[a.mut].rank, Mutations.ByKey[b.mut].rank
		if ra ~= rb then
			return ra < rb
		end
		return a.lvl < b.lvl
	end)
	local used = { copies[1], copies[2], copies[3] }
	local bestMut, bestLevel = "None", 1
	for _, slime in used do
		if Mutations.ByKey[slime.mut].rank > Mutations.ByKey[bestMut].rank then
			bestMut = slime.mut
		end
		bestLevel = math.max(bestLevel, slime.lvl)
	end
	local result = Mutations.next(bestMut)
	if result == bestMut then
		return { ok = false, msg = "These slimes already have the best mutation!" }
	end
	local pad = used[1].pad
	for _, slime in used do
		SlimeService.removeSlime(player, slime.uid)
	end
	local fused = SlimeService.grantSlime(player, slimeId, result, { pad = pad, level = bestLevel })
	profile.data.stats.fused += 1
	S.RewardService.progress(player, "fuse", 1)
	local def = Slimes.ById[slimeId]
	S.PlayerService.notify(player, "✨ Fused into " .. result .. " " .. def.name .. "!", "success")
	local model = fused and SlimeService.getModel(player, fused.uid)
	if model then
		S.PlayerService.fx(player, "fuse", { position = (model.PrimaryPart :: BasePart).Position })
	end
	return { ok = true }
end

local function destroyBeltEntry(entry, poof: boolean)
	belt[entry.uid] = nil
	beltCount -= 1
	if entry.tween then
		entry.tween:Cancel()
	end
	if poof and entry.model.PrimaryPart then
		S.PlayerService.fxAll("poof", { position = entry.model.PrimaryPart.Position })
	end
	entry.model:Destroy()
end

function SlimeService.buyFromBelt(player: Player, uid: string)
	local entry = belt[uid]
	if not entry or not S.PlayerService.isReady(player) then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local body = entry.model.PrimaryPart
	if not root or not root:IsA("BasePart") or not body or (root.Position - body.Position).Magnitude > 22 then
		return
	end
	if entry.reservedBy and entry.reservedBy ~= player and entry.reservedUntil > os.clock() then
		S.PlayerService.notify(player, "Someone is buying this slime right now!", "warning")
		return
	end
	local pad = SlimeService.freePad(player)
	if not pad then
		S.PlayerService.notify(player, "Your base is full! Sell, fuse or rebirth for more pads.", "error")
		S.PlayerService.fx(player, "baseFull", {})
		return
	end
	local profile = profileOf(player)
	if profile.data.cash < entry.price then
		S.PlayerService.notify(player, "You need " .. Format.cash(entry.price - profile.data.cash) .. " more!", "error")
		S.PlayerService.fx(player, "noCash", { need = entry.price - profile.data.cash })
		return
	end
	if not S.EconomyService.spend(player, entry.price, "Slime_" .. entry.id) then
		return
	end
	destroyBeltEntry(entry, true)
	SlimeService.grantSlime(player, entry.id, entry.mut, { pad = pad })
	profile.data.stats.bought += 1
	S.RewardService.progress(player, "buy", 1)
	S.RewardService.tutorialStep(player, 1)
	S.PlayerService.fx(player, "sound", { name = "Buy" })
	local rarity = Rarities.ByKey[entry.rarity]
	if rarity.rank >= 5 then
		S.PlayerService.notifyAll(string.format("%s bought a %s %s!", player.DisplayName, entry.rarity,
			Slimes.ById[entry.id].name), "event")
	end
end

function SlimeService.requestInstant(player: Player, uid: string)
	local entry = belt[uid]
	if not entry then
		return
	end
	local productKey = "Instant" .. entry.rarity
	if not S.MonetizationService.isConfigured("product", productKey) then
		return
	end
	if not SlimeService.freePad(player, true) then
		S.PlayerService.notify(player, "Your base is completely full!", "error")
		return
	end
	if entry.reservedBy and entry.reservedBy ~= player and entry.reservedUntil > os.clock() then
		S.PlayerService.notify(player, "Someone else is buying this slime!", "warning")
		return
	end
	entry.reservedBy = player
	entry.reservedUntil = os.clock() + INSTANT_RESERVE_SECONDS
	pendingInstant[player] = { id = entry.id, mut = entry.mut, uid = uid, product = productKey }
	S.MonetizationService.promptProduct(player, productKey)
end

-- Receipt handler for Instant* products. Grants the exact slime the buyer saw;
-- if the server lost that context (e.g. it restarted) the fallback is the base
-- slime of that rarity, as stated in the product description.
function SlimeService.grantInstant(player: Player, productKey: string, rarityKey: string)
	local pending = pendingInstant[player]
	local id, mut
	if pending and pending.product == productKey then
		id, mut = pending.id, pending.mut
		pendingInstant[player] = nil
		local entry = belt[pending.uid]
		if entry then
			destroyBeltEntry(entry, true)
		end
	else
		id, mut = Slimes.ByRarity[rarityKey][1].id, "None"
	end
	local slime = SlimeService.grantSlime(player, id, mut, {
		allowOverflow = true,
		shieldSeconds = Tuning.RobuxSlimeShieldMinutes * 60,
	})
	if not slime then
		-- all pads full: never lose a purchase, pay out generously in cash instead
		S.EconomyService.addCash(player, Economy.slimePrice(id, mut) * 2, "InstantOverflow", "IAP")
		S.PlayerService.notify(player, "Base full! You got " .. Format.cash(Economy.slimePrice(id, mut) * 2)
			.. " instead.", "warning")
		return
	end
	S.PlayerService.notifyAll(string.format("💎 %s instantly got a %s %s!", player.DisplayName, rarityKey,
		Slimes.ById[id].name), "purchase")
	S.PlayerService.fx(player, "celebrate", { text = Slimes.ById[id].name .. "!" })
end

function SlimeService.spawnOnBelt(id: string, mut: string)
	local def = Slimes.ById[id]
	local rarity = Rarities.ByKey[def.rarity]
	beltCounter += 1
	local uid = "b" .. beltCounter
	local price = Economy.slimePrice(id, mut)
	local model = SlimeModel.build(id, mut, 1, "belt")
	SlimeModel.makeBillboard(model, { price = price })
	model:SetAttribute("BeltUid", uid)
	local height = SlimeModel.restHeight(model)
	local start = S.WorldBuilder.BeltStart + Vector3.new(0, height, 0)
	local finish = S.WorldBuilder.BeltEnd + Vector3.new(0, height, 0)
	model:PivotTo(CFrame.lookAt(start, finish))
	local body = model.PrimaryPart :: BasePart
	local entry = { uid = uid, id = id, mut = mut, price = price, model = model, rarity = def.rarity }
	local label = (if mut ~= "None" then mut .. " " else "") .. def.name

	local buy = addPrompt(body, {
		Name = "Buy",
		ActionText = "Buy " .. Format.cash(price),
		ObjectText = label .. " (" .. def.rarity .. ")",
		HoldDuration = 0.2,
		KeyboardKeyCode = Enum.KeyCode.E,
		MaxActivationDistance = 12,
	}, "buy", 0)
	buy.Triggered:Connect(function(player)
		SlimeService.buyFromBelt(player, uid)
	end)
	if rarity.rank >= Rarities.ByKey.Epic.rank and S.MonetizationService.isConfigured("product", "Instant" .. def.rarity) then
		local instant = addPrompt(body, {
			Name = "Instant",
			ActionText = "💎 Instant Buy",
			ObjectText = "Robux",
			HoldDuration = 0,
			KeyboardKeyCode = Enum.KeyCode.F,
			GamepadKeyCode = Enum.KeyCode.ButtonY,
			MaxActivationDistance = 12,
			UIOffset = Vector2.new(0, 72),
		}, "instant", 0)
		instant:SetAttribute("Product", "Instant" .. def.rarity)
		instant.Triggered:Connect(function(player)
			SlimeService.requestInstant(player, uid)
		end)
	end

	model.Parent = workspace:FindFirstChild("BeltSlimes")
	belt[uid] = entry
	beltCount += 1
	local tween = TweenService:Create(body, TweenInfo.new(Tuning.BeltTravelTime, Enum.EasingStyle.Linear), {
		CFrame = CFrame.lookAt(finish, finish + (finish - start).Unit),
	})
	entry.tween = tween
	tween.Completed:Connect(function(state)
		if state == Enum.PlaybackState.Completed and belt[uid] == entry then
			destroyBeltEntry(entry, true)
		end
	end)
	tween:Play()

	if rarity.rank >= Rarities.ByKey.Legendary.rank then
		S.PlayerService.notifyAll(string.format("✨ A %s %s appeared on the belt!", def.rarity, label), "rare")
		S.PlayerService.fxAll("rareSpawn", { rarity = def.rarity, name = label })
	end
	return entry
end

function SlimeService.forceSpawn(rarityKey: string)
	local list = Slimes.ByRarity[rarityKey]
	if not list then
		return false
	end
	local def = list[rng:NextInteger(1, #list)]
	local _, mut = Economy.rollSpawn(rng, 1, S.EventService.mutationMult())
	SlimeService.spawnOnBelt(def.id, mut)
	return true
end

local function restore(player: Player, profile)
	-- repair pad indices (config changes or old data) and place every slime
	local used = {}
	local limit = Economy.maxPossiblePads()
	for _, slime in profile.data.slimes do
		slime.carried = nil
		if type(slime.pad) ~= "number" or used[slime.pad] or slime.pad < 1 or slime.pad > limit then
			slime.pad = nil
		else
			used[slime.pad] = true
		end
	end
	for _, slime in profile.data.slimes do
		if not slime.pad then
			for i = 1, limit do
				if not used[i] then
					slime.pad = i
					used[i] = true
					break
				end
			end
		end
	end
	for i = #profile.data.slimes, 1, -1 do
		local slime = profile.data.slimes[i]
		if not slime.pad or not Slimes.ById[slime.id] then
			table.remove(profile.data.slimes, i)
		else
			placeModel(player, slime)
		end
	end
	if #profile.data.slimes == 0 and profile.data.stats.bought == 0 then
		-- every new player starts with one free slime so the loop is obvious
		SlimeService.grantSlime(player, "blubby", "None", {})
	end
end

local function clear(player: Player)
	local list = models[player]
	if list then
		for _, model in list do
			model:Destroy()
		end
	end
	models[player] = nil
	pendingInstant[player] = nil
	for _, entry in belt do
		if entry.reservedBy == player then
			entry.reservedBy = nil
		end
	end
end

function SlimeService.init(services)
	S = services
	S.PlayerService.onReady(restore)
	S.PlayerService.onLeaving(clear)
	S.PlayerService.registerAction("sell", function(player, uid)
		if type(uid) ~= "string" then
			return { ok = false }
		end
		return SlimeService.sell(player, uid)
	end)
	S.PlayerService.registerAction("fuse", function(player, slimeId)
		return SlimeService.fuse(player, slimeId)
	end)
	S.PlayerService.addState(function(_player, profile)
		return { slimes = profile.data.slimes, index = profile.data.index }
	end)
	MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, _productId, purchased)
		if purchased then
			return
		end
		for player, pending in pendingInstant do
			if player.UserId == userId then
				local entry = belt[pending.uid]
				if entry and entry.reservedBy == player then
					entry.reservedBy = nil
				end
				pendingInstant[player] = nil
			end
		end
	end)
end

function SlimeService.start()
	local lastGuarantee = os.clock()
	while true do
		task.wait(Tuning.SpawnInterval / S.EventService.spawnRateMult())
		if beltCount < 45 and #S.PlayerService.readyPlayers() > 0 then
			local minRank = nil
			if os.clock() - lastGuarantee >= Tuning.GuaranteeEpicSeconds then
				minRank = Rarities.ByKey.Epic.rank
			end
			local id, mut = Economy.rollSpawn(rng, S.EventService.luck(), S.EventService.mutationMult(), minRank)
			if Rarities.ByKey[Slimes.ById[id].rarity].rank >= Rarities.ByKey.Epic.rank then
				lastGuarantee = os.clock()
			end
			local ok, err = pcall(SlimeService.spawnOnBelt, id, mut)
			if not ok then
				warn("[SlimeService] spawn failed: " .. tostring(err))
			end
		end
	end
end

return SlimeService
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX35FF3B0D84104B1B8460AEE65C724EB4">
        <Properties>
          <string name="Name">ToolService</string>
          <ProtectedString name="Source"><![CDATA[-- The Bonk Hammer: everyone gets one. Bonking a thief makes them drop the
-- stolen slime (it flies home) and stuns them; other players just get knocked back.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local New = require(Shared:WaitForChild("New"))

local Tuning = Config.Tuning
local ToolService = {}

local S
local template: Tool
local lastSwing: { [Player]: number } = {}

local TOOL_NAME = "Bonk Hammer"
local REST_GRIP = CFrame.new(0, -1.1, 0)
local SWING_GRIP = CFrame.new(0, -1.1, 0) * CFrame.Angles(math.rad(-80), 0, 0)

local function buildTemplate(): Tool
	local tool = New("Tool", {
		Name = TOOL_NAME,
		RequiresHandle = true,
		CanBeDropped = false,
		ToolTip = "Bonk thieves to get slimes back!",
		Grip = REST_GRIP,
	})
	local handle = New("Part", {
		Name = "Handle",
		Size = Vector3.new(0.5, 3.4, 0.5),
		Color = Color3.fromRGB(150, 100, 60),
		Material = Enum.Material.Wood,
		CanCollide = false,
		Massless = true,
		Parent = tool,
	})
	local head = New("Part", {
		Name = "Head",
		Size = Vector3.new(1.8, 1.8, 2.8),
		Color = Color3.fromRGB(255, 90, 140),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		Massless = true,
		CFrame = handle.CFrame * CFrame.new(0, 1.8, 0),
		Parent = tool,
	})
	New("WeldConstraint", { Part0 = handle, Part1 = head, Parent = head })
	New("Sparkles", { SparkleColor = Color3.fromRGB(255, 180, 220), Enabled = false, Parent = head })
	return tool
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

local function swing(player: Player, tool: Tool)
	local now = os.clock()
	if (lastSwing[player] or 0) + Tuning.BonkCooldown > now then
		return
	end
	lastSwing[player] = now
	local root = rootOf(player)
	if not root then
		return
	end
	local info = TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local down = TweenService:Create(tool, info, { Grip = SWING_GRIP })
	down.Completed:Connect(function()
		TweenService:Create(tool, TweenInfo.new(0.18), { Grip = REST_GRIP }):Play()
	end)
	down:Play()

	local look = root.CFrame.LookVector
	for _, other in S.PlayerService.readyPlayers() do
		local otherRoot = other ~= player and rootOf(other)
		if otherRoot then
			local delta = otherRoot.Position - root.Position
			local distance = delta.Magnitude
			if distance <= Tuning.BonkRange and distance > 0 and look:Dot(delta.Unit) > 0.2 then
				local direction = (delta.Unit + Vector3.new(0, 0.6, 0)).Unit
				S.PlayerService.fxAll("bonk", { position = otherRoot.Position })
				if S.CarryService.isCarrying(other) then
					S.CarryService.drop(other, "bonked by " .. player.DisplayName)
					S.PlayerService.stun(other, Tuning.BonkStunSeconds)
					S.PlayerService.fx(other, "knockback", { direction = direction, power = 75 })
					S.PlayerService.notify(player, "💥 BONK! You stopped " .. other.DisplayName .. "!", "success")
					S.RewardService.progress(player, "bonk", 1)
					local profile = S.DataService.get(player)
					if profile then
						profile.data.stats.bonks += 1
					end
				else
					S.PlayerService.fx(other, "knockback", { direction = direction, power = 40 })
				end
			end
		end
	end
end

function ToolService.equipStarterTools(player: Player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	local character = player.Character
	if not backpack or backpack:FindFirstChild(TOOL_NAME) or (character and character:FindFirstChild(TOOL_NAME)) then
		return
	end
	local tool = template:Clone()
	tool.Activated:Connect(function()
		swing(player, tool)
	end)
	tool.Parent = backpack
end

function ToolService.init(services)
	S = services
	template = buildTemplate()
	S.PlayerService.onLeaving(function(player)
		lastSwing[player] = nil
	end)
end

return ToolService
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX76B0CDD9262742F88E28534BC393B564">
        <Properties>
          <string name="Name">WorldBuilder</string>
          <ProtectedString name="Source"><![CDATA[-- Builds the whole map from code at server start, so the game works from a
-- blank place. Layout (top view, +Z = towards the goo pit):
--
--   [Boards]      [ SLIME PIPE ]                 z = -165
--   Plot1  Plot5      | belt |                   plots: x = -52 (west) / +52 (east)
--   Plot2  Plot6   shop  |  shop                 z centers: -108, -36, 36, 108
--   Plot3  Plot7      |      |
--   Plot4  Plot8   [ GOO PIT ]                   z = +165
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local New = require(Shared:WaitForChild("New"))
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))

local WorldBuilder = {}

local PLOT_W = 64
local PLOT_D = 84
local ENTRANCE_X = 52
local PLOT_Z = { -108, -36, 36, 108 }
local PAD_COLUMNS = { -18, 0, 18 }
local PAD_ROW_START = 14
local PAD_ROW_GAP = 7
local FONT = Enum.Font.FredokaOne

WorldBuilder.BeltStart = Vector3.new(0, 1.5, -150)
WorldBuilder.BeltEnd = Vector3.new(0, 1.5, 150)
WorldBuilder.Plots = {}

local function block(props)
	props.Anchored = true
	props.TopSurface = Enum.SurfaceType.Smooth
	props.BottomSurface = Enum.SurfaceType.Smooth
	if props.Material == nil then
		props.Material = Enum.Material.SmoothPlastic
	end
	return New("Part", props)
end

local function textSurface(part: BasePart, text: string, color: Color3, face: Enum.NormalId?)
	local gui = New("SurfaceGui", {
		Face = face or Enum.NormalId.Front,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 40,
		LightInfluence = 0,
		Parent = part,
	})
	local label = New("TextLabel", {
		Name = "Text",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Font = FONT,
		Text = text,
		TextColor3 = color,
		TextScaled = true,
		Parent = gui,
	})
	New("UIStroke", { Thickness = 3, Color = Color3.fromRGB(20, 20, 30), Parent = label })
	return label
end

local function billboard(adornee: BasePart, size: UDim2, offset: Vector3, text: string, color: Color3, maxDistance: number?)
	local gui = New("BillboardGui", {
		Size = size,
		StudsOffsetWorldSpace = offset,
		MaxDistance = maxDistance or 80,
		LightInfluence = 0,
		Adornee = adornee,
		Parent = adornee,
	})
	local label = New("TextLabel", {
		Name = "Text",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Font = FONT,
		Text = text,
		TextColor3 = color,
		TextScaled = true,
		TextStrokeTransparency = 0.1,
		Parent = gui,
	})
	return gui, label
end

local function setupLighting()
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 2.4
	Lighting.Ambient = Color3.fromRGB(120, 115, 140)
	Lighting.OutdoorAmbient = Color3.fromRGB(160, 155, 175)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.7
	Lighting.GlobalShadows = true
	for _, child in Lighting:GetChildren() do
		if child:IsA("PostEffect") or child:IsA("Atmosphere") or child:IsA("Sky") then
			child:Destroy()
		end
	end
	New("Atmosphere", {
		Density = 0.28,
		Offset = 0.2,
		Color = Color3.fromRGB(200, 215, 255),
		Decay = Color3.fromRGB(150, 120, 200),
		Glare = 0.2,
		Haze = 1.2,
		Parent = Lighting,
	})
	New("Sky", { Name = "Sky", Parent = Lighting })
	New("BloomEffect", { Intensity = 0.5, Size = 28, Threshold = 0.92, Parent = Lighting })
	New("ColorCorrectionEffect", { Name = "Grade", Saturation = 0.18, Contrast = 0.06, Parent = Lighting })
	New("SunRaysEffect", { Intensity = 0.04, Spread = 0.6, Parent = Lighting })
end

local function tree(parent: Instance, position: Vector3, scale: number)
	block({
		Name = "Trunk",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(8 * scale, 2 * scale, 2 * scale),
		CFrame = CFrame.new(position + Vector3.new(0, 4 * scale, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(120, 80, 50),
		Material = Enum.Material.Wood,
		Parent = parent,
	})
	local hue = math.random(25, 40) / 100
	block({
		Name = "Leaves",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(9 * scale, 9 * scale, 9 * scale),
		CFrame = CFrame.new(position + Vector3.new(0, 10 * scale, 0)),
		Color = Color3.fromHSV(hue, 0.6, 0.75),
		Material = Enum.Material.Grass,
		CanCollide = false,
		Parent = parent,
	})
end

local function lamp(parent: Instance, position: Vector3)
	block({
		Name = "Post",
		Size = Vector3.new(0.8, 12, 0.8),
		CFrame = CFrame.new(position + Vector3.new(0, 6, 0)),
		Color = Color3.fromRGB(60, 60, 75),
		Material = Enum.Material.Metal,
		Parent = parent,
	})
	local bulb = block({
		Name = "Bulb",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(2.2, 2.2, 2.2),
		CFrame = CFrame.new(position + Vector3.new(0, 12.6, 0)),
		Color = Color3.fromRGB(255, 235, 170),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = parent,
	})
	New("PointLight", { Range = 22, Brightness = 1.4, Color = Color3.fromRGB(255, 225, 170), Parent = bulb })
end

local function buildGround(world: Instance)
	block({
		Name = "Ground",
		Size = Vector3.new(340, 4, 440),
		CFrame = CFrame.new(0, -2, 0),
		Color = Color3.fromRGB(110, 200, 95),
		Material = Enum.Material.Grass,
		Parent = world,
	})
	-- walkway strips along the belt
	for _, x in { -28, 28 } do
		block({
			Name = "Walkway",
			Size = Vector3.new(36, 0.2, 300),
			CFrame = CFrame.new(x, 0.1, 0),
			Color = Color3.fromRGB(235, 225, 200),
			Material = Enum.Material.Pavement,
			Parent = world,
		})
	end
	-- invisible boundary
	for _, data in {
		{ Vector3.new(340, 60, 2), Vector3.new(0, 30, -221) },
		{ Vector3.new(340, 60, 2), Vector3.new(0, 30, 221) },
		{ Vector3.new(2, 60, 440), Vector3.new(-171, 30, 0) },
		{ Vector3.new(2, 60, 440), Vector3.new(171, 30, 0) },
	} do
		block({ Name = "Boundary", Size = data[1], CFrame = CFrame.new(data[2]), Transparency = 1, Parent = world })
	end
	for z = -200, 200, 28 do
		tree(world, Vector3.new(-160, 0, z), 0.9 + math.random() * 0.4)
		tree(world, Vector3.new(160, 0, z), 0.9 + math.random() * 0.4)
	end
	for z = -140, 140, 35 do
		lamp(world, Vector3.new(-12, 0, z))
		lamp(world, Vector3.new(12, 0, z))
	end
	New("SpawnLocation", {
		Name = "FallbackSpawn",
		Anchored = true,
		Size = Vector3.new(10, 1, 10),
		CFrame = CFrame.new(0, 0.5, 192),
		Color = Color3.fromRGB(255, 255, 255),
		Material = Enum.Material.SmoothPlastic,
		Duration = 0,
		Neutral = true,
		Parent = world,
	})
end

local function buildBelt(world: Instance)
	local belt = New("Model", { Name = "Belt", Parent = world })
	local length = (WorldBuilder.BeltEnd - WorldBuilder.BeltStart).Magnitude
	block({
		Name = "Surface",
		Size = Vector3.new(14, 1.5, length),
		CFrame = CFrame.new(0, 0.75, 0),
		Color = Color3.fromRGB(55, 50, 70),
		Material = Enum.Material.DiamondPlate,
		Parent = belt,
	})
	for _, x in { -7.4, 7.4 } do
		block({
			Name = "Rail",
			Size = Vector3.new(0.8, 2, length),
			CFrame = CFrame.new(x, 1.5, 0),
			Color = Color3.fromRGB(90, 255, 140),
			Material = Enum.Material.Neon,
			Parent = belt,
		})
	end

	-- the Slime Pipe machine (spawn point)
	local pipe = New("Model", { Name = "SlimePipe", Parent = world })
	local housing = block({
		Name = "Housing",
		Size = Vector3.new(30, 22, 16),
		CFrame = CFrame.new(0, 11, -166),
		Color = Color3.fromRGB(120, 70, 200),
		Parent = pipe,
	})
	block({
		Name = "Outlet",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(6, 11, 11),
		CFrame = CFrame.new(0, 6.5, -156) * CFrame.Angles(0, math.rad(90), 0),
		Color = Color3.fromRGB(80, 255, 150),
		Material = Enum.Material.Neon,
		Parent = pipe,
	})
	local sign = block({
		Name = "Sign",
		Size = Vector3.new(26, 7, 1),
		CFrame = CFrame.new(0, 17, -157.6) * CFrame.Angles(0, math.rad(180), 0),
		Color = Color3.fromRGB(40, 25, 70),
		Parent = pipe,
	})
	textSurface(sign, "🟢 SLIME PIPE 🟢", Color3.fromRGB(150, 255, 180))
	New("ProximityPrompt", {
		Name = "OddsPrompt",
		ActionText = "View Odds",
		ObjectText = "Slime Pipe",
		HoldDuration = 0,
		MaxActivationDistance = 22,
		RequiresLineOfSight = false,
		Parent = housing,
	}):SetAttribute("OpenPanel", "Odds")

	-- goo pit at the end of the belt
	block({
		Name = "GooPit",
		Size = Vector3.new(22, 1, 18),
		CFrame = CFrame.new(0, 0.3, 162),
		Color = Color3.fromRGB(60, 255, 120),
		Material = Enum.Material.Neon,
		Transparency = 0.2,
		Parent = world,
	})

	-- shop kiosks
	for _, x in { -30, 30 } do
		local kiosk = block({
			Name = "ShopKiosk",
			Size = Vector3.new(10, 8, 10),
			CFrame = CFrame.new(x, 4, 0),
			Color = Color3.fromRGB(255, 170, 60),
			Parent = world,
		})
		block({
			Name = "Roof",
			Size = Vector3.new(13, 1, 13),
			CFrame = CFrame.new(x, 8.5, 0),
			Color = Color3.fromRGB(255, 80, 120),
			Parent = world,
		})
		billboard(kiosk, UDim2.fromScale(10, 3), Vector3.new(0, 8, 0), "🛒 SHOP", Color3.fromRGB(255, 240, 120), 120)
		New("ProximityPrompt", {
			Name = "ShopPrompt",
			ActionText = "Open Shop",
			ObjectText = "Slime Shop",
			HoldDuration = 0,
			MaxActivationDistance = 14,
			RequiresLineOfSight = false,
			Parent = kiosk,
		}):SetAttribute("OpenPanel", "Shop")
	end

	-- leaderboard boards (filled by LeaderboardService)
	local boards = New("Folder", { Name = "Leaderboards", Parent = world })
	for i, info in { { "Earned", "💰 TOP EARNERS", -34 }, { "Rebirths", "⭐ TOP REBIRTHS", 34 } } do
		local board = block({
			Name = info[1],
			Size = Vector3.new(22, 28, 1),
			CFrame = CFrame.new(info[3], 15, -178),
			Color = Color3.fromRGB(35, 30, 55),
			Parent = boards,
		})
		board:SetAttribute("Title", info[2])
		board:SetAttribute("Order", i)
		block({
			Name = "Stand",
			Size = Vector3.new(2, 2, 2),
			CFrame = CFrame.new(info[3], 1, -178),
			Color = Color3.fromRGB(60, 55, 80),
			Parent = boards,
		})
	end
end

local function buildPlot(world: Instance, index: number, entrance: Vector3, inward: Vector3)
	local cf = CFrame.lookAt(entrance, entrance + inward)
	local model = New("Model", { Name = "Plot" .. index })
	model:SetAttribute("PlotIndex", index)
	model:SetAttribute("OwnerId", 0)
	local function at(x: number, y: number, depth: number): CFrame
		return cf * CFrame.new(x, y, -depth)
	end
	local hue = (index - 1) / 8
	local wallColor = Color3.fromHSV(hue, 0.35, 0.95)

	block({
		Name = "Floor",
		Size = Vector3.new(PLOT_W, 1, PLOT_D),
		CFrame = at(0, 0.5, PLOT_D / 2),
		Color = Color3.fromHSV(hue, 0.12, 0.98),
		Parent = model,
	})
	-- walls: back, sides and the two front pieces around a 20-stud entrance
	local wallH = 12
	for _, w in {
		{ Vector3.new(PLOT_W, wallH, 1.5), at(0, wallH / 2 + 1, PLOT_D) },
		{ Vector3.new(1.5, wallH, PLOT_D), at(-PLOT_W / 2, wallH / 2 + 1, PLOT_D / 2) },
		{ Vector3.new(1.5, wallH, PLOT_D), at(PLOT_W / 2, wallH / 2 + 1, PLOT_D / 2) },
		{ Vector3.new(22, wallH, 1.5), at(-21, wallH / 2 + 1, 0) },
		{ Vector3.new(22, wallH, 1.5), at(21, wallH / 2 + 1, 0) },
	} do
		block({ Name = "Wall", Size = w[1], CFrame = w[2], Color = wallColor, Transparency = 0.1, Parent = model })
	end

	local barrier = block({
		Name = "Barrier",
		Size = Vector3.new(20, wallH, 1),
		CFrame = at(0, wallH / 2 + 1, 0),
		Color = Color3.fromRGB(255, 60, 80),
		Material = Enum.Material.ForceField,
		Transparency = 1,
		CanCollide = false,
		Parent = model,
	})

	local lockButton = block({
		Name = "LockButton",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.8, 6, 6),
		CFrame = at(-20, 1.3, 7) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(255, 70, 90),
		Material = Enum.Material.Neon,
		Parent = model,
	})
	local _, lockLabel = billboard(lockButton, UDim2.fromScale(8, 2.4), Vector3.new(0, 3.5, 0), "🔒 LOCK BASE",
		Color3.fromRGB(255, 255, 255), 60)

	local signPart = block({
		Name = "Sign",
		Size = Vector3.new(26, 5, 1),
		CFrame = at(0, wallH + 4, -0.2) * CFrame.Angles(0, math.rad(180), 0),
		Color = Color3.fromHSV(hue, 0.6, 0.55),
		Parent = model,
	})
	local signLabel = textSurface(signPart, "Empty Base", Color3.fromRGB(255, 255, 255))

	local pads = {}
	local padFolder = New("Folder", { Name = "Pads", Parent = model })
	local maxPads = Economy.maxPossiblePads()
	for i = 1, maxPads do
		local col = PAD_COLUMNS[(i - 1) % #PAD_COLUMNS + 1]
		local row = (i - 1) // #PAD_COLUMNS
		local depth = PAD_ROW_START + row * PAD_ROW_GAP
		local pad = block({
			Name = "Pad" .. i,
			Size = Vector3.new(6.5, 0.6, 6.5),
			CFrame = at(col, 1.3, depth),
			Color = Color3.fromRGB(245, 245, 250),
			Parent = padFolder,
		})
		local glow = block({
			Name = "Glow",
			Size = Vector3.new(7.2, 0.3, 7.2),
			CFrame = at(col, 1.1, depth),
			Color = Color3.fromRGB(80, 80, 90),
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = pad,
		})
		local collect = block({
			Name = "Collect",
			Size = Vector3.new(3.4, 0.4, 3.4),
			CFrame = at(col + 5.6, 1.2, depth),
			Color = Color3.fromRGB(80, 255, 120),
			Material = Enum.Material.Neon,
			Transparency = 1,
			CanCollide = false,
			Parent = pad,
		})
		local storedGui, storedLabel = billboard(collect, UDim2.fromScale(5, 1.6), Vector3.new(0, 2.2, 0), "",
			Color3.fromRGB(120, 255, 140), 45)
		storedGui.Enabled = false
		pads[i] = {
			index = i,
			part = pad,
			glow = glow,
			collect = collect,
			storedGui = storedGui,
			storedLabel = storedLabel,
			top = at(col, 1.6, depth),
		}
	end

	model.PrimaryPart = model:FindFirstChild("Floor") :: BasePart
	model.Parent = world
	WorldBuilder.Plots[index] = {
		index = index,
		model = model,
		cf = cf,
		size = Vector3.new(PLOT_W, 40, PLOT_D),
		center = at(0, 20, PLOT_D / 2),
		barrier = barrier,
		lockButton = lockButton,
		lockLabel = lockLabel,
		signLabel = signLabel,
		pads = pads,
		spawn = CFrame.lookAt(at(0, 4, 8).Position, entrance + Vector3.new(0, 4, 0) - inward * 10),
		outside = at(0, 4, -10),
	}
end

function WorldBuilder.init(_S)
	setupLighting()
	local world = New("Folder", { Name = "World", Parent = workspace })
	buildGround(world)
	buildBelt(world)
	local plotsFolder = New("Folder", { Name = "Plots", Parent = workspace })
	local index = 0
	for _, side in { -1, 1 } do
		for _, z in PLOT_Z do
			index += 1
			buildPlot(plotsFolder, index, Vector3.new(side * ENTRANCE_X, 0, z), Vector3.new(side, 0, 0))
		end
	end
	New("Folder", { Name = "BeltSlimes", Parent = workspace })
	New("Folder", { Name = "BaseSlimes", Parent = workspace })
	print(string.format("[WorldBuilder] built %d plots for %s", #WorldBuilder.Plots, Config.GameName))
end

return WorldBuilder
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX9DF9ADBF245F49BE83A1684F41354535">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX396065BC709E4EE69CAF8BE76D40F8A3">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="RBX44B6A626CA034C76AA18D707AC531B44">
        <Properties>
          <string name="Name">Client</string>
          <ProtectedString name="Source"><![CDATA[-- Client entry point: builds the UI, connects remotes, then asks the server
-- for the full state (retrying until the player's data has loaded).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local New = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("New"))
local Panels = script:WaitForChild("Panels")

local State = require(script:WaitForChild("State"))
local Net = require(script:WaitForChild("Net"))
local UIKit = require(script:WaitForChild("UIKit"))
local Sounds = require(script:WaitForChild("Sounds"))
local Notify = require(script:WaitForChild("Notify"))
local Effects = require(script:WaitForChild("Effects"))
local HUD = require(script:WaitForChild("HUD"))
local World = require(script:WaitForChild("World"))
local ChatTags = require(script:WaitForChild("ChatTags"))
local Tutorial = require(script:WaitForChild("Tutorial"))

local player = Players.LocalPlayer

-- listen first so no pushed state is missed
Net.on("Sync", State.apply)
Net.on("Notify", function(text, kind)
	Notify.show(text, kind)
end)
Net.on("FX", function(name, data)
	Effects.play(name, data)
end)

local gui = New("ScreenGui", {
	Name = "SlimeSnatchersUI",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})

UIKit.init(gui)
Sounds.init()
Notify.init(gui)
Effects.init(gui)
for _, name in { "Shop", "Rewards", "Collection", "Progress", "Misc" } do
	require(Panels:WaitForChild(name)).init()
end
HUD.init(gui, UIKit.toggle)
World.init(UIKit.open)
ChatTags.init()
Tutorial.init(gui)

task.spawn(function()
	for _ = 1, 90 do
		local result = Net.call("ready")
		if result.ok and result.state then
			State.apply(result.state)
			return
		end
		task.wait(1)
	end
	Notify.show("Still loading your data… if this takes long, please rejoin.", "warning")
end)
]]></ProtectedString>
        </Properties>
        <Item class="ModuleScript" referent="RBX99A507CB530E4AC3BD65BE155841DBF6">
          <Properties>
            <string name="Name">ChatTags</string>
            <ProtectedString name="Source"><![CDATA[-- Chat tags ([DEV], [VIP], [Club]) via TextChatService. Visible status is a
-- big reason players buy VIP, so it is shown wherever their name appears.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local ChatTags = {}

function ChatTags.init()
	TextChatService.OnIncomingMessage = function(message: TextChatMessage)
		local props = Instance.new("TextChatMessageProperties")
		local source = message.TextSource
		if not source then
			return props
		end
		local sender = Players:GetPlayerByUserId(source.UserId)
		if not sender then
			return props
		end
		local tags = {}
		if sender:GetAttribute("Admin") then
			table.insert(tags, '<font color="#FF5A5A">[DEV]</font>')
		end
		if sender:GetAttribute("VIP") then
			table.insert(tags, '<font color="#FFD54A">[VIP]</font>')
		end
		if sender:GetAttribute("Club") then
			table.insert(tags, '<font color="#B48CFF">[' .. Config.SubscriptionName .. "]</font>")
		end
		if #tags > 0 then
			props.PrefixText = table.concat(tags, " ") .. " " .. message.PrefixText
		end
		return props
	end
end

return ChatTags
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBXD36AFCA0C7EC4805A2F82C155B2B60E1">
          <Properties>
            <string name="Name">Effects</string>
            <ProtectedString name="Source"><![CDATA[-- Client-side juice: floating cash text, confetti, particle bursts, screen
-- flashes, knockback, idle bobbing and rainbow colour cycling of slimes.
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared:WaitForChild("Format"))
local Rarities = require(Shared:WaitForChild("Rarities"))
local Notify = require(script.Parent:WaitForChild("Notify"))
local Sounds = require(script.Parent:WaitForChild("Sounds"))
local State = require(script.Parent:WaitForChild("State"))
local Theme = require(script.Parent:WaitForChild("Theme"))
local UIKit = require(script.Parent:WaitForChild("UIKit"))

local New = UIKit.New
local C = Theme.Colors
local player = Players.LocalPlayer
local Effects = {}

local overlay: Frame? = nil
local bobbing: { [Model]: number } = {}
local rainbow: { [Model]: boolean } = {}
local lastTip = 0

local function lowGfx(): boolean
	local settings = State.get("settings")
	return settings ~= nil and settings.lowGfx == true
end

local function nearCamera(position: Vector3, range: number): boolean
	local camera = workspace.CurrentCamera
	return camera ~= nil and (camera.CFrame.Position - position).Magnitude <= range
end

local function floatingText(position: Vector3, text: string, color: Color3)
	local anchor = New("Part", {
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Transparency = 1,
		Size = Vector3.new(0.2, 0.2, 0.2),
		CFrame = CFrame.new(position),
		Parent = workspace,
	})
	local gui = New("BillboardGui", {
		Size = UDim2.fromScale(6, 1.6),
		StudsOffsetWorldSpace = Vector3.new(0, 2, 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		Adornee = anchor,
		Parent = anchor,
	})
	local label = UIKit.label({ Text = text, Size = UDim2.fromScale(1, 1), TextColor3 = color, StrokeThickness = 3, Parent = gui })
	UIKit.tween(gui, 1.1, { StudsOffsetWorldSpace = Vector3.new(0, 6, 0) })
	UIKit.tween(label, 1.1, { TextTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	Debris:AddItem(anchor, 1.2)
end

local function burst(position: Vector3, color: Color3, count: number)
	if lowGfx() or not nearCamera(position, 160) then
		return
	end
	local anchor = New("Part", {
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Transparency = 1,
		Size = Vector3.new(0.2, 0.2, 0.2),
		CFrame = CFrame.new(position),
		Parent = workspace,
	})
	local emitter = New("ParticleEmitter", {
		Rate = 0,
		Lifetime = NumberRange.new(0.5, 1),
		Speed = NumberRange.new(8, 18),
		SpreadAngle = Vector2.new(180, 180),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) }),
		Color = ColorSequence.new(color),
		LightEmission = 0.8,
		Acceleration = Vector3.new(0, -25, 0),
		Parent = anchor,
	})
	emitter:Emit(count)
	Debris:AddItem(anchor, 1.5)
end

local function flash(color: Color3, times: number)
	if not overlay then
		return
	end
	task.spawn(function()
		for _ = 1, times do
			overlay.BackgroundColor3 = color
			overlay.BackgroundTransparency = 0.55
			UIKit.tween(overlay, 0.35, { BackgroundTransparency = 1 })
			task.wait(0.4)
		end
	end)
end

local function bigText(text: string, color: Color3)
	if not overlay then
		return
	end
	local label = UIKit.label({
		Text = text,
		Size = UDim2.fromScale(0.7, 0.14),
		Position = UDim2.fromScale(0.5, 0.36),
		AnchorPoint = Vector2.new(0.5, 0.5),
		TextColor3 = color,
		StrokeThickness = 4,
		ZIndex = 40,
		Parent = overlay,
	})
	local scale = New("UIScale", { Scale = 0.3, Parent = label })
	UIKit.tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(1.6, function()
		UIKit.tween(label, 0.4, { TextTransparency = 1 })
		task.wait(0.45)
		label:Destroy()
	end)
end

local function confetti()
	if not overlay or lowGfx() then
		return
	end
	local colors = { C.Pink, C.Gold, C.Green, C.Blue, C.Purple }
	for _ = 1, 45 do
		local piece = New("Frame", {
			BackgroundColor3 = colors[math.random(1, #colors)],
			Size = UDim2.fromOffset(math.random(8, 14), math.random(12, 20)),
			Position = UDim2.fromScale(math.random(), -0.05),
			Rotation = math.random(0, 360),
			ZIndex = 39,
			Parent = overlay,
		})
		local duration = 1.6 + math.random() * 1.2
		UIKit.tween(piece, duration, {
			Position = UDim2.fromScale(math.random(), 1.05),
			Rotation = piece.Rotation + math.random(-360, 360),
		}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		Debris:AddItem(piece, duration + 0.1)
	end
end

local function shake(seconds: number, strength: number)
	local camera = workspace.CurrentCamera
	if not camera or lowGfx() then
		return
	end
	local stop = os.clock() + seconds
	local connection
	connection = RunService.RenderStepped:Connect(function()
		if os.clock() > stop then
			connection:Disconnect()
			return
		end
		local s = strength * (stop - os.clock()) / seconds
		camera.CFrame *= CFrame.new(math.random(-100, 100) / 100 * s, math.random(-100, 100) / 100 * s, 0)
	end)
end

local function tip(text: string)
	if os.clock() - lastTip > 120 then
		lastTip = os.clock()
		Notify.show(text, "info")
	end
end

local HANDLERS = {}

function HANDLERS.cash(data)
	floatingText(data.position, "+" .. Format.cash(data.amount), C.Cash)
	Sounds.play("Cash")
end

function HANDLERS.celebrate(data)
	confetti()
	bigText(tostring(data.text or "WOW!"), C.Gold)
	Sounds.play("Buy")
end

function HANDLERS.event(data)
	bigText(tostring(data.name), C.Purple)
	flash(C.Purple, 1)
	Sounds.play("Alert")
end

function HANDLERS.rareSpawn(data)
	local rarity = Rarities.ByKey[data.rarity]
	flash(if rarity then rarity.color else C.Gold, 1)
	Sounds.play("LevelUp")
end

function HANDLERS.poof(data)
	burst(data.position, Color3.fromRGB(140, 255, 170), 14)
end

function HANDLERS.levelup(data)
	burst(data.position, C.Gold, 18)
	floatingText(data.position + Vector3.new(0, 2, 0), "LEVEL " .. tostring(data.level) .. "!", C.Gold)
	Sounds.play("LevelUp")
end

function HANDLERS.fuse(data)
	burst(data.position, C.Purple, 40)
	confetti()
	Sounds.play("LevelUp")
end

function HANDLERS.bonk(data)
	burst(data.position, C.Pink, 20)
	if nearCamera(data.position, 80) then
		Sounds.play("Bonk")
	end
end

function HANDLERS.knockback(data)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if root and root:IsA("BasePart") and humanoid and typeof(data.direction) == "Vector3" then
		humanoid:ChangeState(Enum.HumanoidStateType.FallingDown)
		root.AssemblyLinearVelocity = data.direction * (tonumber(data.power) or 50)
		shake(0.3, 0.6)
	end
end

function HANDLERS.stolenAlert(_data)
	flash(C.Red, 3)
	shake(0.5, 0.8)
end

function HANDLERS.stolen(_data)
	bigText("😭 STOLEN!", C.Red)
	flash(C.Red, 1)
end

function HANDLERS.sound(data)
	Sounds.play(tostring(data.name))
end

function HANDLERS.noCash(_data)
	tip("💡 Tip: collect cash from the green plates, or grab a Cash pack in the 🛒 Shop!")
end

function HANDLERS.baseFull(_data)
	tip("💡 Tip: fuse 3 identical slimes 🟢 or ⭐ Rebirth for more pads!")
end

function Effects.play(name: string, data)
	local handler = HANDLERS[name]
	if handler then
		local ok, err = pcall(handler, data or {})
		if not ok then
			warn("[Effects] " .. name .. ": " .. tostring(err))
		end
	end
end

local function track(model: Instance)
	if not model:IsA("Model") then
		return
	end
	if model:GetAttribute("BaseCFrame") ~= nil then
		bobbing[model] = math.random() * math.pi * 2
	end
	if model:GetAttribute("Rainbow") then
		rainbow[model] = true
	end
end

function Effects.init(gui: ScreenGui)
	overlay = New("Frame", {
		Name = "FX",
		BackgroundTransparency = 1,
		BackgroundColor3 = C.Red,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 38,
		Parent = gui,
	})
	for _, folderName in { "BaseSlimes", "BeltSlimes" } do
		task.spawn(function()
			local folder = workspace:WaitForChild(folderName)
			for _, child in folder:GetChildren() do
				track(child)
			end
			folder.ChildAdded:Connect(function(child)
				-- attributes are set before parenting, so they're ready here
				track(child)
			end)
			folder.ChildRemoved:Connect(function(child)
				bobbing[child :: Model] = nil
				rainbow[child :: Model] = nil
			end)
		end)
	end
	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local camPos = camera.CFrame.Position
		local low = lowGfx()
		for model, phase in bobbing do
			local body = model.PrimaryPart
			local base = model:GetAttribute("BaseCFrame")
			if body and typeof(base) == "CFrame" and not low and (base.Position - camPos).Magnitude < 130 then
				body.CFrame = base
					* CFrame.new(0, math.abs(math.sin(t * 2.4 + phase)) * 0.35, 0)
					* CFrame.Angles(0, math.sin(t * 1.1 + phase) * 0.2, 0)
			end
		end
		local hue = (t * 0.25) % 1
		for model in rainbow do
			local body = model.PrimaryPart
			if body then
				body.Color = Color3.fromHSV(hue, 0.65, 1)
			end
		end
	end)
end

return Effects
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBXC6557184448943F4BBD7450571AA3F4E">
          <Properties>
            <string name="Name">HUD</string>
            <ProtectedString name="Source"><![CDATA[-- Main HUD: cash counter, menu buttons (left), offers (right), event/boost
-- chips and the carry banner (bottom).
local AdService = game:GetService("AdService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared:WaitForChild("Format"))
local RewardDefs = require(Shared:WaitForChild("RewardDefs"))
local Net = require(script.Parent:WaitForChild("Net"))
local Notify = require(script.Parent:WaitForChild("Notify"))
local State = require(script.Parent:WaitForChild("State"))
local Theme = require(script.Parent:WaitForChild("Theme"))
local UIKit = require(script.Parent:WaitForChild("UIKit"))

local C = Theme.Colors
local New = UIKit.New
local HUD = {}

local adAvailable = false
local badges = {}
local offerButtons = {}

local function serverNow(): number
	return workspace:GetServerTimeNow()
end

local function menuButton(parent: Instance, icon: string, caption: string, color: Color3, order: number, onClick)
	local button = UIKit.button({
		Name = caption,
		Text = "",
		Color = color,
		Size = UDim2.fromOffset(80, 80),
		LayoutOrder = order,
		Radius = 0.3,
		Parent = parent,
		OnClick = onClick,
	})
	UIKit.label({
		Text = icon,
		Size = UDim2.fromScale(0.8, 0.55),
		Position = UDim2.fromScale(0.1, 0.06),
		StrokeThickness = 0,
		Parent = button,
	})
	UIKit.label({
		Text = caption,
		Size = UDim2.fromScale(0.94, 0.3),
		Position = UDim2.fromScale(0.03, 0.64),
		MaxTextSize = 18,
		Parent = button,
	})
	local badge = New("Frame", {
		Name = "Badge",
		BackgroundColor3 = C.Red,
		Size = UDim2.fromOffset(22, 22),
		Position = UDim2.new(1, -8, 0, -6),
		Visible = false,
		ZIndex = 5,
		Parent = button,
	}, { UIKit.corner(0.5), UIKit.stroke(2) })
	UIKit.label({ Text = "!", Size = UDim2.fromScale(1, 1), ZIndex = 6, Parent = badge })
	badges[caption] = badge
	return button
end

local function pulse(button: GuiObject)
	local scale = New("UIScale", { Name = "Pulse", Parent = button })
	task.spawn(function()
		while button.Parent do
			UIKit.tween(scale, 0.6, { Scale = 1.08 }, Enum.EasingStyle.Sine)
			task.wait(0.6)
			UIKit.tween(scale, 0.6, { Scale = 1 }, Enum.EasingStyle.Sine)
			task.wait(0.6)
		end
	end)
end

local function offerButton(parent: Instance, key: string, icon: string, caption: string, color: Color3, order: number, onClick)
	local button = UIKit.button({
		Name = key,
		Text = "",
		Color = color,
		Size = UDim2.fromOffset(84, 84),
		LayoutOrder = order,
		Radius = 0.5,
		Parent = parent,
		OnClick = onClick,
	})
	button.Visible = false
	UIKit.label({ Text = icon, Size = UDim2.fromScale(0.7, 0.5), Position = UDim2.fromScale(0.15, 0.1), StrokeThickness = 0,
		Parent = button })
	UIKit.label({ Text = caption, Size = UDim2.fromScale(0.9, 0.28), Position = UDim2.fromScale(0.05, 0.6), MaxTextSize = 18,
		Parent = button })
	pulse(button)
	offerButtons[key] = button
	return button
end

local function checkAds()
	local ok, result = pcall(function()
		return AdService:GetAdAvailabilityNowAsync(Enum.AdFormat.RewardedVideo)
	end)
	if ok and type(result) == "table" then
		adAvailable = false
		for _, value in result do
			if value == Enum.AdAvailabilityResult.IsAvailable then
				adAvailable = true
			end
		end
	else
		adAvailable = true -- unknown on this client; the server reports if no ad is available
	end
end

local function refreshOffers()
	local function show(key: string, visible: boolean)
		if offerButtons[key] then
			offerButtons[key].Visible = visible
		end
	end
	show("VIP", State.passInfo("VIP") ~= nil and not State.has("VIP"))
	show("DoubleCash", State.passInfo("DoubleCash") ~= nil and not State.has("DoubleCash"))
	show("StarterPack", State.productInfo("StarterPack") ~= nil and State.get("starterPackBought") == false)
	show("FreeAd", State.get("adsEnabled") == true and adAvailable and serverNow() >= (State.get("adReadyAt") or 0))
	show("Club", State.get("clubConfigured") == true and State.get("isClub") == false)
end

local function refreshBadges()
	local daily = State.get("daily")
	local ready = daily ~= nil and daily.canClaim == true
	for _, quest in State.get("quests") or {} do
		if quest.done and not quest.claimed then
			ready = true
		end
	end
	local gifts = State.get("gifts")
	if gifts then
		local elapsed = serverNow() - gifts.startedAt
		local claimed = {}
		for _, i in gifts.claimed do
			claimed[i] = true
		end
		for i, gift in RewardDefs.Gifts do
			if not claimed[i] and elapsed >= gift.at * 60 then
				ready = true
			end
		end
	end
	badges.Rewards.Visible = ready
	local slimes = State.get("slimes") or {}
	local counts = {}
	local fusable = false
	for _, slime in slimes do
		counts[slime.id] = (counts[slime.id] or 0) + 1
		if counts[slime.id] >= 3 then
			fusable = true
		end
	end
	badges.Slimes.Visible = fusable
end

local function chip(parent: Instance, name: string, color: Color3, order: number)
	local frame = New("Frame", {
		Name = name,
		BackgroundColor3 = color,
		Size = UDim2.fromOffset(150, 34),
		LayoutOrder = order,
		Visible = false,
		Parent = parent,
	}, { UIKit.corner(0.5), UIKit.stroke(2) })
	local label = UIKit.label({ Text = "", Size = UDim2.new(1, -12, 0.8, 0), Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5), MaxTextSize = 20, Parent = frame })
	return frame, label
end

function HUD.init(gui: ScreenGui, open: (string) -> ())
	-- cash ---------------------------------------------------------------
	local top = New("Frame", {
		Name = "Top",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 6),
		Size = UDim2.fromOffset(360, 96),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	UIKit.scaled(top)
	local pill = New("Frame", {
		Name = "Cash",
		BackgroundColor3 = C.Panel,
		Size = UDim2.fromOffset(360, 62),
		Parent = top,
	}, { UIKit.corner(0.5), UIKit.stroke(4), UIKit.gradient(Color3.new(1, 1, 1), Color3.fromRGB(190, 180, 220)) })
	UIKit.label({ Text = "💰", Size = UDim2.fromOffset(52, 46), Position = UDim2.fromOffset(12, 8), StrokeThickness = 0,
		Parent = pill })
	local cashLabel = UIKit.label({
		Text = "$0",
		Size = UDim2.new(1, -86, 0.8, 0),
		Position = UDim2.fromOffset(70, 6),
		TextColor3 = C.Cash,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 42,
		StrokeThickness = 3,
		Parent = pill,
	})
	local incomeLabel = UIKit.label({
		Text = "",
		Size = UDim2.fromOffset(360, 28),
		Position = UDim2.fromOffset(0, 66),
		TextColor3 = C.SubText,
		MaxTextSize = 22,
		Parent = top,
	})
	local shown = 0
	RunService.RenderStepped:Connect(function(dt)
		local target = State.get("cash") or 0
		if target < shown or math.abs(target - shown) < 1 then
			shown = target
		else
			shown += (target - shown) * math.min(1, dt * 7)
		end
		cashLabel.Text = Format.cash(shown)
	end)
	local function refreshIncome()
		incomeLabel.Text = "+" .. Format.rate(State.get("income") or 0) .. "   ·   " .. Format.mult(State.get("mult") or 1)
	end
	State.on("income", refreshIncome)
	State.on("mult", refreshIncome)

	-- menu -----------------------------------------------------------------
	local menu = New("Frame", {
		Name = "Menu",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 10),
		Size = UDim2.fromOffset(176, 360),
		BackgroundTransparency = 1,
		Parent = gui,
	}, { UIKit.grid(Vector2.new(80, 80), 8) })
	UIKit.scaled(menu)
	local entries = {
		{ "🛒", "Shop", C.Gold },
		{ "🎁", "Rewards", C.Pink },
		{ "🟢", "Slimes", C.Green },
		{ "📖", "Index", C.Blue },
		{ "⭐", "Rebirth", C.Purple },
		{ "🎲", "Odds", C.Card },
		{ "🔑", "Codes", C.Card },
		{ "⚙️", "Settings", C.Card },
	}
	for i, entry in entries do
		menuButton(menu, entry[1], entry[2], entry[3], i, function()
			open(entry[2])
		end)
	end

	-- offers -----------------------------------------------------------------
	local offers = New("Frame", {
		Name = "Offers",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 10),
		Size = UDim2.fromOffset(90, 470),
		BackgroundTransparency = 1,
		Parent = gui,
	}, { UIKit.list(Enum.FillDirection.Vertical, 10) })
	UIKit.scaled(offers)
	offerButton(offers, "VIP", "👑", "VIP", C.Gold, 1, function()
		Net.call("buyPass", "VIP")
	end)
	offerButton(offers, "DoubleCash", "💰", "2x Cash", C.Green, 2, function()
		Net.call("buyPass", "DoubleCash")
	end)
	offerButton(offers, "StarterPack", "🎁", "Starter", C.Pink, 3, function()
		open("Starter")
	end)
	offerButton(offers, "FreeAd", "📺", "FREE 2x", C.Blue, 4, function()
		local result = Net.call("watchAd", "boost")
		if not result.ok and result.msg then
			Notify.show(result.msg, "warning")
		end
		task.delay(2, checkAds)
	end)
	offerButton(offers, "Club", "💎", "Club", C.Purple, 5, function()
		Net.call("subscribe")
	end)
	for _, key in { "passes", "owned", "gifted", "starterPackBought", "adsEnabled", "adReadyAt", "isClub", "products" } do
		State.on(key, refreshOffers)
	end

	-- bottom -------------------------------------------------------------------
	local bottom = New("Frame", {
		Name = "Bottom",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -8),
		Size = UDim2.fromOffset(660, 150),
		BackgroundTransparency = 1,
		Parent = gui,
	}, { UIKit.list(Enum.FillDirection.Vertical, 6, nil, Enum.VerticalAlignment.Bottom) })
	UIKit.scaled(bottom)
	local carry = New("Frame", {
		Name = "Carry",
		BackgroundColor3 = C.Red,
		Size = UDim2.fromOffset(520, 40),
		LayoutOrder = 1,
		Visible = false,
		Parent = bottom,
	}, { UIKit.corner(0.5), UIKit.stroke(3) })
	local carryLabel = UIKit.label({ Text = "", Size = UDim2.new(1, -20, 0.8, 0), Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5), MaxTextSize = 24, Parent = carry })
	State.on("carrying", function(info)
		carry.Visible = type(info) == "table"
		if type(info) == "table" then
			carryLabel.Text = "🏃 Carrying " .. info.name .. " — run to YOUR base!"
		end
	end)

	local banner = New("Frame", {
		Name = "Event",
		BackgroundColor3 = C.Purple,
		Size = UDim2.fromOffset(460, 40),
		LayoutOrder = 2,
		Visible = false,
		Parent = bottom,
	}, { UIKit.corner(0.5), UIKit.stroke(3) })
	local bannerLabel = UIKit.label({ Text = "", Size = UDim2.new(1, -20, 0.8, 0), Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5), MaxTextSize = 24, Parent = banner })

	local chips = New("Frame", {
		Name = "Chips",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(660, 34),
		LayoutOrder = 3,
		Parent = bottom,
	}, { UIKit.list(Enum.FillDirection.Horizontal, 6) })
	local lockChip, lockLabel = chip(chips, "Lock", C.Red, 1)
	local shieldChip, shieldLabel = chip(chips, "Shield", C.Blue, 2)
	local potionChip, potionLabel = chip(chips, "Potion", C.Green, 3)
	local luckChip, luckLabel = chip(chips, "Luck", Color3.fromRGB(60, 170, 90), 4)
	local rainChip, rainLabel = chip(chips, "Rain", Color3.fromRGB(70, 120, 220), 5)
	local goldenChip, goldenLabel = chip(chips, "Golden", Color3.fromRGB(200, 150, 30), 6)

	local serverState = ReplicatedStorage:WaitForChild("ServerState")
	task.spawn(function()
		local lastAdCheck = 0
		while true do
			local t = serverNow()
			local eventEnds = serverState:GetAttribute("EventEnds") or 0
			local eventName = serverState:GetAttribute("EventName") or ""
			banner.Visible = eventName ~= "" and eventEnds > t
			if banner.Visible then
				bannerLabel.Text = eventName .. "  " .. Format.time(eventEnds - t)
			end
			local function timed(frame: Frame, label: TextLabel, ends: number, text: string)
				frame.Visible = ends > t
				if frame.Visible then
					label.Text = text .. " " .. Format.time(ends - t)
				end
			end
			timed(lockChip, lockLabel, State.get("lockedUntil") or 0, "🔒")
			timed(luckChip, luckLabel, serverState:GetAttribute("LuckEnds") or 0,
				"🍀 x" .. tostring(serverState:GetAttribute("LuckMult") or 2))
			timed(rainChip, rainLabel, serverState:GetAttribute("RainEnds") or 0, "🌧️")
			timed(goldenChip, goldenLabel, serverState:GetAttribute("GoldenEnds") or 0, "✨")
			local boosts = State.get("boosts") or {}
			timed(shieldChip, shieldLabel, t + (boosts.shield or 0), "🛡️")
			timed(potionChip, potionLabel, t + (boosts.cash2x or 0), "🧪 2x")
			if os.clock() - lastAdCheck > 60 then
				lastAdCheck = os.clock()
				task.spawn(checkAds)
			end
			refreshOffers()
			refreshBadges()
			task.wait(0.25)
		end
	end)

	-- admin --------------------------------------------------------------------
	local adminButton = UIKit.button({
		Name = "Admin",
		Text = "🛠️ Admin",
		Color = C.Red,
		Size = UDim2.fromOffset(120, 40),
		Position = UDim2.new(0, 10, 0, 50),
		MaxTextSize = 20,
		Parent = gui,
		OnClick = function()
			open("Admin")
		end,
	})
	adminButton.Visible = false
	UIKit.scaled(adminButton)
	State.on("isAdmin", function(isAdmin)
		adminButton.Visible = isAdmin == true
	end)
	State.on("memoryMode", function(memory)
		if memory then
			Notify.show("⚠️ Studio test mode: data is NOT saved (enable API Services to test saving).", "warning")
		end
	end)
end

return HUD
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX0CDD81DA886C4394A12BD0F176833C2B">
          <Properties>
            <string name="Name">Net</string>
            <ProtectedString name="Source"><![CDATA[-- Client -> server requests through the single Action remote.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))

local Net = {}

local action = Remotes.get("Action")

function Net.call(name: string, payload: any?)
	local ok, result = pcall(function()
		return action:InvokeServer(name, payload)
	end)
	if not ok or type(result) ~= "table" then
		return { ok = false, msg = "Connection problem, try again!" }
	end
	return result
end

function Net.on(remoteName: string, fn: (...any) -> ())
	Remotes.get(remoteName).OnClientEvent:Connect(fn)
end

return Net
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX91E40804FE8242D99DE5A1E5529C40B3">
          <Properties>
            <string name="Name">Notify</string>
            <ProtectedString name="Source"><![CDATA[-- Toast notifications (top centre), colour-coded by kind.
local Sounds = require(script.Parent:WaitForChild("Sounds"))
local Theme = require(script.Parent:WaitForChild("Theme"))
local UIKit = require(script.Parent:WaitForChild("UIKit"))

local C = Theme.Colors
local New = UIKit.New
local Notify = {}

local container: Frame? = nil
local count = 0
local MAX_VISIBLE = 4

local KINDS = {
	info = { color = C.Blue, seconds = 3.5 },
	success = { color = C.Green, seconds = 3.5 },
	error = { color = C.Red, seconds = 3 },
	warning = { color = C.Gold, seconds = 3.5 },
	event = { color = C.Purple, seconds = 5 },
	purchase = { color = C.Pink, seconds = 5 },
	rare = { color = C.Gold, seconds = 4.5 },
	alert = { color = C.Red, seconds = 5, sound = "Alert" },
}

function Notify.init(gui: ScreenGui)
	container = New("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 0),
		-- below the cash pill at every UI scale (offsets are not scaled by UIScale)
		Position = UDim2.new(0.5, 0, 0.17, 0),
		Size = UDim2.fromOffset(560, 300),
		BackgroundTransparency = 1,
		ZIndex = 30,
		Parent = gui,
	}, { UIKit.list(Enum.FillDirection.Vertical, 6) })
	UIKit.scaled(container)
end

function Notify.show(text: string, kind: string?)
	if not container or type(text) ~= "string" then
		return
	end
	local style = KINDS[kind or "info"] or KINDS.info
	count += 1
	local children = container:GetChildren()
	local toasts = {}
	for _, child in children do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	if #toasts >= MAX_VISIBLE then
		table.sort(toasts, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		toasts[1]:Destroy()
	end
	local toast = New("Frame", {
		Name = "Toast",
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.05,
		Size = UDim2.fromOffset(540, 46),
		LayoutOrder = count,
		Parent = container,
	}, {
		UIKit.corner(0.3),
		UIKit.stroke(3, style.color),
	})
	local label = UIKit.label({
		Text = text,
		Size = UDim2.new(1, -24, 0.8, 0),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		MaxTextSize = 22,
		Parent = toast,
	})
	local scale = New("UIScale", { Scale = 0.6, Parent = toast })
	UIKit.tween(scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	if style.sound then
		Sounds.play(style.sound)
	end
	task.delay(style.seconds, function()
		if toast.Parent then
			UIKit.tween(toast, 0.3, { BackgroundTransparency = 1 })
			UIKit.tween(label, 0.3, { TextTransparency = 1 })
			task.wait(0.3)
			toast:Destroy()
		end
	end)
end

return Notify
]]></ProtectedString>
          </Properties>
