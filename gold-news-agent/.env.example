# Salin ke .env lalu isi. File .env TIDAK BOLEH di-commit (sudah ada di .gitignore).
# .env hanya untuk rahasia; semua perilaku (bobot, threshold, jam tenang, dll) ada di config/settings.yaml.

# --- Wajib ---
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
# Chat ID tujuan notifikasi (angka; grup diawali -100...)
TELEGRAM_CHAT_ID=
# Daftar user ID Telegram yang boleh memberi perintah bot (/stop, /mute, ...), pisahkan koma
TELEGRAM_ADMIN_USER_IDS=

# --- Sangat disarankan (baca channel squawk via Telethon) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Disarankan ---
FRED_API_KEY=

# --- Opsional ---
TWELVEDATA_API_KEY=
FINNHUB_API_KEY=
X_BEARER_TOKEN=

# --- MT5 (opsional, hanya Windows) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# --- Infrastruktur (Fase 1+) ---
DATABASE_URL=postgresql+psycopg://gold:gold@localhost:5432/gold
REDIS_URL=redis://localhost:6379/0
# Password login dashboard bila dibuka ke internet
DASHBOARD_PASSWORD=
