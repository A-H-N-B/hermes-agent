# Salin ke .env lalu isi. File .env TIDAK BOLEH di-commit (sudah ada di .gitignore).
# .env hanya untuk rahasia; semua perilaku (bobot, threshold, jam tenang, dll) ada di config/settings.yaml.

# --- Wajib ---
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
# Chat ID tujuan notifikasi (angka; grup diawali -100...)
TELEGRAM_CHAT_ID=
# Daftar user ID Telegram yang boleh memberi perintah bot (/stop, /mute, ...), pisahkan koma
TELEGRAM_ADMIN_USER_IDS=

# --- Sangat disarankan (baca channel squawk via Telethon) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Disarankan ---
FRED_API_KEY=

# --- Opsional ---
TWELVEDATA_API_KEY=
FINNHUB_API_KEY=
X_BEARER_TOKEN=

# MT5: tidak ada isian. Login di terminal MT5 seperti biasa; agent hanya membaca akun yang
# sedang terbuka dan tidak pernah login sendiri.

# --- Infrastruktur (Fase 1+) ---
# Kosong = SQLite di data/gold.db, cukup untuk satu komputer dengan `gold-agent run all`.
# PostgreSQL native: postgresql+asyncpg://gold:<password>@localhost:5432/gold
# (Docker Compose mengisi DATABASE_URL dan REDIS_URL sendiri dari dua password di bawah.)
DATABASE_URL=
# Hanya dipakai dengan `--bus redis`, mis. redis://:<password>@localhost:6379/0
REDIS_URL=
# Docker Compose: password PostgreSQL dan Redis, buat acak (mis. `openssl rand -hex 24`)
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Password login dashboard: wajib di Docker (container mendengarkan di 0.0.0.0) dan bila dashboard
# dibuka ke jaringan
DASHBOARD_PASSWORD=
